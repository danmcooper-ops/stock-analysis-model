han grown."],"own":["Insiders own 42.7%, meaningful skin in the game, and institutions hold 44%.","It returns 21.9% a year to shareholders."],"people":["With about 49 employees, each generates about $1.9M of revenue, 5.1x the Healthcare median, and revenue has fallen 20.6% a year across its filed history.","That works out to $880K of free cash flow per employee.","CEO pay is $1.4M (1x revenue per employee).","Stock compensation averages $75K per employee."]},"profile":{"v":"INVEST","conv":75,"head":"Invest: trades 84% below fair value of $17.11; ROIC 101.7% vs WACC 9.8%.","pros":["Composite 50, above the 39 line (gates 13/25)","Trades 84% below fair value of $17.11","ROIC 101.7% vs WACC 9.8%","FCF margin 45.6%","Net cash of $154.7M"],"cons":["Revenue shrank 5.4%/yr over 5y","P/E 274.0x vs sector 26.2x","12-1 month momentum -43%","Operating margin contracting 7.1%/yr"],"flags":[],"need":[],"buy_below":14.54,"vc":{"base":17.11,"base_src":"dcf","bear":12.63,"bull":24.03,"alt_median":8.33,"n_alt":2,"gap":1.0533,"dispersion":0.217,"level":"LOW","why":["DCF is 105% above the other models' median ($8.33)"]},"med":{"pe":26.2222,"ev_ebitda":15.54,"pfcf":23.7593,"pb":3.4965,"roic":-0.1287,"gross_margin":0.5566,"fcf_margin":0.0222,"div_yield":0.0136}},"mc_quantiles":[10.04,11.69,12.63,13.34,14.05,14.65,15.15,15.7,16.28,16.69,17.09,17.74,18.37,19.07,19.67,20.44,21.38,22.48,24.03,26.47,31.43],"mc_drivers":{"growth":0.676,"discount_rate":0.293,"terminal_growth":0.02,"exit_multiple":0.011},"ticker":"SIGA","date":"2026-11-13"}