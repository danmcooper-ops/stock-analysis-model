":false,"_score_p_tbv":0.0,"_gate_mult_vs_hist":0.07340357783973195,"_gp_mult_vs_hist":false,"_score_mult_vs_hist":61.8,"_gate_fcf_yield":0.09187089607357166,"_gp_fcf_yield":true,"_score_fcf_yield":64.0,"_gate_int_coverage":8.44458525573751,"_gp_int_coverage":true,"_score_int_coverage":39.2,"_gate_net_debt_ebitda":1.2412697354532627,"_gp_net_debt_ebitda":true,"_score_net_debt_ebitda":61.3,"_gate_accruals":-0.06345701721869126,"_gp_accruals":true,"_score_accruals":72.9,"_gate_rev_volatility":3.3040206593568224,"_gp_rev_volatility":false,"_score_rev_volatility":0.0,"_gate_margin_vs_hist":-0.45430571065460756,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":0.0450106980027246,"_gp_spread":false,"_score_spread":22.5,"_gate_roic_consistency":0.22737856560713127,"_gp_roic_consistency":true,"_score_roic_consistency":62.1,"_gate_incr_roic":0.1526324893649469,"_gp_incr_roic":true,"_score_incr_roic":67.5,"_gate_margin_advantage":0.024999410738598682,"_gp_margin_advantage":false,"_score_margin_advantage":41.7,"_gate_pool_share":0.06055665317878689,"_gp_pool_share":true,"_score_pool_share":64.2,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":0.10147568139430252,"_gp_fcf_durability":true,"_score_fcf_durability":75.7,"_gate_margins":0.02138176369659177,"_gp_margins":true,"_score_margins":71.4,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.08033697415109894,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":100.0,"_gate_share_shrink":-0.034201650801756855,"_gp_share_shrink":true,"_score_share_shrink":92.8,"_gate_sbc_dilution":0.01002138948481837,"_gp_sbc_dilution":true,"_score_sbc_dilution":83.3,"_gate_insider_own":0.01323,"_gp_insider_own":false,"_score_insider_own":8.8,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"EnerSys engages in the provision of stored energy solutions for industrial applications worldwide. It operates through three segments: Network & Infrastructure Solutions, Industrial Mobility Solutions, and Precision Power Solutions. The Network & Infrastructure Solutions segment provides power solutions and services to broadband, telecommunications, data center, and industrial utility customers. The Industrial Mobility Solutions segment provides power for electric industrial forklifts and other material handling equipment as well as transportation applications, primarily Class 8 trucks. The Precision Power Solutions segment provides energy solutions primarily for military vehicles, advanced defense programs, soldier powering and autonomous systems. It sells its products through a network of distributors, independent representatives, and internal sales forces. The company was formerly known as Yuasa, Inc. and changed its name to EnerSys in January 2001. EnerSys was founded in 1991 and is headquartered in Reading, Pennsylvania.","ceo_bio":"Mr. Shawn M. O'Connell | President, COO, CEO & Director | Age 51 | Compensation: $2.6M (FY2026)","culture_narrative":"Employs approximately 9K people. Revenue per employee of $387K ranks in the above the sector median among Industrials peers. Each employee generates $48K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 7\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["EnerSys is a mid-cap industrials business with a $5.1B market cap on $3.8B of annual revenue.","The top line has compounded at +0% over the past three years, which puts it in mature, slow-growth territory.","Returns on capital run at 14% against a 9% cost of capital, a 5-point spread that creates value, though narrow enough that competitive pressure could close it, with gross margins sitting at 30%.","The business throws off $468M in free cash flow \u2014 roughly 12 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.87\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.2\u00d7 net debt/EBITDA, and interest coverage runs at 8.4\u00d7.","Management returns a meaningful 8.0% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Above-average short interest at 8.3% of float","sev":"amber","cat":"sentiment"},{"text":"Industrials sector lagging the market significantly, underperforming by 6% over 3 months","sev":"amber","cat":"sector"},{"text":"Cyclicality and capital intensity \u2014 order books turn on a dime, and the heavy fixed cost base that creates the moat also magnifies the downturn.","sev":"amber","cat":"thesis_risk"},{"text":"Supply chain reshoring costs and labour shortages \u2014 onshoring mandates raise capex requirements while a shrinking skilled-labour pool inflates operating costs.","sev":"amber","cat":"thesis_risk"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Trading at a 41% margin of safety to estimated fair value \u2014 a real cushion against errors in the estimate","Market is pricing in lower growth than the company has historically delivered","Trading near the bottom of its 52-week range \u2014 the market is offering a discount","Valued at a 31% discount to sector median EV/EBITDA","Altman Z comfortably in the safe zone \u2014 a fortress balance sheet on this measure","12 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment"],"news_headlines":[{"title":"Enersys (NYSE:ENS) Stock Price Target Lowered at Oppenheimer","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/enersys-nyseens-stock-price-target-lowered-at-oppenheimer.html","date":"2026-11-13","timestamp":1794585304.0,"origin":"tiingo","sentiment":0.318,"tier":0,"scope":"company","tags":["analyst_action"]},{"title":"Can EnerSys (ENS) Be Called A Bargain After The $320 Million Deal?","source":"simplywall.st","link":"https://simplywall.st/stocks/us/capital-goods/nyse-ens/enersys/news/can-enersys-ens-be-called-a-bargain-after-the-320-million-de","date":"2026-11-13","timestamp":1794575949.374,"origin":"tiingo","sentiment":0.649,"tier":0,"scope":"company","tags":[]},{"title":"Enersys (NYSE:ENS) Issues Quarterly Earnings Results","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/enersys-nyseens-issues-quarterly-earnings-results.html","date":"2026-11-13","timestamp":1794575722.0,"origin":"tiingo","sentiment":0.511,"tier":0,"scope":"company","tags":["earnings","legal"]},{"title":"EnerSys (ENS) Q2 2027 Earnings Call Transcript","source":"aol.com","link":"https://www.aol.com/articles/enersys-ens-q2-2027-earnings-064533000.html","date":"2026-11-13","timestamp":1794552802.0,"origin":"tiingo","sentiment":0.0,"tier":0,"scope":"company","tags":["earnings"]},{"title":"EnerSys (ENS) Q2 2027 Earnings Call Highlights: Margin Expansion, Record Backlog and the ...","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/enersys-ens-q2-2027-earnings-230526926.html","date":"2026-11-12","timestamp":1794524726.0,"origin":"tiingo","sentiment":0.718,"tier":0,"scope":"company","tags":["earnings"]},{"title":"Wha