984015797272863,"_gp_net_debt_ebitda":false,"_score_net_debt_ebitda":22.6,"_gate_accruals":-0.0633011037767679,"_gp_accruals":true,"_score_accruals":72.5,"_gate_rev_volatility":0.19975915261875596,"_gp_rev_volatility":false,"_score_rev_volatility":57.2,"_gate_margin_vs_hist":0.034109981862528255,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":57.4,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.0029221660756706125,"_gp_spread":false,"_score_spread":1.5,"_gate_roic_consistency":0.5087780528423392,"_gp_roic_consistency":false,"_score_roic_consistency":15.2,"_gate_incr_roic":0.09608786525879094,"_gp_incr_roic":false,"_score_incr_roic":48.7,"_gate_margin_advantage":0.09121020166705034,"_gp_margin_advantage":true,"_score_margin_advantage":63.7,"_gate_pool_share":0.18330681991968523,"_gp_pool_share":true,"_score_pool_share":100.0,"_gate_rev_durability":0.17263923352363442,"_gp_rev_durability":true,"_score_rev_durability":100.0,"_gate_fcf_durability":0.0875968185408027,"_gp_fcf_durability":true,"_score_fcf_durability":68.8,"_gate_margins":0.005471566890791357,"_gp_margins":true,"_score_margins":55.5,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.018674960243990707,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":31.9,"_gate_share_shrink":-0.007779117998794494,"_gp_share_shrink":true,"_score_share_shrink":59.7,"_gate_sbc_dilution":0.008392174219373471,"_gp_sbc_dilution":true,"_score_sbc_dilution":86.0,"_gate_insider_own":0.00254,"_gp_insider_own":false,"_score_insider_own":1.7,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Waste Connections, Inc. provides non-hazardous waste collection, transfer, and disposal services in the United States and Canada. It offers collection services to residential, commercial, municipal, industrial, and exploration and production (E&P) customers; landfill disposal services; and recycling services for various recyclable materials, including compost, cardboard, mixed paper, plastic containers, glass bottles, and ferrous and aluminum metals. The company owns and operates transfer stations that receive, compact, and/or load waste to be transported to landfills or treatment facilities through truck, rail, or barge; develops, owns, and operates projects or the beneficial reuse of landfill gas through landfill network; and intermodal services for the movement of cargo and solid waste containers. In addition, it provides E&P waste treatment, recovery, and disposal services for waste created through the initial drilling and completion of an oil or natural gas well, such as drilling fluids, drill cuttings, completion fluids, and flowback water; production wastes and produced water during a well's operating life; contaminated soils that require treatment during site reclamation; and substances, which require clean-up after a spill, reserve pit clean-up, or pipeline rupture. Waste Connections, Inc. was founded in 1997 and is based in The Woodlands, Texas.","ceo_bio":"Mr. Ronald J. Mittelstaedt | Founder, CEO, President & Director | Age 62 | Compensation: $4.5M (FY2025)","culture_narrative":"Employs approximately 24K people. Revenue per employee of $391K ranks in the above the sector median among Industrials peers, with revenue growing 12%/yr across its filed history. Each employee generates $51K of free cash flow annually. Stock-based compensation of $3K per employee reflects an ownership culture. CEO compensation is 11\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["Waste Connections, Inc. is a large-cap industrials business with a $44.9B market cap on $9.5B of annual revenue.","The top line has compounded at +9% over the past three years and +17% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 7% against a 7% cost of capital, which means the business barely earns its keep economically.","The business throws off $1.2B in free cash flow \u2014 roughly 13 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.24\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is moderate at 3.0\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 5.1\u00d7.","Shareholder yield is only 1.9%, a thin return of capital, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 1.6\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Carries a 33% premium to sector median EV/EBITDA (confirmed by 1 other valuation measure)","sev":"amber","cat":"valuation","magnitude":0.32828834451552513},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Insiders are net sellers (100% sell ratio, net $6.7M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Significant goodwill (40% of assets) from past acquisitions \u2014 a soft asset a conservative appraisal discounts to zero","sev":"amber","cat":"balance_sheet"},{"text":"Industrials ETF trading well below its long-term trend","sev":"amber","cat":"sector"},{"text":"Cyclical sectors like Industrials tend to underperform in slowdowns","sev":"amber","cat":"sector"},{"text":"High market volatility with VIX at 36, signaling elevated fear","sev":"amber","cat":"macro"},{"text":"Widening credit spreads suggest growing stress in corporate debt markets","sev":"amber","cat":"macro"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Operating margins 9% above sector median \u2014 the quantitative trace of pricing power","Founder-led \u2014 owner alignment that often matters more than any incentive plan","15 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment"],"news_headlines":[{"title":"Why Is Waste Connections (WCN) Down 2.4% Since Last Earnings Report?","source":"zacks.com","link":"https://www.zacks.com/stock/news/3033299/why-is-waste-connections-wcn-down-2-4-since-last-earnings-report?cid=CS-ZC-FT-realtime_blog-3033299","date":"2026-11-20","timestamp":1795188612.0,"origin":"tiingo","sentiment":-0.421,"tier":0,"scope":"company","tags":["earnings"]},{"title":"(WCN) Movement Within Algorithmic Entry Frameworks","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/90/WCN_Movement_Within_Algorithmic_Entry_Frameworks_111926023802_1795117082.html","date":"2026-11-19","timestamp":1795117082.0,"origin":"tiingo","sentiment":-0.421,"tier":0,"scope":"company","tags":[]},{"title":"Waste Connections, Inc. (WCN): Why This Waste Management Stock Remains on Investors\u2019 Radar","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/waste-connections-inc-wcn-why-144647116.html","date":"2026-11-19","timestamp":1795099607.0,"origin":"tiingo","sentiment":-0.296,"tier":0,"scope":"company","tags":[]},{"title":"White Cliff Minerals Director Sara Kelly Receives 150,000 Performance Rights on 20 November 2026","source":"kalkinemedia.com","link":"https://kalkinemedia.com/au/news/announcements/white-cliff-minerals-director-sara-kelly-receives-150000-performance-rights-on-20-