t_debt_ebitda":true,"_score_net_debt_ebitda":74.8,"_gate_accruals":-0.058555538363677,"_gp_accruals":true,"_score_accruals":51.7,"_gate_rev_volatility":0.21760399107272793,"_gp_rev_volatility":false,"_score_rev_volatility":52.1,"_gate_margin_vs_hist":0.16258935197158356,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":0.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.11246029925427382,"_gp_spread":true,"_score_spread":56.2,"_gate_roic_consistency":1.2714461267117536,"_gp_roic_consistency":false,"_score_roic_consistency":0.0,"_gate_incr_roic":0.027704527460051913,"_gp_incr_roic":false,"_score_incr_roic":25.9,"_gate_margin_advantage":0.15841759802311964,"_gp_margin_advantage":true,"_score_margin_advantage":86.1,"_gate_pool_share":0.10711054954351495,"_gp_pool_share":true,"_score_pool_share":82.8,"_gate_rev_durability":0.05021514486802525,"_gp_rev_durability":true,"_score_rev_durability":50.1,"_gate_fcf_durability":0.011113840658202756,"_gp_fcf_durability":false,"_score_fcf_durability":30.6,"_gate_margins":0.011999124703327818,"_gp_margins":true,"_score_margins":62.0,"_gate_fund_growth":0.11216189341686882,"_gp_fund_growth":true,"_score_fund_growth":100.0,"_gate_shrhldr_yield":0.01143453875147904,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":23.8,"_gate_share_shrink":-0.0022121051793470015,"_gp_share_shrink":true,"_score_share_shrink":52.8,"_gate_sbc_dilution":0.004669110553733359,"_gp_sbc_dilution":true,"_score_sbc_dilution":92.2,"_gate_insider_own":0.00703,"_gp_insider_own":false,"_score_insider_own":4.7,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Freeport-McMoRan Inc. engages in the mining of mineral properties in North America, South America, and Indonesia. The company primarily explores for copper, gold, molybdenum, silver, and other metals. Its assets include the Grasberg minerals district in Indonesia; Morenci, Bagdad, Safford, Sierrita, and Miami in Arizona; Chino and Tyrone in New Mexico; and Henderson and Climax in Colorado, North America, as well as Cerro Verde in Peru and El Abra in Chile. The company was formerly known as Freeport-McMoRan Copper & Gold Inc. and changed its name to Freeport-McMoRan Inc. in July 2014. The company was incorporated in 1987 and is headquartered in Phoenix, Arizona.","ceo_bio":"Ms. Kathleen Lynne Quirk | CEO, President & Director | Age 61 | Compensation: $3.0M (FY2025)","culture_narrative":"Employs approximately 29K people. Revenue per employee of $894K ranks in the above the sector median among Basic Materials peers. Each employee generates $38K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 3\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10). Recent headlines include layoff or workforce-reduction announcements.","financial_summary":["Freeport-McMoRan, Inc. is a large-cap basic materials business with a $85.0B market cap on $25.9B of annual revenue.","The top line has compounded at +4% over the past three years and +5% annually across the full decade, which puts it in mature, slow-growth territory.","Returns on capital run at 21% against a 10% cost of capital \u2014 a 11-point spread that is the clearest signature of an economic moat.","The business throws off $1.1B in free cash flow \u2014 roughly 4 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.55\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.6\u00d7 net debt/EBITDA, and interest coverage of 25\u00d7 is fortress-like.","Shareholder yield is only 1.1%, a thin return of capital, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 1.9\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Price sits 282% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":2.8219647235363543},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Insiders are net sellers (100% sell ratio, net $8.4M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Recent layoff news \u2014 often the market\u2019s first signal that growth is under pressure or costs are being rebased","sev":"amber","cat":"news"},{"text":"Weakness in commodity prices pressures materials companies","sev":"amber","cat":"sector"},{"text":"Commodity price volatility and cost-curve position \u2014 in a downturn only the lowest-cost producer has a business, and the rest carry the overhead.","sev":"amber","cat":"thesis_risk"},{"text":"Environmental remediation liability \u2014 tightening regulations on emissions, tailings, and water use create open-ended balance-sheet risk that grows with each legislative cycle.","sev":"amber","cat":"thesis_risk"},{"text":"Trade policy and tariff whiplash \u2014 materials producers are first-order casualties of protectionist swings, and margin gets squeezed from both input and output pricing.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Reinvestment rate supports 11% organic growth capacity \u2014 capital is compounding inside the business","Operating margins 16% above sector median \u2014 the quantitative trace of pricing power","Healthy payout ratio leaves room for both dividend growth and reinvestment","ROIC sits in the top quartile of Basic Materials peers \u2014 the moat is wider than the neighbourhood"],"news_headlines":[{"title":"How Is the Grasberg Recovery Setting Up Stronger Copper Sales at FCX (NYSE:FCX)?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/stocks/metal-and-mining/how-is-the-grasberg-recovery-setting-up-stronger-copper-sales-at-fcx-nysefcx","date":"2026-11-13","timestamp":1794574740.0,"origin":"tiingo","sentiment":0.878,"tier":0,"scope":"company","tags":[]},{"title":"TDG Gold Corp. agrees to sell 51% interest in Aurora West Property to Freeport-McMoRan Mineral Properties Canada Inc. for C$110 million and to grant certain additional earn-in rights upon funding of C$80 million of expenditures and upon C$40 million cash payment","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/commodities/articles/tdg-gold-corp-agrees-sell-183800100.html","date":"2026-11-12","timestamp":1794508680.0,"origin":"tiingo","sentiment":0.953,"tier":1,"scope":"company","tags":[]},{"title":"Follow our live scoreboard for FHSAA high school playoff football scores","source":"aol.com","link":"https://www.aol.com/articles/live-scoreboard-fhsaa-high-school-222449000.html","date":"2026-11-13","timestamp":1794609558.0,"origin":"tiingo","sentiment":0.0,"tier":2,"scope":"company","tags":["layoffs"]},{"title":"HSBC Says Buy the Dip in These 11 Stocks -- Alphabet and Oracle Top the List","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/hsbc-says-buy-dip-11-185515397.html","date":"2026-11-13","timestamp":1794596115.0,"origin":"tiingo","sentiment":0.382,"tier":2,"scope":"company","tags":[]},{"title":"Plans for UK's largest loo roll factory unravel","source":"aol.com","link":"https://www.aol.com/articles/plans-uks-largest-loo-roll-163843000.html","date":"2026-11-13","timestamp":1794588555.0,"origin":"tiingo","sentiment":0.0,"tier":2,"scope":"company","tags":[]},{"title":"Plans for UK's largest loo roll factory in Goole unravel","source":"bbc.co.uk","link":