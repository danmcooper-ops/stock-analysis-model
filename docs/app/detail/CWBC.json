n_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.019733213981300235,"_gp_pool_share":true,"_score_pool_share":47.9,"_gate_rev_durability":0.11325858418997647,"_gp_rev_durability":true,"_score_rev_durability":81.6,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.013217539981263083,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":25.8,"_gate_share_shrink":0.08671889495430207,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.007895382769247552,"_gp_sbc_dilution":true,"_score_sbc_dilution":86.8,"_gate_insider_own":0.09386,"_gp_insider_own":true,"_score_insider_own":62.6,"_gate_insider_buying":1.0,"_gp_insider_buying":true,"_score_insider_buying":100.0,"pf":[],"description_full":"Community West Bancshares operates as the bank holding company for Community West Bank, a California state-chartered commercial bank that provides a range of banking products and services to businesses, agribusiness customers, professionals, and individuals throughout Central California. The company accepts checking, savings, money market, and time deposit accounts, including certificates of deposit and non-interest-bearing demand deposits. It offers commercial and industrial loans; commercial real estate, construction, agricultural, farmland, multifamily, residential construction, mortgage, manufactured housing, SBA, and consumer loans; as well as lines of credit and other lending products. The company also provides private banking, treasury management, cash management, online and mobile banking, remote deposit capture, domestic and international wire transfers, bill payment, account transfers, and other customary banking services. Community West Bank operates full-service banking centers across Greater Sacramento, the San Joaquin Valley, and the Central Coast. The company was formerly known as Central Valley Community Bancorp and changed its name to Community West Bancshares in April 2024. Community West Bancshares was founded in 1979 and is based in Fresno, California.","ceo_bio":"Mr. James J. Kim | President, CEO & Director | Age 49 | Compensation: $1.1M (FY2025)","culture_narrative":"Employs approximately 327 people. Revenue per employee of $449K ranks in the below the sector median among Financial Services peers, improving at 10%/yr \u2014 growing workforce leverage. Each employee generates $133K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 2\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags moderate compensation governance risk (5/10).","financial_summary":["Community West Bancshares is a small-cap financial services business with a $705M market cap on $147M of annual revenue.","The top line has compounded at +20% over the past three years and +11% annually across the full decade, the kind of sustained demand persistence that marks a compounder.","Returns on capital run at 17% against a 9% cost of capital, a 8-point spread that creates value, though narrow enough that competitive pressure could close it.","The business throws off $44M in free cash flow \u2014 roughly 30 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.21\u00d7 so those profits are backed by real cash.","On the balance sheet, the balance sheet carries net cash, which is the gold standard: the business never has to make desperate decisions in a bad year, and thin 1.1\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield is only 1.3%, a thin return of capital, and insiders hold 9.4% of the shares."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.3) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Above-average short interest at 6.9% of float","sev":"amber","cat":"sentiment"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Shares offer a 15% margin of safety against estimated fair value","Insiders are net buyers (100% buy ratio) \u2014 insiders sell for many reasons but buy for only one","14 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Community West Bancshares (NASDAQ:CWBC) Plans Quarterly Dividend of $0.12","source":"thelincolnianonline.com","link":"https: