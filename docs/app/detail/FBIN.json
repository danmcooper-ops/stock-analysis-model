v":null,"_gate_mult_vs_hist":0.20278276897541048,"_gp_mult_vs_hist":false,"_score_mult_vs_hist":53.1,"_gate_fcf_yield":0.06439256561777988,"_gp_fcf_yield":true,"_score_fcf_yield":41.6,"_gate_int_coverage":4.480034722222222,"_gp_int_coverage":true,"_score_int_coverage":18.3,"_gate_net_debt_ebitda":3.5919685039370077,"_gp_net_debt_ebitda":false,"_score_net_debt_ebitda":9.1,"_gate_accruals":-0.0275741496181333,"_gp_accruals":true,"_score_accruals":37.5,"_gate_rev_volatility":0.13895920139938,"_gp_rev_volatility":false,"_score_rev_volatility":74.6,"_gate_margin_vs_hist":-0.01778607776272839,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":0.032475753874208146,"_gp_spread":false,"_score_spread":16.2,"_gate_roic_consistency":0.3812971153849155,"_gp_roic_consistency":false,"_score_roic_consistency":36.5,"_gate_incr_roic":0.17375123861973418,"_gp_incr_roic":true,"_score_incr_roic":74.6,"_gate_margin_advantage":0.026952979718903147,"_gp_margin_advantage":false,"_score_margin_advantage":42.3,"_gate_pool_share":-0.18432941756121402,"_gp_pool_share":false,"_score_pool_share":0.0,"_gate_rev_durability":-0.0025668986299255403,"_gp_rev_durability":false,"_score_rev_durability":23.7,"_gate_fcf_durability":-0.11488565645997084,"_gp_fcf_durability":false,"_score_fcf_durability":0.0,"_gate_margins":0.021293618606975297,"_gp_margins":true,"_score_margins":71.3,"_gate_fund_growth":0.11723424389558323,"_gp_fund_growth":true,"_score_fund_growth":100.0,"_gate_shrhldr_yield":0.06467344921916605,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":83.0,"_gate_share_shrink":-0.02856390032342926,"_gp_share_shrink":true,"_score_share_shrink":85.7,"_gate_sbc_dilution":0.004660333393081197,"_gp_sbc_dilution":true,"_score_sbc_dilution":92.2,"_gate_insider_own":0.0053399997,"_gp_insider_own":false,"_score_insider_own":3.6,"_gate_insider_buying":0.875,"_gp_insider_buying":true,"_score_insider_buying":87.5,"pf":[],"description_full":"Fortune Brands Innovations, Inc. provides home, security, and digital products for residential home repair, remodeling, new construction, and security applications in the United States and internationally. It operates through three segments: Water, Outdoors, and Security. The Water segment manufactures, assembles, and sells faucets, accessories, hardware, kitchen sinks, and waste disposals, under the Moen, ROHL, Riobel, Victoria+Albert, Perrin & Rowe, Aqualisa, Shaws, Emtek, Schaub, and SpringWell brands. Its Outdoors segment manufactures and sells fiberglass and steel entry door systems under the Therma-Tru brand; storm, screen, and security doors under the Larson brand; composite decking, railing and cladding under the Fiberon brand; urethane millwork under the Fypon brand; and wide-opening exterior door systems and outdoor enclosures under the Solar Innovations brand. The Security segment offers locks, safety and security devices, connected and mechanical lock out tag out solutions, and electronic security under the Master Lock, American Lock, and Yale and August brands; and fire-resistant safes, security containers, and commercial cabinets under the SentrySafe brand. The company sells its products through various sales channels, including kitchen and bath dealers; wholesalers oriented toward builders or professional remodelers; industrial and locksmith distributors; do-it-yourself remodeling-oriented home centers; showrooms; e-commerce; and other retail outlets. Fortune Brands Innovations, Inc. was incorporated in 1988 and is headquartered in Deerfield, Illinois.","ceo_bio":"Mr. Jesse G. Singh B.S., M.B.A. | CEO & Director | Age 59","culture_narrative":"Employs approximately 10K people. Revenue per employee of $446K ranks in the above the sector median among Industrials peers. Each employee generates $37K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. Governance score flags elevated compensation governance risk (9/10).","financial_summary":["Fortune Brands Innovations, Inc is a mid-cap industrials business with a $5.7B market cap on $4.5B of annual revenue.","The top line has compounded at -2% over the past three years and -0% annually across the full decade \u2014 essentially flat, and a business treading water is rarely a path to compounding.","Returns on capital run at 12% against a 8% cost of capital, a 3-point spread that creates value, though narrow enough that competitive pressure could close it, with gross margins sitting at 36%.","The business throws off $367M in free cash flow \u2014 roughly 8 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.60\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is moderate at 3.6\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 4.5\u00d7.","Management returns a meaningful 6.5% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Price sits 61% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":0.6086787076217529},{"text":"Payout ratio of 96% leaves essentially no coverage if earnings wobble","sev":"red","cat":"dividend"},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Above-average short interest at 8.7% of float","sev":"amber","cat":"sentiment"},{"text":"Industrials sector lagging the market significantly, underperforming by 8% over 3 months","sev":"amber","cat":"sector"},{"text":"Industrials ETF trading well below its long-term trend","sev":"amber","cat":"sector"},{"text":"Cyclical sectors like Industrials tend to underperform in slowdowns","sev":"amber","cat":"sector"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Reinvestment rate supports 12% organic growth capacity \u2014 capital is compounding inside the business","Large open-market insider purchases (net $30.6M) \u2014 management putting its own capital behind the business","12 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible"],"news_headlines":[{"title":"Learn Why The Bull Case For Fortune Brands (FBIN) Could Change Following Weaker Earnings","source":"simplywall.st","link":"https://simplywall.st/stocks/us/capital-goods/nyse-fbin/fortune-brands-innovations/news/learn-why-the-bull-case-for-fortune-brands-fbin-could-change-1","date":"2026-11-06","timestamp":1793976029.846,"origin":"tiingo","sentiment":-0.649,"tier":0,"scope":"company","tags":["earnings"]},{"title":"Fortune Brands (FBIN) Cuts 2026 Outlook Following Weak Q3 As Valuation Debate Heats Up","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/fortune-brands-fbin-cuts-2026-152155666.html","date":"2026-11-05","timestamp":1793892115.0,"origin":"tiingo","sentiment":-0.852,"tier":0,"scope":"company","tags":["earnings","guidance"]},{"title":"Is Fortune Brands (FBIN) Undervalued After Its Leadership Shake Up?","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/fortune-brands-fbin-undervalued-leadership-131747446.html","date":"2026-11-05","timestamp":1793884667.0,"origin":"tiingo",