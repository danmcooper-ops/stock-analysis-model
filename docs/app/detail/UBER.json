cks).","The share count has grown 0.9% a year over five years, diluting existing holders."],"people":["With about 37,300 employees, each generates about $1.4M of revenue, 3.7x the Technology median, and revenue has grown 24.2% a year across its filed history.","That works out to $262K of free cash flow per employee.","CEO pay is $4.5M (3x revenue per employee), and compensation governance scores poorly (8/10, lower is better).","Stock compensation averages $49K per employee."]},"profile":{"v":"AVOID","conv":52,"head":"Avoid: priced 109% above its fair value of $30.42.","pros":["FCF margin 18.8%","Revenue grew 36.1%/yr over 5y","Net debt/EBITDA 0.5x","Altman Z in the safe zone","P/FCF 13.3x vs sector 23.3x"],"cons":["Composite 24, below the 25 line (gates 6/24)","Trades 109% above fair value of $30.42","ROIC 7.3% vs WACC 10.6%","P/E 37.3x vs sector 24.4x"],"flags":["Priced 109% above its fair value of $30.42","Its composite score (24) is below 25"],"need":[],"buy_below":25.86,"vc":{"base":30.42,"base_src":"dcf","bear":24.08,"bull":38.9,"alt_median":57.17,"n_alt":1,"gap":-0.4678,"dispersion":0.3053,"level":"LOW","why":["models disagree (31% dispersion)"]},"med":{"pe":24.3759,"ev_ebitda":16.132,"pfcf":23.2596,"pb":3.2577,"roic":0.075,"gross_margin":0.4677,"fcf_margin":0.1222,"div_yield":0.0137}},"mc_quantiles":[20.49,22.86,24.08,25.27,26.24,27.09,27.79,28.38,29.12,29.9,30.57,31.13,32.0,33.0,33.87,34.79,35.76,37.34,38.9,42.08,47.87],"mc_drivers":{"growth":0.513,"discount_rate":0.408,"terminal_growth":0.019,"exit_multiple":0.059},"ticker":"UBER","date":"2026-11-20"}