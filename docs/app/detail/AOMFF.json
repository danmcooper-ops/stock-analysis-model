int_coverage":25.4,"_gate_net_debt_ebitda":0.832010582010582,"_gp_net_debt_ebitda":true,"_score_net_debt_ebitda":70.4,"_gate_accruals":-0.016197686044850737,"_gp_accruals":true,"_score_accruals":25.4,"_gate_rev_volatility":null,"_gp_rev_volatility":null,"_score_rev_volatility":0.0,"_gate_margin_vs_hist":null,"_gp_margin_vs_hist":null,"_score_margin_vs_hist":null,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":-0.04138309600225714,"_gp_spread":false,"_score_spread":0.0,"_gate_roic_consistency":0.24751425584317277,"_gp_roic_consistency":true,"_score_roic_consistency":58.7,"_gate_incr_roic":0.14169109247242948,"_gp_incr_roic":true,"_score_incr_roic":63.9,"_gate_margin_advantage":-0.05391364578645922,"_gp_margin_advantage":false,"_score_margin_advantage":15.4,"_gate_pool_share":null,"_gp_pool_share":null,"_score_pool_share":null,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":0.0,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.009895456881255128,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":22.1,"_gate_share_shrink":null,"_gp_share_shrink":null,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.0006259454384226176,"_gp_sbc_dilution":true,"_score_sbc_dilution":99.0,"_gate_insider_own":0.01977,"_gp_insider_own":false,"_score_insider_own":13.2,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Alstom SA provides solutions for rail transport industry in Europe, the Americas, the Asia Pacific, the Middle East, Central Asia, and Africa. The company offers rolling stock solutions comprising people movers and monorails, light rails, metros, commuter and regional trains, high-speed trains, and locomotives; asset optimization, connectivity, and security and city mobility solutions; and signaling products, such as urban, mainline, and freight and mining signaling. It also provides APM, monorail, tram, metro, and main line systems; and tracklaying and track, catenary free and ground feeding, electrification, cybersecurity, and engineering consultancy solutions, as well as electromechanical equipment. In addition, the company offers rail maintenance, modernization, overhaul, parts, repair and overhauls, and support services. Further, it provides various components, including bogies, motors, dampers, brake friction products, switchgears, traction and auxiliary converters, transformers, green traction solutions, interiors, and train control and information systems. The company offers its products and solutions to original equipment manufacturers, operators, and asset owners. Alstom SA was founded in 1928 and is based in Saint-Ouen, France.","ceo_bio":"Mr. Martin  Sion | CEO & Director | Age 57","culture_narrative":"Employs approximately 87K people. Revenue per employee of $239K ranks in the bottom quartile among Industrials peers. Each employee generates $4K of free cash flow annually. Stock-based compensation of $149 per employee reflects an ownership culture. Governance score flags low compensation governance risk (2/10). R&D investment of 3% of revenue (limited) signals commitment to product development and talent.","financial_summary":["Alstom is a mid-cap industrials business with a $4.2B market cap on $21.0B of annual revenue.","The top line has compounded at +9% over the past three years, a respectable pace for a business of this size.","Returns on capital run at 3% against a 7% cost of capital, which means the business is destroying value with every dollar it reinvests, and 12% gross margins are typical of commodity economics where competitors can replicate the product cheaply.","The business throws off $354M in free cash flow \u2014 roughly 2 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.75\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.8\u00d7 net debt/EBITDA, and interest coverage runs at 5.8\u00d7.","Shareholder yield is only 1.0%, a thin return of capital, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and profit capture is only 0.3\u00d7 the fair share, suggesting no structural edge inside its industry."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.7) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Carries a 213% premium to sector median EV/EBITDA","sev":"amber","cat":"valuation","magnitude":2.1297248261263984},{"text":"Gross margin trails most Industrials peers \u2014 competitors appear to have the pricing hand","sev":"amber","cat":"moat"},{"text":"Cyclicality and capital intensity \u2014 order books turn on a dime, and the heavy fixed cost base that creates the moat also magnifies the downturn.","sev":"amber","cat":"thesis_risk"},{"text":"Supply chain reshoring costs and labour shortages \u2014 onshoring mandates raise capex requirements while a shrinking skilled-labour pool inflates operating costs.","sev":"amber","cat":"thesis_risk"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Trading at a 71% margin of safety to estimated fair value \u2014 a real cushion against errors in the estimate","Market is pricing in lower growth than the company has historically delivered","Trading near the bottom of its 52-week range \u2014 the market is offering a discount"],"news_headlines":[{"tit