s_hist":null,"_gate_piotroski":7,"_gp_piotroski":true,"_score_piotroski":77.8,"_gate_spread":0.014593493377471359,"_gp_spread":false,"_score_spread":7.3,"_gate_roic_consistency":0.04411706131271855,"_gp_roic_consistency":true,"_score_roic_consistency":92.6,"_gate_incr_roic":-0.009831133447458857,"_gp_incr_roic":false,"_score_incr_roic":13.4,"_gate_margin_advantage":-0.00593198706033371,"_gp_margin_advantage":false,"_score_margin_advantage":31.4,"_gate_pool_share":null,"_gp_pool_share":null,"_score_pool_share":null,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":0.0,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":0.0341087895783599,"_gp_fund_growth":true,"_score_fund_growth":34.1,"_gate_shrhldr_yield":0.014330807976837364,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":27.0,"_gate_share_shrink":null,"_gp_share_shrink":null,"_score_share_shrink":0.0,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.04237,"_gp_insider_own":false,"_score_insider_own":28.2,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Daikin Industries,Ltd., together with its subsidiaries, manufactures and sells air conditioning and refrigeration equipment in Japan, the United States, China, Europe, Asia, Oceania, and internationally. The company offers split/multi-split type air conditioners, unitary, air to water heat pump systems, heating systems, air purifiers, medium/low temperature refrigeration, packaged air conditioners, VRV, ventilation products, control systems, container refrigeration units, air and water cooled chillers, rooftops, air side equipment, air filters, and marine HVAC; and after-sales services, including troubleshooting, preventive maintenance, training and technical support, parts and consumables, and error codes. It also provides chemical products, such as fluoropolymers, fluoroelastomers, and fluorine gas; air purification filters and dust collection and sound suppression systems; oil hydraulic pumps and units; defense systems, aircraft parts, and medical equipment; and electronics and IT solutions. The company was founded in 1924 and is headquartered in Kita, Japan.","ceo_bio":"Mr. Masanori  Togawa | CEO & Representative Chairman | Age 76 | Compensation: $2.2M (FY2026)","culture_narrative":"Employs approximately 104K people. Revenue per employee of $302K ranks in the below the sector median among Industrials peers. Each employee generates $15K of free cash flow annually. CEO compensation is 7\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["Daikin Industries Ltd. is a large-cap industrials business with a $39.7B market cap on $31.4B of annual revenue.","The top line has compounded at +4% over the past three years, which puts it in mature, slow-growth territory.","Returns on capital run at 9% against a 8% cost of capital, which means the business barely earns its keep economically, with gross margins sitting at 34%.","The business throws off $1.6B in free cash flow \u2014 roughly 5 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.69\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.2\u00d7 net debt/EBITDA, and interest coverage runs at 10.6\u00d7.","Shareholder yield is only 1.4%, a thin return of capital, and insiders hold 4.2% of the shares."],"sector_headwinds":[{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Industrials sector lagging the market significantly, underperforming by 6% over 3 months","sev":"amber","cat":"sector"},{"text":"Cyclicality and capital intensity \u2014 order books turn on a dime, and the heavy fixed cost base that creates the moat also magnifies the downturn.","sev":"amber","cat":"thesis_risk"},{"text":"Supply chain reshoring costs and labour shortages \u2014 onshoring mandates raise capex requirements while a shrinking skilled-labour pool inflates operating costs.","sev":"amber","cat":"thesis_risk"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Trading at a 35% margin of safety to estimated fair value \u2014 a real cushion against errors in the estimate","Market is pricing in lower growth than the company has historically delivered","Valued at a 97% discount to sector median EV/EBITDA","Returns on capital have been remarkably steady for 5 years \u2014 durability is the real test of a moat","Piotroski score 7/9 \u2014 financials improving across profitability, leverage and efficiency","12 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Daikin Industries,Ltd. (DKILF) Stock Price, News, Quote & History - Yahoo! Finance Canada","source":"Yahoo! Finance Canada","link":"https://news.google.com/rss/articles/CBMiU0FVX3lxTE40Z29xWktEckpkRndkT1RUTHN6WXgzTmR2bTQ2WWFkamdFcjJCYTFrLVlJUksxS2dNcHZDdXZYSWh4MjJEWkNTX0xBVjJONFN1ZHNF?oc=5","date":"2026-11-07","timestamp":1794063126.0,"origin":"google_news_ticker","tier":0,"scope":"company","tags":[]},{"title":"Daikin Industries,Ltd. (6367.T) Stock Price, News, Quote & History - Yahoo! Finance Canada","source":"Yahoo! Finance Canada","link":"https://news.google.com/rss/articles/CBMiVEFVX3lxTE9heUhHTVlmLW5XUUdhVXhLYkk3ZmJuelA4OXF