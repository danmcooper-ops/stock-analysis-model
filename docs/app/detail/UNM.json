age":null,"_gate_net_debt_ebitda":null,"_gp_net_debt_ebitda":null,"_score_net_debt_ebitda":null,"_gate_accruals":0.0007997556651983489,"_gp_accruals":true,"_score_accruals":28.0,"_gate_rev_volatility":0.03557450619821676,"_gp_rev_volatility":true,"_score_rev_volatility":100.0,"_gate_margin_vs_hist":-0.036948744763349736,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":3,"_gp_piotroski":false,"_score_piotroski":33.3,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":-0.10720524797934827,"_gp_pool_share":false,"_score_pool_share":0.0,"_gate_rev_durability":0.019954026803900016,"_gp_rev_durability":false,"_score_rev_durability":35.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.11148387155604235,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":100.0,"_gate_share_shrink":-0.053899131614288165,"_gp_share_shrink":true,"_score_share_shrink":100.0,"_gate_sbc_dilution":0.00409926962640052,"_gp_sbc_dilution":true,"_score_sbc_dilution":93.2,"_gate_insider_own":0.010240001,"_gp_insider_own":false,"_score_insider_own":6.8,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Unum Group, together with its subsidiaries, provides financial protection benefit solutions in the United States, the United Kingdom, and Poland. It operates through Unum US, Unum International, Colonial Life, and Closed Block segments. The company offers group long-term and short-term disability, group life, and accidental death and dismemberment products; supplemental and voluntary products, such as voluntary benefits, individual disability, and dental and vision products; and accident, sickness, disability, life, and cancer and critical illness products. It also provides group pensions, individual life and corporate-owned life insurance, reinsurance pools and management operations, and other miscellaneous products. The company sells its products to employers for the benefit of employees. It sells its products through field sales personnel, independent brokers, consultants, and independent contractor agent sales force and brokers. Unum Group was formerly known as UnumProvident Corporation and changed its name to Unum Group in March 2007. The company was founded in 1848 and is based in Chattanooga, Tennessee.","ceo_bio":"Mr. Richard Paul McKenney | President, CEO & Director | Age 56 | Compensation: $13.7M (FY2025)","culture_narrative":"Employs approximately 10K people. Revenue per employee of $1.2M ranks in the top quartile among Financial Services peers. Each employee generates $52K of free cash flow annually. Stock-based compensation of $5K per employee reflects an ownership culture. CEO compensation is 11\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags low compensation governance risk (3/10).","financial_summary":["Unum Group is a large-cap financial services business with a $11.8B market cap on $13.1B of annual revenue.","The top line has compounded at +3% over the past three years and +2% annually across the full decade, which puts it in mature, slow-growth territory.","Returns on capital run at 11% against a 8% cost of capital, a 3-point spread that creates value, though narrow enough that competitive pressure could close it.","The business throws off $555M in free cash flow \u2014 roughly 4 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, with adequate 0.93\u00d7 cash conversion.","On the balance sheet, debt is moderate at 3.0\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 5.5\u00d7.","Management returns a meaningful 11.1% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and profit capture is only 0.3\u00d7 the fair share, suggesting no structural edge inside its industry."],"sector_headwinds":[{"text":"Price sits 226% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 2 other valuation measures)","sev":"red","cat":"valuation","magnitude":2.258573738375686},{"text":"Piotroski score 3/9 \u2014 the fundamentals are deteriorating on multiple fronts","sev":"red","cat":"quality"},{"text":"Altman Z in the distress zone (0.7) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Payout ratio looks stretched \u2014 the dividend\u2019s own margin of safety is thin","sev":"red","cat":"dividend"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Operating margins 20% below sector median \u2014 a cost disadvantage the moat cannot hide","sev":"amber","cat":"moat"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Insiders are net sellers (100% sell ratio, net $2.6M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Financial quality metrics lag Financial Services peers","sev":"amber","cat":"quality"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_t