_vs_hist":100.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":-0.011550778677106077,"_gp_pool_share":false,"_score_pool_share":35.4,"_gate_rev_durability":0.06506938122150152,"_gp_rev_durability":true,"_score_rev_durability":57.5,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.030167040455803353,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":44.6,"_gate_share_shrink":0.0368987633977238,"_gp_share_shrink":false,"_score_share_shrink":3.9,"_gate_sbc_dilution":0.007576333605436711,"_gp_sbc_dilution":true,"_score_sbc_dilution":87.4,"_gate_insider_own":0.02834,"_gp_insider_own":false,"_score_insider_own":18.9,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"NBT Bancorp Inc., a financial holding company, provides personal and commercial banking, retail banking, and wealth management services in the United States. It operates through Banking, Retirement Plan Administration, and All Other segments. The company offers demand deposit, savings, interest-bearing checking, money market deposit, and certificate of deposit accounts; and indirect and direct consumer loans, home equity loans and lines of credit, residential mortgages, business banking loans, commercial and industrial loans, agricultural loans, commercial construction loans, commercial real estate loans, indirect auto loans, and other consumer loans, as well as agricultural lending, personal lines of credit, overdraft protection, and second mortgage loans. It also provides trust and investment services; financial planning and life insurance services; and retirement plan and health savings account recordkeeping and administration, and actuarial services. In addition, the company offers insurance products, such as personal property and casualty, business liability, and commercial insurance; and other products and services through a network of ATM locations and 24-hour online, mobile, and telephone channels that enable customers to check balances, make deposits, transfer funds, pay bills, access statements, apply for loans, and access various other products and services. Further, it operates as a property management and passive investment company, as well as investment advisor that provides investment management and financial consulting services. The company serves retail, commercial, and municipal customers. It operates in upstate New York, northeastern Pennsylvania, southern New Hampshire, western Massachusetts, Vermont, southern Maine, and central and northwestern Connecticut. NBT Bancorp Inc. was founded in 1856 and is headquartered in Norwich, New York.","ceo_bio":"Mr. Scott A. Kingsley CPA | President, CEO & Director | Age 60 | Compensation: $1.5M (FY2025)","culture_narrative":"Employs approximately 2K people. Revenue per employee of $303K ranks in the bottom quartile among Financial Services peers, improving at 6%/yr \u2014 growing workforce leverage. Each employee generates $95K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. CEO compensation is 5\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["NBT Bancorp Inc. is a mid-cap financial services business with a $2.7B market cap on $697M of annual revenue.","The top line has compounded at +10% over the past three years and +7% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 10% against a 8% cost of capital, which means the business barely earns its keep economically.","The business throws off $219M in free cash flow \u2014 roughly 31 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.39\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.0\u00d7 net debt/EBITDA, and thin 1.0\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 3.0% reflects a genuine commitment to returning capital rather than empire-building, and insiders hold 2.8% of the shares."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.3) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Above-average short interest at 6.9% of float","sev":"amber","cat":"sentiment"},{"text":"Significant insider selling (net $2.1M)","sev":"amber","cat":"insider","dollars":-2118025.64},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_