dustrials median, and revenue has grown 11.7% a year across its filed history.","That works out to $26K of free cash flow per employee.","CEO pay is $974K (4x revenue per employee).","Stock compensation averages $7K per employee."]},"profile":{"v":"AVOID","conv":46,"head":"Avoid: priced 51% above its fair value of $44.74.","pros":["FCF margin 11.2%","Net cash of $124.2M","Altman Z in the safe zone","4 analysts' mean target $101 (+50%)","12-1 month momentum +87%"],"cons":["Trades 51% above fair value of $44.74","ROIC 2.9% vs WACC 10.3%","P/E 46.9x vs sector 24.1x","EV/EBITDA 18.7x vs sector 13.4x","Operating margin contracting 1.8%/yr"],"flags":["Priced 51% above its fair value of $44.74"],"need":[],"buy_below":38.03,"vc":{"base":44.74,"base_src":"dcf","bear":35.49,"bull":57.53,"alt_median":16.66,"n_alt":2,"gap":1.6848,"dispersion":0.2546,"level":"LOW","why":["DCF is 168% above the other models' median ($16.66)"]},"med":{"pe":24.0501,"ev_ebitda":13.39,"pfcf":22.9066,"pb":2.9489,"roic":0.0996,"gross_margin":0.2855,"fcf_margin":0.068,"div_yield":0.0143}},"mc_quantiles":[29.52,33.81,35.49,37.24,38.45,39.81,40.9,41.86,42.93,43.81,44.83,46.12,46.97,48.13,49.79,51.18,52.8,54.83,57.53,61.81,72.43],"mc_drivers":{"growth":0.588,"discount_rate":0.344,"terminal_growth":0.014,"exit_multiple":0.055},"ticker":"PRLB","date":"2026-11-13"}