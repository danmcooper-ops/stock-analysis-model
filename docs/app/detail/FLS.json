roski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":-0.0012483674594093302,"_gp_spread":false,"_score_spread":0.0,"_gate_roic_consistency":0.4921514686017039,"_gp_roic_consistency":false,"_score_roic_consistency":18.0,"_gate_incr_roic":-0.14761465806932905,"_gp_incr_roic":false,"_score_incr_roic":0.0,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":0.0,"_gate_pool_share":-0.02175147725627946,"_gp_pool_share":false,"_score_pool_share":31.3,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":0.11434547739954937,"_gp_fcf_durability":true,"_score_fcf_durability":82.2,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":0.02740510520209211,"_gp_fund_growth":false,"_score_fund_growth":27.4,"_gate_shrhldr_yield":0.0357653298415129,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":50.9,"_gate_share_shrink":-0.005371982723254898,"_gp_share_shrink":true,"_score_share_shrink":56.7,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.00619,"_gp_insider_own":false,"_score_insider_own":4.1,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Flowserve Corporation designs, manufactures, distributes, and services industrial flow management equipment in the United States, Canada, Mexico, Europe, the Middle East, Africa, and the Asia Pacific. The company operates in two segments, Flowserve Pumps Division (FPD) and Flow Control Division (FCD). It offers custom engineered pumps, pre-configured industrial pumps, pump systems, mechanical seals, auxiliary systems, replacement parts, and related services; and manufactures gas-lubricated mechanical seals for gas pipelines and in the energy production and process markets. The company also provides equipment services, including installation, commissioning services, seal systems spare parts, repairs, advanced diagnostics, re-rate and upgrade solutions, retrofit programs, and machining and asset management solutions. In addition, it offers engineered-to-order and configured-to-order isolation valves, control valves, valve automation products and related services and equipment; and actuators, positioners, and switches used to control, direct and manage the flow of liquids, gases and multi-phase fluids, and are a part of any flow control system. Further, the company provides equipment maintenance services for flow control systems, including advanced diagnostics, repair, installation, commissioning, retrofit programs, and field machining capabilities. It sells its products under the Valtek, Argus, Worcester, Limitorque, and Durco brands. The company serves oil and gas, power generation, chemical, water management and general industries, including pharmaceuticals, mining, food and beverage, steel, and pulp and paper industries. It distributes its products through direct sales, distributors, and sales representatives. Flowserve Corporation was founded in 1790 and is headquartered in Irving, Texas.","ceo_bio":"Mr. Robert Scott Rowe | President, CEO & Director | Age 54 | Compensation: $3.4M (FY2025)","culture_narrative":"Employs approximately 16K people. Each employee generates $27K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. Governance score flags low compensation governance risk (1/10).","financial_summary":["Flowserve Corporation is a large-cap industrials business with a $10.2B market cap on $0 of annual revenue.","The top line has compounded at +3% over the past three years, which puts it in mature, slow-growth territory.","Returns on capital run at 10% against a 10% cost of capital, which means the business is destroying value with every dollar it reinvests, with gross margins sitting at 34%.","The business throws off $435M in free cash flow, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.46\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.6\u00d7 net debt/EBITDA, and interest coverage runs at 5.1\u00d7.","Shareholder yield of 3.6% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Price sits 151% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":1.507048491227651},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Above-average short interest at 6.8% of float","sev":"amber","cat":"sentiment"},{"text":"Industrials sector lagging the market significantly, underperforming by 8% over 3 months","sev":"amber","cat":"sector"},{"text":"Industrials ETF trading well below its long-term trend","sev":"amber","cat":"sector"},{"text":"Cyclical sectors like Industrials tend to underperform in slowdowns","sev":"amber","cat":"sector"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Cyclicality and capital intensity \u2014 order books turn on a dime, and the heavy fixed cost base that creates the moat also magnifies the downturn.","sev":"amber","cat":"thesis_risk"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["19 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for bo