0.0,"_gate_net_debt_ebitda":-0.26952377732358146,"_gp_net_debt_ebitda":true,"_score_net_debt_ebitda":94.9,"_gate_accruals":-0.04990517615062319,"_gp_accruals":true,"_score_accruals":49.2,"_gate_rev_volatility":0.155573652644472,"_gp_rev_volatility":false,"_score_rev_volatility":69.8,"_gate_margin_vs_hist":-0.0041606665248450775,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.8455145476390196,"_gp_spread":true,"_score_spread":100.0,"_gate_roic_consistency":0.47469404359753087,"_gp_roic_consistency":false,"_score_roic_consistency":20.9,"_gate_incr_roic":0.52473952843778,"_gp_incr_roic":true,"_score_incr_roic":100.0,"_gate_margin_advantage":0.048565880678434106,"_gp_margin_advantage":false,"_score_margin_advantage":49.5,"_gate_pool_share":0.2543058840703756,"_gp_pool_share":true,"_score_pool_share":100.0,"_gate_rev_durability":0.12187076411830722,"_gp_rev_durability":true,"_score_rev_durability":85.9,"_gate_fcf_durability":0.10154073105170847,"_gp_fcf_durability":true,"_score_fcf_durability":75.8,"_gate_margins":-0.0006425960026935406,"_gp_margins":false,"_score_margins":49.4,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.03269652938714909,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":47.4,"_gate_share_shrink":-0.04600272725430676,"_gp_share_shrink":true,"_score_share_shrink":100.0,"_gate_sbc_dilution":0.003019974469087746,"_gp_sbc_dilution":true,"_score_sbc_dilution":95.0,"_gate_insider_own":0.0025,"_gp_insider_own":false,"_score_insider_own":1.7,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":["paper"],"description_full":"Ulta Beauty, Inc. operates as a specialty beauty retailer in the United States, Mexico, and Kuwait. The company offers branded and private label beauty products, including cosmetics, fragrance, haircare, skincare, bath and body products, professional hair products, and salon styling tools through its Ulta Beauty stores, shop-in-shops, Ulta.com website, and its mobile applications. It also provides wellness products. The company was formerly known as ULTA Salon, Cosmetics & Fragrance, Inc. and changed its name to Ulta Beauty, Inc. in January 2017. Ulta Beauty, Inc. was incorporated in 1990 and is based in Bolingbrook, Illinois.","ceo_bio":"Ms. Kecia L. Steelman | President, CEO & Director | Age 54 | Compensation: $5.8M (FY2025)","culture_narrative":"Employs approximately 21K people. Revenue per employee of $580K ranks in the above the sector median among Consumer Cyclical peers, improving at 15%/yr \u2014 growing workforce leverage. Each employee generates $50K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. CEO compensation is 10\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags elevated compensation governance risk (9/10).","financial_summary":["Ulta Beauty, Inc. is a large-cap consumer cyclical business with a $27.6B market cap on $12.4B of annual revenue.","The top line has compounded at +7% over the past three years and +12% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 93% against a 9% cost of capital \u2014 a 85-point spread that is the clearest signature of an economic moat, with gross margins sitting at 36%.","The business throws off $1.1B in free cash flow \u2014 roughly 9 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.30\u00d7 so those profits are backed by real cash.","On the balance sheet, the balance sheet carries net cash, which is the gold standard: the business never has to make desperate decisions in a bad year.","Shareholder yield of 3.3% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Carries a 40% premium to sector median EV/EBITDA (confirmed by 1 other valuation measure)","sev":"amber","cat":"valuation","magnitude":0.40149536077830805},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Insiders are overwhelmingly selling (100% sell ratio) \u2014 the people who know the business want less of it","sev":"amber","cat":"insider","ratio":0.0},{"text":"Cyclical sectors like Consumer Cyclical tend to underperform in slowdowns","sev":"amber","cat":"sector"},{"text":"Consumer staples outperforming discretionary, signaling cautious spending","sev":"amber","cat":"sector"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Consumer demand is fundamentally cyclical \u2014 a recession compresses both unit volume and pricing power, and operating leverage cuts both ways.","sev":"amber","cat":"thesis_risk"},{"text":"Brand relevance decay \u2014 shifting consumer preferences and social-media-driven trends can strand inventory and invalidate positioning faster than product cycles can adapt.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Altman Z comfortably in the safe zone \u2014 a fortress balance sheet on this measure","ROIC sits in the top quartile of Consumer Cyclical peers \u2014 the moat is wider than the neighbourhood","Minimal goodwill on the balance sheet \u2014 low impairment risk","Consumer Cyclical sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"Ulta Beauty (ULTA) Stock Looks Expensive On Current Earnings","source":"simplywall.st","link":"https://simplywall.st/stocks/us/retail/nasdaq-ul