ate_margin_vs_hist":0.0565734616171768,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":29.3,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.0755908116642936,"_gp_pool_share":true,"_score_pool_share":70.2,"_gate_rev_durability":0.09966341246166865,"_gp_rev_durability":true,"_score_rev_durability":74.8,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.02507126000028703,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":39.0,"_gate_share_shrink":-0.006372465246201275,"_gp_share_shrink":true,"_score_share_shrink":58.0,"_gate_sbc_dilution":0.02598661052930294,"_gp_sbc_dilution":false,"_score_sbc_dilution":56.7,"_gate_insider_own":0.00852,"_gp_insider_own":false,"_score_insider_own":5.7,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"East West Bancorp, Inc. operates as the bank holding company for East West Bank that provides a range of personal and commercial banking services to businesses and individuals in the United States. The company operates through three segments: Consumer and Business Banking, Commercial Banking, and Treasury and Other. It accepts various deposit products, such as personal and business checking and savings accounts, money market, and time deposits. The company provides various loan products, such as mortgage and home equity, commercial and residential real estate, construction finance, commercial business lending, working capital lines of credit, trade finance, letters of credit, affordable housing lending, asset-based lending, asset-backed finance, project finance, equipment financing, loan syndication, and equipment loans, as well as financing services for clients to facilitate their business transactions between the United States and Asia. It also provides foreign exchange, treasury management, wealth management, and interest rate and commodity risk hedging services; and mobile, and online banking services. The company was founded in 1973 and is headquartered in Pasadena, California.","ceo_bio":"Mr. Dominic  Ng CPA | Chairman, President & CEO | Age 66 | Compensation: $4.6M (FY2025)","culture_narrative":"Employs approximately 3K people. Revenue per employee of $838K ranks in the above the sector median among Financial Services peers, with revenue growing 9%/yr across its filed history. Stock-based compensation of $22K per employee reflects an ownership culture. CEO compensation is 5\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["East West Bancorp, Inc. is a large-cap financial services business with a $18.0B market cap on $2.9B of annual revenue.","The top line has compounded at +8% over the past three years and +10% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 47% against a 10% cost of capital \u2014 a 37-point spread that is the clearest signature of an economic moat.","On the balance sheet, the balance sheet carries net cash, which is the gold standard: the business never has to make desperate decisions in a bad year, and thin 1.0\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 2.5% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 2.3\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.4) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Price sits 21% above estimated fair value \u2014 no margin of safety left","sev":"amber","cat":"valuation","magnitude":0.21432771521359423},{"text":"Insiders are net sellers (100% sell ratio, net $21.1M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Operating margins 30% above sector median \u2014 the quantitative trace of pricing power","26 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","ROIC sits in the top quartile of Financial Services peers \u2014 the moat is wider than the neighbourhood","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Research Analysts\u2019 New Coverage for November 10th (ALVO, AS, BTI, BURL, CTY, DECK, DKS, DSP, EME, EWBC)","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/10/research-analysts-new-coverage-for-november-10th-alvo-as-bti-burl-cty-deck-dks-dsp-eme-ewbc.html","date":"2026-11-10"