n_vs_hist":100.0,"_gate_piotroski":4,"_gp_piotroski":false,"_score_piotroski":44.4,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":-0.0625633223005424,"_gp_pool_share":false,"_score_pool_share":15.0,"_gate_rev_durability":0.028942899658289667,"_gp_rev_durability":true,"_score_rev_durability":39.5,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.05195020886160923,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":68.8,"_gate_share_shrink":-0.005166839214443608,"_gp_share_shrink":true,"_score_share_shrink":56.5,"_gate_sbc_dilution":0.002202104232933692,"_gp_sbc_dilution":true,"_score_sbc_dilution":96.3,"_gate_insider_own":0.20236,"_gp_insider_own":true,"_score_insider_own":100.0,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"American Financial Group, Inc., an insurance holding company, provides property and casualty insurance products in the United States. It operates through Property and Casualty Insurance and Other segments. The company offers property and transportation insurance products, such as physical damage and liability coverage for buses and trucks, other specialty transportation niches, inland and ocean marine, agricultural-related products, and other commercial property coverages; specialty casualty insurance, including primarily excess and surplus, executive and professional liability, general liability, umbrella and excess liability, and specialty coverage in targeted markets, as well as customized programs for small to mid-sized businesses and workers compensation insurance; and specialty financial insurance products comprising risk management insurance programs for lending and leasing institutions, fidelity and surety products, and trade credit insurance. It sells its property and casualty insurance products through independent insurance agents and brokers. American Financial Group, Inc. was formerly known as American Financial Group Holdings Inc and changed its name to American Financial Group, Inc. in July 1997. The company was founded in 1872 and is headquartered in Cincinnati, Ohio.","ceo_bio":"Mr. Stephen Craig Lindner | Co-CEO & Director | Age 70 | Compensation: $9.6M (FY2025)","culture_narrative":"Employs approximately 8K people. Revenue per employee of $962K ranks in the above the sector median among Financial Services peers. Stock-based compensation of $2K per employee reflects an ownership culture. CEO compensation is 10\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["American Financial Group, Inc. is a large-cap financial services business with a $13.3B market cap on $8.2B of annual revenue.","The top line has compounded at +5% over the past three years and +3% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 18% against a 7% cost of capital \u2014 a 11-point spread that is the clearest signature of an economic moat.","On the balance sheet, leverage is comfortably conservative at 0.1\u00d7 net debt/EBITDA, and interest coverage of 13\u00d7 is fortress-like.","Management returns a meaningful 5.2% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insiders hold 20% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is, and profit capture is only 0.5\u00d7 the fair share, suggesting no structural edge inside its industry."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.6) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Operating margins 16% below sector median \u2014 a cost disadvantage the moat cannot hide","sev":"amber","cat":"moat"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Trading near 52-week highs \u2014 the market has already recognised the story (confirmed by 1 other valuation measure)","sev":"amber","cat":"valuation","magnitude":0.6517412935323392},{"text":"Piotroski score 4/9 \u2014 below the median for a healthy business","sev":"amber","cat":"quality"},{"text":"Insiders are net sellers (100% sell ratio, net $15.6M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["39 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Australian Finance Group (ASX:AFG): What Changes With Its New AI Tool?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/au/stocks/dividend/australian-fina