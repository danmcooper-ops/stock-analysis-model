gin_vs_hist":76.4,"_gate_piotroski":8,"_gp_piotroski":true,"_score_piotroski":88.9,"_gate_spread":-0.007979860627351468,"_gp_spread":false,"_score_spread":0.0,"_gate_roic_consistency":1.8139565668528548,"_gp_roic_consistency":false,"_score_roic_consistency":0.0,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":-0.02502105454043123,"_gp_margin_advantage":false,"_score_margin_advantage":25.0,"_gate_pool_share":0.014528964587175786,"_gp_pool_share":true,"_score_pool_share":45.8,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":0.0,"_gate_margins":-0.001056560523643671,"_gp_margins":false,"_score_margins":48.9,"_gate_fund_growth":0.02310868501925571,"_gp_fund_growth":false,"_score_fund_growth":23.1,"_gate_shrhldr_yield":0.005881017626917682,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":17.6,"_gate_share_shrink":0.04418827076112519,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.0063254744105807935,"_gp_sbc_dilution":true,"_score_sbc_dilution":89.5,"_gate_insider_own":0.38439998,"_gp_insider_own":true,"_score_insider_own":100.0,"_gate_insider_buying":0.583,"_gp_insider_buying":true,"_score_insider_buying":58.3,"pf":[],"description_full":"Mission Produce, Inc. engages in the sourcing, farming, packaging, marketing, and distribution of avocados, mangoes, and blueberries to food retailers, wholesalers, and foodservice customers in the United States and internationally. The company operates through three segments, Marketing and Distribution; International Farming; and Blueberries. It also provides ripening, bagging, custom packing, logistical management, and quality assurance services. In addition, the company offers merchandising and promotional support, and insights on market trends, and training services. Mission Produce, Inc. was founded in 1983 and is headquartered in Oxnard, California.","ceo_bio":"Mr. John  Pawlowski | President & CEO | Age 49 | Compensation: $1.4M (FY2025)","culture_narrative":"Employs approximately 3K people. Revenue per employee of $366K ranks in the below the sector median among Consumer Defensive peers, with revenue growing 12%/yr across its filed history. Each employee generates $10K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. CEO compensation is 4\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags moderate compensation governance risk (5/10).","financial_summary":["Mission Produce, Inc. is a small-cap consumer defensive business with a $1.0B market cap on $1.4B of annual revenue.","The top line has compounded at +10% over the past three years, a respectable pace for a business of this size.","Returns on capital run at 7% against a 8% cost of capital, which means the business is destroying value with every dollar it reinvests, and 12% gross margins are typical of commodity economics where competitors can replicate the product cheaply.","The business throws off $37M in free cash flow \u2014 roughly 3 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.35\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.4\u00d7 net debt/EBITDA, and interest coverage runs at 6.9\u00d7.","Shareholder yield is only 0.6%, a thin return of capital, and insiders hold 38% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is."],"sector_headwinds":[{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Carries a 75% premium to sector median EV/EBITDA","sev":"amber","cat":"valuation","magnitude":0.7468391939944683},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Above-average short interest at 9.9% of float","sev":"amber","cat":"sentiment"},{"text":"Gross margin trails most Consumer Defensive peers \u2014 competitors appear to have the pricing hand","sev":"amber","cat":"moat"},{"text":"Slow-motion taste and channel shifts \u2014 private label, Gen-Z health preferences, or a DTC disruption can erode decade-old brand moats without a single dramatic quarter.","sev":"amber","cat":"thesis_risk"},{"text":"Input cost inflation from agricultural commodities \u2014 when raw materials spike, pass-through pricing lags and margin compression is immediate.","sev":"amber","cat":"thesis_risk"},{"text":"GLP-1 and health-trend demand destruction \u2014 weight-loss drugs and wellness shifts are structurally reducing consumption in snack, beverage, and packaged food categories.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Market is pricing in lower growth than the company has historically delivered","Piotroski score 8/9 \u2014 financials improving across profitability, leverage and efficiency","Founder-led \u2014 owner alignment that often matters more than any incentive plan","Large open-market insider purchases (net $39.8M) \u2014 management putting its own capital behind the business","Financial quality scores above most Consumer Defensive peers","Minimal goodwill on the balance sheet \u2014 low impairment risk","Consumer Defensive sector showing strong relative momentum, outperforming the market by 10% over 3 months","Consumer Defensive ETF in a sustained uptrend above its long-term average"],"news_headlines":[{"title":"Comparing J. M. Smucker (NYSE:SJM) & Mission Produce (NASDAQ:AVO)","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/12/comparing-j-m-smucker-nysesjm-mission-produce-nasdaqavo.html","date":"2026-11-12","timestamp":1794494685.0,"origin":"tiingo","sentiment":0.924,"tier":0,"scope":"company","tags":[]},{"titl