rs.","It has paid a dividend for 23 consecutive years, raising it 26.0% a year over the last five."],"people":["With about 1,465 employees, each generates about $6.1M of revenue, 3.0x the Energy median, and productivity has risen 4.8% a year.","That works out to $1.0M of free cash flow per employee.","CEO pay is $3.8M (1x revenue per employee), and compensation governance scores well (1/10, lower is better).","Stock compensation averages $39K per employee."]},"profile":{"v":"WATCH","conv":77,"head":"Watch: Altman Z in the distress zone (1.77).","pros":["Trades 34% below fair value of $91.31","FCF margin 16.9%","Revenue grew 7.9%/yr over 5y","Net debt/EBITDA 1.5x","Piotroski F-score 7/9"],"cons":["Altman Z in the distress zone (1.77)"],"flags":[],"need":["the model rates it HOLD"],"buy_below":77.61,"vc":{"base":91.31,"base_src":"dcf","bear":70.98,"bull":119.47,"alt_median":35.95,"n_alt":2,"gap":1.5398,"dispersion":0.6157,"level":"LOW","why":["models disagree (62% dispersion)","DCF is 154% above the other models' median ($35.95)"]},"med":{"pe":13.3952,"ev_ebitda":6.86,"pfcf":14.299,"pb":1.6885,"roic":0.0952,"gross_margin":0.2462,"fcf_margin":0.0754,"div_yield":0.0371}},"ticker":"OVV","date":"2026-11-06"}