,"_score_int_coverage":null,"_gate_net_debt_ebitda":null,"_gp_net_debt_ebitda":null,"_score_net_debt_ebitda":null,"_gate_accruals":-0.01928121274058934,"_gp_accruals":true,"_score_accruals":71.4,"_gate_rev_volatility":0.04078214951819549,"_gp_rev_volatility":true,"_score_rev_volatility":100.0,"_gate_margin_vs_hist":0.025276506811570648,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":68.4,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.030391526590299645,"_gp_pool_share":true,"_score_pool_share":52.2,"_gate_rev_durability":0.07663973962299653,"_gp_rev_durability":true,"_score_rev_durability":63.3,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.03810262996340321,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":53.4,"_gate_share_shrink":-0.0117823310601054,"_gp_share_shrink":true,"_score_share_shrink":64.7,"_gate_sbc_dilution":0.014602868685371187,"_gp_sbc_dilution":true,"_score_sbc_dilution":75.7,"_gate_insider_own":0.00078,"_gp_insider_own":false,"_score_insider_own":0.5,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Marsh & McLennan Companies, Inc., a professional services company, provides advisory services and insurance solutions to clients in the areas of risk, strategy, and people worldwide. The company operates through Risk and Insurance Services, and Consulting segments. The Risk and Insurance Services segment offers risk management services, such as risk management, insurance broking, insurance program management, risk consulting, analytical modeling, and alternative risk financing services. This segment also offers insurance and reinsurance broking, strategic advisory and actuarial services, and analytics solutions. It serves businesses, public entities, insurance companies, associations, professional services organizations, and private clients. The Consulting segment provides health, wealth and career advice, solutions and products; and specialized management, strategic, economic, and brand consulting services. Marsh & McLennan Companies, Inc. was founded in 1871 and is headquartered in New York, New York.","ceo_bio":"Mr. John Quinlan Doyle | President, CEO & Director | Age 61 | Compensation: $7.5M (FY2025)","culture_narrative":"Employs approximately 95K people. Revenue per employee of $284K ranks in the bottom quartile among Financial Services peers, improving at 6%/yr \u2014 growing workforce leverage. Each employee generates $53K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 26\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags elevated compensation governance risk (8/10).","financial_summary":["Marsh is a large-cap financial services business with a $97.4B market cap on $27.0B of annual revenue.","The top line has compounded at +9% over the past three years and +8% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 16% against a 7% cost of capital, a 9-point spread that creates value, though narrow enough that competitive pressure could close it.","The business throws off $5.0B in free cash flow \u2014 roughly 19 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.27\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is moderate at 2.6\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 6.5\u00d7.","Shareholder yield of 3.8% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Carries a 45% premium to sector median EV/EBITDA (confirmed by 1 other valuation measure)","sev":"amber","cat":"valuation","magnitude":0.45189837282329415},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Insiders are net sellers (100% sell ratio, net $12.0M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Significant goodwill (41% of assets) from past acquisitions \u2014 a soft asset a conservative appraisal discounts to zero","sev":"amber","cat":"balance_sheet"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["43 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment"],"news_headlines":[{"title":"Marsh & McLennan Companies (MRSH) \u2013 Analysts\u2019 Weekly Ratings Updates","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/04/marsh-mclennan-companies-mrsh-analysts-weekly-ratings-updates.html","date":"2026-11-05","timestamp":1793838423.0,"origin":"tiingo","sentiment":0.296,"tier":0,"scope":"company","tags":[]},{"title":"Marsh (MRSH) Stock May Be 27% Undervalued Following AltamarCAM Deal","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/marsh-mrsh-stock-may-27-232354942.html","date":"2026-11-04","timestamp":1793834634.0,"origin":"tiingo","sentiment":0.898,"tier":0,"scope":"company","tags":[]},{"title":"Marsh & McLennan Officer Paul Beswick Files to Sell 713 Shares Under Rule 144","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/news/announcements/marsh-mclennan-officer-paul-beswick-files-to-sell-713-shares-under-rule-144","date":"2026-11-05","timestamp":1793895637.0,"origin":"tiingo","sentiment":0.296,"tier":1,"scope":"company","tags":[]},{"title":"Here's How Much $1000 Invested In Marsh 15 Years Ago Would Be Worth Today","source":"benzinga.com","link":"https://www.benzinga.com/news/26/11/62929624/here-s-how-much-1000-invested-marsh-15-years-ago-would-be-worth-today","date":"2026-11-05","timestamp":1793893632.0,"origin":"tiingo","sentiment":0.226,"tier":1,"scope":"company","tags":[]},{"title":"Patrick Tomlinson Completes 2,500 Stock Option Exercise Through Stock Swap at Marsh & McLennan","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/news/announcements/patrick-tomlinson-completes-2500-stock-option-exercise-through-stock-swap-at-marsh-mclennan","date":"2026-11-05","timestamp":1793858145.0,"origin":"tiingo","sentiment":0.0,"tier":1,"scope":"company","tags":[]},{"title":"Marsh Unveils BrightPath Retirement Solution With $116B