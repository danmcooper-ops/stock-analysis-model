te_rev_volatility":0.053602394284838976,"_gp_rev_volatility":true,"_score_rev_volatility":99.0,"_gate_margin_vs_hist":0.07867418387361019,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":1.7,"_gate_piotroski":4,"_gp_piotroski":false,"_score_piotroski":44.4,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.06557282212829563,"_gp_pool_share":true,"_score_pool_share":66.2,"_gate_rev_durability":0.06773236794505633,"_gp_rev_durability":true,"_score_rev_durability":58.9,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.043946185164742545,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":59.9,"_gate_share_shrink":0.03249818152313755,"_gp_share_shrink":false,"_score_share_shrink":9.4,"_gate_sbc_dilution":0.010148403069652041,"_gp_sbc_dilution":true,"_score_sbc_dilution":83.1,"_gate_insider_own":0.008590001,"_gp_insider_own":false,"_score_insider_own":5.7,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Fulton Financial Corporation operates as the bank holding company for Fulton Bank that provides banking and financial products and services in the United States. It provides various checking accounts and savings deposit products, and certificates of deposit. The company also offers consumer loans products, including home equity loans and lines of credit; construction and jumbo residential mortgage loans; automobile, student, and personal loans; account overdraft protection; commercial lending products comprising commercial real estate, commercial and industrial, and construction loans, as well as equipment lease financing loans. In addition, it offers letters of credit, cash management services, and traditional deposit products; and wealth management services, including investment management, trust, brokerage, insurance, and investment advisory services. Further, the company owns trust preferred securities; and sells various life insurance products. It provides its products and services through financial center locations, as well as through a network of automated teller machines, telephone banking, mobile banking, and online banking. The company was founded in 1882 and is headquartered in Lancaster, Pennsylvania.","ceo_bio":"Mr. Curtis J. Myers | Chairman, CEO & President | Age 56 | Compensation: $2.6M (FY2025)","culture_narrative":"Employs approximately 3K people. Revenue per employee of $386K ranks in the below the sector median among Financial Services peers. Each employee generates $84K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 7\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["Fulton Financial Corporation is a mid-cap financial services business with a $4.5B market cap on $1.3B of annual revenue.","The top line has compounded at +9% over the past three years and +7% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 11% against a 9% cost of capital, which means the business barely earns its keep economically.","The business throws off $284M in free cash flow \u2014 roughly 22 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, with adequate 0.78\u00d7 cash conversion.","On the balance sheet, leverage is comfortably conservative at 0.0\u00d7 net debt/EBITDA, and thin 0.8\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 4.4% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.3) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Trading near 52-week highs \u2014 the market has already recognised the story","sev":"amber","cat":"valuation","magnitude":0.006410256410255026},{"text":"Piotroski score 4/9 \u2014 below the median for a healthy business","sev":"amber","cat":"quality"},{"text":"Above-average short interest at 6.4% of float","sev":"amber","cat":"sentiment"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Shares offer a 21% margin of safety against estimated fair value","39 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Fulton Financial (FULT) Could Be 9% Undervalued On Rising Earnings Estimates","source":"simplywall.st","link":"https://simplywall.st/stocks/us/banks/nasdaq-ful