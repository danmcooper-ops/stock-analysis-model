ore_fcf_yield":98.4,"_gate_int_coverage":3.0181601827150066,"_gp_int_coverage":true,"_score_int_coverage":10.6,"_gate_net_debt_ebitda":3.0814076712917395,"_gp_net_debt_ebitda":false,"_score_net_debt_ebitda":20.4,"_gate_accruals":-0.06947140519313408,"_gp_accruals":true,"_score_accruals":77.4,"_gate_rev_volatility":0.4630798554507445,"_gp_rev_volatility":false,"_score_rev_volatility":0.0,"_gate_margin_vs_hist":-0.028745681167760294,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.13064282462842625,"_gp_spread":true,"_score_spread":65.3,"_gate_roic_consistency":1.1953482614860644,"_gp_roic_consistency":false,"_score_roic_consistency":0.0,"_gate_incr_roic":0.0845124589065417,"_gp_incr_roic":false,"_score_incr_roic":44.8,"_gate_margin_advantage":-0.03692097796494482,"_gp_margin_advantage":false,"_score_margin_advantage":21.0,"_gate_pool_share":-0.04113727998021599,"_gp_pool_share":false,"_score_pool_share":23.5,"_gate_rev_durability":0.15600218068108718,"_gp_rev_durability":true,"_score_rev_durability":100.0,"_gate_fcf_durability":0.4196300414407501,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":0.0006955047094581556,"_gp_margins":true,"_score_margins":50.7,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.06151210920786029,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":79.5,"_gate_share_shrink":-0.09760375956834244,"_gp_share_shrink":true,"_score_share_shrink":100.0,"_gate_sbc_dilution":0.0035226960184292456,"_gp_sbc_dilution":true,"_score_sbc_dilution":94.1,"_gate_insider_own":0.02724,"_gp_insider_own":false,"_score_insider_own":18.2,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Builders FirstSource, Inc., together with its subsidiaries, provides building materials for professional builders in new residential construction and repair, and remodeling in the United States. It offers manufactured products, such as factory-built substitutes for job-site framing, wood floor and roof trusses, wall panels, and engineered wood; Ready-Frame, a whole house framing solution; manufactured and semi-custom modular homes, and built in a temperature-controlled facility under its Pine Grove Homes and Pleasant Valley Homes brand names; manufactured housing plans including ranch, community, and single-section homes; manufacturing, assembly, and distribution of windows; and the assembly and distribution of interior and exterior door units. The company also provides millwork, including interior trim and custom features under the Synboard brand name; specialty building products and services comprising vinyl, composite and wood siding, exterior trim, metal studs, cement, roofing, insulation, wallboard, ceilings, cabinets, and hardware; turn-key framing, shell construction, design assistance, and professional installation of products. In addition, it offers drafting, estimating, quoting, and virtual home design services to retailers, distributors, manufacturers, and homebuilders; dimensional lumber, plywood, and oriented strand board products used in on-site house framing. The company was formerly known as BSL Holdings, Inc. and changed its name to Builders FirstSource, Inc. in October 1999. Builders FirstSource, Inc. was incorporated in 1998 and is based in Irving, Texas.","ceo_bio":"Mr. Peter M. Jackson CPA | President, CEO & Director | Age 53 | Compensation: $1.6M (FY2025)","culture_narrative":"Employs approximately 28K people. Revenue per employee of $543K ranks in the top quartile among Industrials peers, improving at 24%/yr \u2014 growing workforce leverage. Each employee generates $30K of free cash flow annually. Stock-based compensation of $2K per employee reflects an ownership culture. CEO compensation is 3\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["Builders FirstSource, Inc. is a mid-cap industrials business with a $6.7B market cap on $15.2B of annual revenue.","The top line has compounded at -13% over the past three years and +16% annually across the full decade, and a shrinking top line is the hardest headwind any business can overcome.","Returns on capital run at 22% against a 8% cost of capital \u2014 a 13-point spread that is the clearest signature of an economic moat, with gross margins sitting at 25%.","The business throws off $853M in free cash flow \u2014 roughly 6 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.79\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is moderate at 3.1\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 3.0\u00d7.","Management returns a meaningful 6.2% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insiders hold 2.7% of the shares, and profit capture is only 0.5\u00d7 the fair share, suggesting no structural edge inside its industry."],"sector_headwinds":[{"text":"Price sits 233% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":2.3275355340515835},{"text":"Revenue growth in the bottom decile of Industrials peers \u2014 losing share inside the profit pool","sev":"red","cat":"growth"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Elevated short interest (11.0% of float) \u2014 sophisticated money is betting the other way","sev":"amber","cat":"sentiment"},{"text":"Significant goodwill (37% of assets) from past acquisitions \u2014 a soft asset a conservative appraisal discounts to zero","sev":"amber","cat":"balance_sheet"},{"text":"Industrials sector lagging the market significantly, underperforming by 8% over 3 months","sev":"amber","cat":"sector"},{"text":"Tariff and trade-policy exposure \u2014 industrial exporters sit squarely in the crosshairs of protectionist policy, and retaliatory tariffs can close markets without warning.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Trading near the bottom of its 52-week range \u2014 the market is offering a discount"],"news_headlines":[{"title":"Valtinson Bruner Financial Planning LLC Acquires New Holdings in Builders FirstSource, Inc. $BLDR","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/06/valtinson-bruner-financial-planning-llc-acquires-new-holdings-in-builders-firstsource-inc-bldr.html","date":"2026-11-06","timestamp":1793967783.0,"origin":"tiingo","sentiment":0.872,"tier":0,"scope":"company","tags":["m_and_a"]},{"title":"88,503 Shares of Builders FirstSource, Inc. $BLDR Bought by Monte Financial Group LLC","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/06/88503-shares-of-builders-firstsource-inc-bldr-bought-by-monte-financial-group-llc.html","date":"2026-11-06","timestamp":1793963361.0,"origin":"tiingo","sentiment":0.896,"tier":0,"scope":"company","tags":[]},{"title":"What Sparked Builders FirstSource (NYSE:BLDR) Shares To Jump Recently?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/stocks/midcap/what-sparked-builders-firstsource-nysebldr-shares-to-jump-recently","date":"2026-11-03","timestamp":1793746020.0,"or