t_coverage":36.7,"_gate_net_debt_ebitda":1.0588780100555704,"_gp_net_debt_ebitda":true,"_score_net_debt_ebitda":65.4,"_gate_accruals":-0.12876989778157535,"_gp_accruals":true,"_score_accruals":80.3,"_gate_rev_volatility":0.484063145860302,"_gp_rev_volatility":false,"_score_rev_volatility":0.0,"_gate_margin_vs_hist":0.1350713405677097,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":0.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.0794082215567196,"_gp_spread":true,"_score_spread":39.7,"_gate_roic_consistency":17.19235442338502,"_gp_roic_consistency":false,"_score_roic_consistency":0.0,"_gate_incr_roic":1.0,"_gp_incr_roic":true,"_score_incr_roic":100.0,"_gate_margin_advantage":0.07460774700605052,"_gp_margin_advantage":true,"_score_margin_advantage":58.2,"_gate_pool_share":null,"_gp_pool_share":null,"_score_pool_share":null,"_gate_rev_durability":0.027179812451397334,"_gp_rev_durability":true,"_score_rev_durability":38.6,"_gate_fcf_durability":0.5858094339991258,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.04725812335775446,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":63.6,"_gate_share_shrink":0.10979168480094637,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.005759832441238073,"_gp_sbc_dilution":true,"_score_sbc_dilution":90.4,"_gate_insider_own":0.00748,"_gp_insider_own":false,"_score_insider_own":5.0,"_gate_insider_buying":0.167,"_gp_insider_buying":false,"_score_insider_buying":16.7,"pf":[],"description_full":"Devon Energy Corporation, an independent energy company, engages in the exploration, development, and production of oil, natural gas, and natural gas liquids in the United States. The company operates in Delaware Basin located in southeast New Mexico and west Texas, Eagle Ford located in North America, Anadarko Basin located in western Oklahoma, Williston Basin located in North Dakota, and Powder River Basin located in Wyoming. Devon Energy Corporation was founded in 1971 and is headquartered in Houston, Texas.","ceo_bio":"Mr. Clay M. Gaspar | President, CEO & Director | Age 53 | Compensation: $2.9M (FY2025)","culture_narrative":"Employs approximately 2K people. Revenue per employee of $7.8M ranks in the top quartile among Energy peers. Each employee generates $1.4M of free cash flow annually. Stock-based compensation of $45K per employee reflects an ownership culture. CEO compensation is 0\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["Devon Energy Corporation is a large-cap energy business with a $53.1B market cap on $17.2B of annual revenue.","The top line has compounded at -4% over the past three years and +3% annually across the full decade, and a shrinking top line is the hardest headwind any business can overcome. Operating margins are expanding by +5.0pp year-over-year, which is one of the strongest signals that the moat is deepening.","Returns on capital run at 16% against a 8% cost of capital, a 8-point spread that creates value, though narrow enough that competitive pressure could close it.","The business throws off $3.1B in free cash flow \u2014 roughly 18 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.54\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.1\u00d7 net debt/EBITDA, and interest coverage runs at 8.0\u00d7.","Shareholder yield of 4.7% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 2.1\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Insiders are net sellers (83% sell ratio, net $58.1M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"The commodity cycle \u2014 revenue and free cash flow are ultimately hostage to a price the company does not set, and the long-run energy-transition arc adds a structural overhang.","sev":"amber","cat":"thesis_risk"},{"text":"ESG-driven capital flight and stranded asset risk \u2014 tightening climate policy and investor mandates raise the cost of capital and risk leaving reserves permanently in the ground.","sev":"amber","cat":"thesis_risk"},{"text":"Geopolitical supply shocks \u2014 wars, sanctions, and OPEC decisions create volatility that no hedging programme can fully neutralise.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["32 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk","Energy sector outperforming the broader market over the past quarter","Energy ETF in a sustained uptrend above its long-term average"],"news_headlines":[{"title":"Devon Energy (DVN) \u2013 Research Analysts\u2019 Weekly Ratings Changes","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/devon-energy-dvn-research-analysts-weekly-ratings-changes.html","date":"2026-11-13","timestamp":1794594477.0,"origin":"tiingo","sentiment":0.772,"tier":0,"scope":"company","tags":[]},{"title":"Devon Energy Corporation $DVN Shares Sold by M Holdings Securities Inc.","source":"thelincolnianon