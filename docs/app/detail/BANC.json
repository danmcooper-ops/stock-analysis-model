_margin_vs_hist":0.14547507806179372,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":0.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.6565324869909943,"_gp_pool_share":true,"_score_pool_share":100.0,"_gate_rev_durability":0.15145313637208235,"_gp_rev_durability":true,"_score_rev_durability":100.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.02683982705605218,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":40.9,"_gate_share_shrink":0.4156964664818321,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.0087,"_gp_insider_own":false,"_score_insider_own":5.8,"_gate_insider_buying":0.167,"_gp_insider_buying":false,"_score_insider_buying":16.7,"pf":[],"description_full":"Banc of California, Inc. operates as the bank holding company for Banc of California that provides banking and treasury management services in the United States. The company offers deposit products, including checking, savings, money market, demand, and retirement accounts, as well as time deposits, certificates of deposit, and safe deposit boxes. It also provides real estate loans, such as commercial real estate mortgage, multi-family, other residential real estate mortgage, and real estate construction and land loans; commercial loans and leases comprising lender finance, equipment finance, other asset-based, venture capital, secured business, warehouse, and other lending loans; and consumer loans. In addition, the company offers electronic payment services for commercial clients, such as merchant acquiring and card issuing services; automated bill payments, cash and treasury management, master demand accounts, foreign exchange, interest rate swaps, card payment services, remote and mobile deposit capture, automated clearing house origination, wire transfer, and direct deposit; and investment management services. It serves small and middle-market businesses, venture capital and private equity firms, non-profit organizations, business owners, entrepreneurs, professionals, and high-net worth individuals. The company offers its products and services through branches located throughout California; Denver, Colorado; and Durham, North Carolina, as well as through regional offices in the United States. Banc of California, Inc. was founded in 1941 and is headquartered in Los Angeles, California.","ceo_bio":"Mr. Jared M. Wolff J.D. | Chairman of the Board,President & CEO | Age 55 | Compensation: $2.6M (FY2025)","culture_narrative":"Employs approximately 1K people. Revenue per employee of $955K ranks in the above the sector median among Financial Services peers, with revenue growing 33%/yr across its filed history. Each employee generates $123K of free cash flow annually. CEO compensation is 3\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags elevated compensation governance risk (7/10).","financial_summary":["Banc of California, Inc. is a mid-cap financial services business with a $2.8B market cap on $1.8B of annual revenue.","The top line has compounded at +76% over the past three years and +15% annually across the full decade, the kind of sustained demand persistence that marks a compounder.","Returns on capital run at 4% against a 10% cost of capital, which means the business is destroying value with every dollar it reinvests.","The business throws off $235M in free cash flow \u2014 roughly 13 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.12\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is heavy at 5.7\u00d7 net debt/EBITDA, and leverage like that is what turns a bad year into a permanent loss, and thin 0.4\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 2.7% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.1) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Operating margins 12% below sector median \u2014 a cost disadvantage the moat cannot hide","sev":"amber","cat":"moat"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Priced near or above estimated fair value, so the margin of safety has been bid away","sev":"amber","cat":"valuation","magnitude":0.10645146343031948},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Above-average short interest at 7.1% of float","sev":"amber","cat":"sentiment"},{"text":"Insiders are net sellers (83% sell ratio) over the past year","sev":"amber","cat":"insider","ratio":0.167},{"text":"Carries more leverage than most Financial Services peers \u2014 a smaller cushion for the inevitable bad year","sev":"amber","cat":"balance_sheet"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds"