:-0.07302397682033562,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":3,"_gp_piotroski":false,"_score_piotroski":33.3,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":-0.0037401373251482184,"_gp_pool_share":false,"_score_pool_share":38.5,"_gate_rev_durability":0.1070064906911965,"_gp_rev_durability":true,"_score_rev_durability":78.5,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.04349260126523808,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":59.4,"_gate_share_shrink":-0.0017178789931920901,"_gp_share_shrink":true,"_score_share_shrink":52.1,"_gate_sbc_dilution":0.010477889728519452,"_gp_sbc_dilution":true,"_score_sbc_dilution":82.5,"_gate_insider_own":0.01682,"_gp_insider_own":false,"_score_insider_own":11.2,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Independent Bank Corp. operates as the bank holding company for Rockland Trust Company that provides commercial banking products and services to individuals and small-to-medium sized businesses in the United States. It provides interest checking, money market, and savings accounts, as well as demand deposits and time certificates of deposit. The company also offers commercial real estate and construction, commercial and industrial, small business, secured and unsecured commercial, and consumer real estate loans; term loans and revolving/nonrevolving lines of credit; overdraft protection and letters of credit; and residential mortgages and home equity loans and lines. In addition, it provides cash management services, such as ACH transaction processing, positive pay, and remote deposit services; investment management and trust services to individuals, institutions, small businesses, and charitable institutions; interchange fees; ATM fees; mobile, online, and telephone banking; estate settlement, financial planning, tax services, and other services; debit and credit cards; and mutual fund and unit investment trust shares, third party model portfolios, general securities, fixed and variable annuities, and life insurance products, as well as advisory platforms. Further, the company invests in low-income housing tax credit projects; holds, maintains, and disposes foreclosed properties; and operates as an investment advisor. The company was founded in 1907 and is headquartered in Rockland, Massachusetts.","ceo_bio":"Mr. Jeffrey J. Tengel | President, CEO & Director | Age 62 | Compensation: $2.5M (FY2025)","culture_narrative":"Employs approximately 2K people. Revenue per employee of $374K ranks in the below the sector median among Financial Services peers, with revenue growing 10%/yr across its filed history. Each employee generates $104K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 7\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["Independent Bank Corp. is a mid-cap financial services business with a $3.8B market cap on $858M of annual revenue.","The top line has compounded at +6% over the past three years and +11% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 6% against a 9% cost of capital, which means the business is destroying value with every dollar it reinvests.","The business throws off $239M in free cash flow \u2014 roughly 28 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.22\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.2\u00d7 net debt/EBITDA, and thin 0.9\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 4.3% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome."],"sector_headwinds":[{"text":"Piotroski score 3/9 \u2014 the fundamentals are deteriorating on multiple fronts","sev":"red","cat":"quality"},{"text":"Altman Z in the distress zone (0.2) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Above-average short interest at 5.3% of float","sev":"amber","cat":"sentiment"},{"text":"Financial quality metrics lag Financial Services peers","sev":"amber","cat":"quality"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Shares offer a 23% margin of safety against estimated fair value","32 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Is Independent Bank (INDB) Fully Priced After A 59% Run?","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/independent-bank-indb-fully-priced-042122572.html","date":"2026-11-27","timestamp":1795753282.0,"origin":"tiingo","sentiment":0.89,"tier":0,"scope":"company","tags":[]},{"title":"Trading Systems Reacting to (INDB) Volatility","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/43/Trading_Systems_Reacting_to_INDB_Volatility_112126105201_1795319521.html","date":"2026-11-22","timestamp":1795319521.0,"origin":"tiingo","sentiment":0.0,"tier":0,"scope":"company","tags":[]},{"title":"Edgestream Partners L.P. Acquires New Position in Independent Bank Corp. $INDB","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/17/edgestream-partners-l-p-acquires-new-position-in-independent-bank-corp-indb.html","date":"2026-11-17","timestamp":1794932333.0,"origin":"tiingo","sentiment":0.896,"tier":0,"scope":"company","tags":["m_and_a"]},{"title":"Independent Bank (NASDAQ:INDB) Stock: Insider Thomas Venables Sells 1,000 Shares","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/15/independent-bank-nasdaqindb-stock-insider-thomas-venables-sells-1000-shares.html","date":"2026-11-15","timestamp":1794777425.0,"origin":"tiingo","sentiment":0.883,"tier":0,"scope":"company","tags":[]},{"title":"Precision Trading with Independent Bank Corp. (INDB) Risk Zones","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/141/Precision_Trading_with_Independent_Bank_Corp._INDB_Risk_Zones_111226120202_1794459722.html","date":"2026-11-12","timestamp":1794459722.0,"origin":"tiingo","sentiment":-0.494,"tier":0,"scope":"company","tags":[]},{"title":"Independent Bank reports Q3 results","source":"seekingalpha.com","link":"https://seekingalpha.