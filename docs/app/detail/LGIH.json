in_vs_hist":100.0,"_gate_piotroski":2,"_gp_piotroski":false,"_score_piotroski":22.2,"_gate_spread":-0.013533794748999052,"_gp_spread":false,"_score_spread":0.0,"_gate_roic_consistency":0.4812227975972625,"_gp_roic_consistency":false,"_score_roic_consistency":19.8,"_gate_incr_roic":0.011962221279302167,"_gp_incr_roic":false,"_score_incr_roic":20.7,"_gate_margin_advantage":-0.02763155970042125,"_gp_margin_advantage":false,"_score_margin_advantage":24.1,"_gate_pool_share":-0.36381296029859267,"_gp_pool_share":false,"_score_pool_share":0.0,"_gate_rev_durability":0.10467608856710986,"_gp_rev_durability":true,"_score_rev_durability":77.3,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":0.0,"_gate_margins":-0.016026460544463505,"_gp_margins":false,"_score_margins":34.0,"_gate_fund_growth":0,"_gp_fund_growth":false,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.020848574273911766,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":34.3,"_gate_share_shrink":-0.005469816076323908,"_gp_share_shrink":true,"_score_share_shrink":56.8,"_gate_sbc_dilution":0.0035186079891926375,"_gp_sbc_dilution":true,"_score_sbc_dilution":94.1,"_gate_insider_own":0.12587,"_gp_insider_own":true,"_score_insider_own":83.9,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"LGI Homes, Inc. engages in the design, construction, and sale of new homes in the United States. It markets and sells attached and detached entry-level homes and active adult offerings under the LGI Homes brand; and luxury homes under the Terrata Homes brand. The company also engages in the wholesale business, which includes building and selling homes to large institutions interested in acquiring single-family rental properties through bulk sales agreements. It operates in Texas, Arizona, Florida, Georgia, New Mexico, Colorado, North Carolina, South Carolina, Washington, Tennessee, Minnesota, Oklahoma, Alabama, California, Oregon, Nevada, West Virginia, Virginia, Pennsylvania, Maryland, and Utah. LGI Homes, Inc. was founded in 2003 and is headquartered in The Woodlands, Texas.","ceo_bio":"Mr. Eric Thomas Lipar | Chairman & CEO | Age 54 | Compensation: $1.0M (FY2025)","culture_narrative":"Employs approximately 1K people. Revenue per employee of $1.6M ranks in the top quartile among Consumer Cyclical peers, with revenue growing 22%/yr across its filed history. Stock-based compensation of $6K per employee reflects an ownership culture. CEO compensation is 1\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (3/10).","financial_summary":["LGI Homes, Inc. is a small-cap consumer cyclical business with a $961M market cap on $1.7B of annual revenue.","The top line has compounded at -10% over the past three years and +10% annually across the full decade, and a shrinking top line is the hardest headwind any business can overcome.","Returns on capital run at 6% against a 7% cost of capital, which means the business is destroying value with every dollar it reinvests.","The company is burning through $141M of cash, and without positive owner earnings any valuation rests on hope rather than evidence.","On the balance sheet, debt is heavy at 19.7\u00d7 net debt/EBITDA, and leverage like that is what turns a bad year into a permanent loss.","Shareholder yield of 2.1% reflects a genuine commitment to returning capital rather than empire-building, and insiders hold 13% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is."],"sector_headwinds":[{"text":"Price sits 34% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":0.34212016247593074},{"text":"Piotroski score 2/9 \u2014 the fundamentals are deteriorating on multiple fronts","sev":"red","cat":"quality"},{"text":"Altman Z in the distress zone (1.6) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Very elevated short interest (20.9% of float) \u2014 sophisticated money is betting against the business","sev":"red","cat":"sentiment"},{"text":"Revenue growth in the bottom decile of Consumer Cyclical peers \u2014 losing share inside the profit pool","sev":"red","cat":"growth"},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Value-trap profile (score 64/100): leveraged balance sheet under pressure; roic below cost of capital \u2014 cheapness may reflect deterioration, not mispricing","sev":"amber","cat":"value_trap"},{"text":"Brand relevance decay \u2014 shifting consumer preferences and social-media-driven trends can strand inventory and invalidate positioning faster than product cycles can adapt.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Minimal goodwill on the balance sheet \u2014 low impairment risk","Consumer Cyclical sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"(LGIH) Risk Channels and Responsive Allocation","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/9/LGIH_Risk_Channels_and_Responsive_Allocation_111226083802_1794490682.html","date":"2026-11-12","timestamp":1794490682.0,"origin":"tiingo","sentiment":0.202,"tier":0,"scope":"company","tags":[]},{"title":"LGI Homes (NASDAQ:LGIH) Shares Down 4.2% \u2013 Here\u2019s Why","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/11/lgi-homes-nasdaqlgih-shares-down-4-2-heres-why.html","date":"2026-11