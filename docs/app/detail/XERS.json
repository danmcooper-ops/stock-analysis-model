":null,"_gp_fcf_durability":null,"_score_fcf_durability":0.0,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.0,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":11.1,"_gate_share_shrink":0.07892379187109855,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.07663657078243588,"_gp_sbc_dilution":false,"_score_sbc_dilution":0.0,"_gate_insider_own":0.02997,"_gp_insider_own":false,"_score_insider_own":20.0,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Xeris Biopharma Holdings, Inc., a commercial-stage biopharmaceutical company, engages in developing and commercializing therapies for chronic endocrine and neurological diseases in Illinois. It offers Gvoke, a ready-to-use liquid-stable glucagon for the treatment of severe hypoglycemia in pediatric and adult patients; Keveyis, a therapy for the treatment of hyperkalemic, hypokalemic, and related variants of primary periodic paralysis; and Recorlev, a cortisol synthesis inhibitor for the treatment of endogenous hypercortisolemia in adult patients with Cushing's syndrome. It is also developing XP-8121, a once-weekly subcutaneous injection of levothyroxine that is in phase 3 clinical trial for the treatment of hypothyroidism. The company was incorporated in 2005 and is headquartered in Chicago, Illinois.","ceo_bio":"Mr. John P. Shannon | Chairman & CEO | Age 63 | Compensation: $1.4M (FY2025)","culture_narrative":"Employs approximately 435 people. Revenue per employee of $671K ranks in the top quartile among Healthcare peers, with revenue growing 56%/yr across its filed history. Stock-based compensation of $51K per employee reflects an ownership culture. CEO compensation is 2\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags elevated compensation governance risk (8/10).","financial_summary":