ore_pool_share":0.0,"_gate_rev_durability":0.44554719067391946,"_gp_rev_durability":true,"_score_rev_durability":100.0,"_gate_fcf_durability":0.2695369024705403,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":-0.07826393192904138,"_gp_margins":false,"_score_margins":0.0,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.053874777364453744,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":71.0,"_gate_share_shrink":1.3255558376945586e-05,"_gp_share_shrink":false,"_score_share_shrink":50.0,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.49568,"_gp_insider_own":true,"_score_insider_own":100.0,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Cheniere Energy Partners, L.P., through its subsidiaries, provides liquefied natural gas (LNG) to integrated energy companies, utilities, and energy trading companies in the United States and internationally. The company owns and operates natural gas liquefaction and export facility at the Sabine Pass LNG Terminal located in Cameron Parish, Louisiana. It also owns Creole Trail Pipeline, a natural gas supply pipeline that interconnects the Sabine Pass LNG terminal with various interstate and intrastate pipelines. Cheniere Energy Partners, L.P. was founded in 2003 and is headquartered in Houston, Texas. Cheniere Energy Partners, L.P. is a subsidiary of Cheniere Energy, Inc.","ceo_bio":"Mr. Jack A. Fusco | Chairman, President & CEO of Cheniere Energy Partners GP LLC | Age 63","financial_summary":["Cheniere Energy Partners, LP is a large-cap energy business with a $29.9B market cap on $10.8B of annual revenue.","The top line has compounded at -14% over the past three years and +45% annually across the full decade, and a shrinking top line is the hardest headwind any business can overcome.","The business throws off $2.6B in free cash flow \u2014 roughly 24 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, with adequate 0.93\u00d7 cash conversion.","On the balance sheet, debt is moderate at 3.3\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 4.9\u00d7.","Management returns a meaningful 5.4% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insiders hold 50% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is, and within its sector the business captures 3.2\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Operating margins softening -1.2pp YoY \u2014 early warning on the moat","sev":"amber","cat":"trend"},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Revenue growth lags most Energy peers \u2014 losing share inside the profit pool","sev":"amber","cat":"growth"},{"text":"The commodity cycle \u2014 revenue and free cash flow are ultimately hostage to a price the company does not set, and the long-run energy-transition arc adds a structural overhang.","sev":"amber","cat":"thesis_risk"},{"text":"ESG-driven capital flight and stranded asset risk \u2014 tightening climate policy and investor mandates raise the cost of capital and risk leaving reserves permanently in the ground.","sev":"amber","cat":"thesis_risk"},{"text":"Geopolitical supply shocks \u2014 wars, sanctions, and OPEC decisions create volatility that no hedging programme can fully neutralise.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Operating margins 19% above sector median \u2014 the quantitative trace of pricing power","Market is pricing in lower growth than the company has historically delivered","18 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Energy sector outperforming the broader market over the past quarter","Energy ETF in a sustained uptrend above its long-term average"],"news_headlines":[{"title":"Why the data center slowdown concern is overblown. Two stocks to buy amid the fear","source":"cnbc.com","link":"https://www.cnbc.com/2026/11/13/data-center-slowdown-utility-stocks.html","date":"2026-11-13","timestamp":1794585280.0,"origin":"tiingo","sentiment":-0.153,"tier":2,"scope":"company","tags":["m_and_a"]},{"title":"Chevron Eyes Biodiesel Growth With Iowa Facility Restart","source":"finance.yahoo.com","link":"https://finance.yahoo.com/energy/articles/chevron-eyes-biodiesel-growth-iowa-151900022.html","date":"2026-11-13","timestamp":1794583140.0,"origin":"tiingo","sentiment":0.796,"tier":2,"scope":"company","tags":[]},{"title":"Cheniere Energy, Inc. $LNG Shares Purchased by Russell Investments Group Ltd.","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/cheniere-energy-inc-lng-shares-purchased-by-russell-investments-group-ltd.html","date":"2026-11-13","timestamp":1794568685.0,"origin":"tiingo","sentiment":0.963,"tier":2,"scope":"company","tags":[]},{"title":"4,700 Shares of Cheniere Energy, Inc. $LNG Bought by Knights of Columbus Asset Advisors LLC","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/4700-shares-of-cheniere-energy-inc-lng-bought-by-knights-of-columbus-asset-advisors-llc.html","date":"2026-11-13","timestamp":1794565528.0,"origin":"tiingo","sentiment":0.964,"tier":2,"scope":"company","tags":[]},{"title":"Zacks Investment Ideas feature highlights: American Healthcare REIT, RenaissanceRe and Cheniere Energy","source":"zacks.com","link":"https://www.zacks.com/stock/news/3029175/zacks-investment-ideas-feature-highlights-american-healthcare-reit-renaissancere-and-cheniere-energy?cid=CS-ZC-FT-press_releases-3029175","date":"2026-11-13","timestamp":1794552780.0,"origin":"tiingo","se