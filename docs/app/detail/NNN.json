re_spread":14.0,"_gate_roic_consistency":0.07746427913208367,"_gp_roic_consistency":true,"_score_roic_consistency":87.1,"_gate_incr_roic":0.10776402719883199,"_gp_incr_roic":true,"_score_incr_roic":52.6,"_gate_margin_advantage":0.4089909373906253,"_gp_margin_advantage":true,"_score_margin_advantage":100.0,"_gate_pool_share":-0.030277692606486495,"_gp_pool_share":false,"_score_pool_share":27.9,"_gate_rev_durability":0.06729409746809267,"_gp_rev_durability":true,"_score_rev_durability":58.6,"_gate_fcf_durability":0.08183812875201402,"_gp_fcf_durability":true,"_score_fcf_durability":65.9,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.04486107518204867,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":61.0,"_gate_share_shrink":0.02003293045724841,"_gp_share_shrink":false,"_score_share_shrink":25.0,"_gate_sbc_dilution":0.015333406030794212,"_gp_sbc_dilution":true,"_score_sbc_dilution":74.4,"_gate_insider_own":0.00856,"_gp_insider_own":false,"_score_insider_own":5.7,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"NNN REIT, Inc. is a REIT that invests in high-quality properties subjected generally to long-term, net leases with minimal ongoing capital expenditures. As of June 30, 2026, the Company owned 3,774 properties across 50 states, the District of Columbia and Puerto Rico, encompassing approximately 40.4 million square feet of gross leasable area, with a weighted average remaining lease term of 10.1 years. NNN REIT, Inc. was incorporated in August 1984 in Maryland and is based in Orlando, Florida.","ceo_bio":"Mr. Stephen A. Horn Jr. | President, CEO & Director | Age 53 | Compensation: $3.1M (FY2025)","culture_narrative":"Employs approximately 85 people. Revenue per employee of $10.9M ranks in the top quartile among Real Estate peers, improving at 10%/yr \u2014 growing workforce leverage. Stock-based compensation of $167K per employee reflects an ownership culture. CEO compensation is 0\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["NNN REIT, Inc. is a mid-cap real estate business with a $8.0B market cap on $926M of annual revenue.","The top line has compounded at +6% over the past three years and +7% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 10% against a 8% cost of capital, which means the business barely earns its keep economically.","On the balance sheet, leverage is comfortably conservative at 0.2\u00d7 net debt/EBITDA, and thin 2.9\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 4.5% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 3.2\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Altman Z in the distress zone (1.1) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Payout ratio looks stretched \u2014 the dividend\u2019s own margin of safety is thin","sev":"red","cat":"dividend"},{"text":"Piotroski score 4/9 \u2014 below the median for a healthy business","sev":"amber","cat":"quality"},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Interest-rate sensitivity and tenant-credit risk \u2014 cap rates and refinancing costs move faster than the 10-year leases can absorb.","sev":"amber","cat":"thesis_risk"},{"text":"Remote work structural vacancy \u2014 the post-pandemic shift to hybrid work has permanently impaired demand for urban office space across most markets.","sev":"amber","cat":"thesis_risk"},{"text":"Climate and insurance cost escalation \u2014 rising premiums and coverage withdrawals in flood/fire zones are repricing assets that the market once treated as perpetuities.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Operating margins 41% above sector median \u2014 the quantitative trace of pricing power","Trading near the bottom of its 52-week range \u2014 the market is offering a discount","Returns on capital have been remarkably steady for 5 years \u2014 durability is the real test of a moat","35 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Real Estate sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"NNN REIT (NYSE:NNN) Posts Earnings Results, Beats Expectations By $0.05 EPS","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/06/nnn-reit-nysennn-posts-earnings-results-beats-expectations-by-0-05-eps.html","date":"2026-11-06","timestamp":1793997648.0,"origin":"tiingo","sentiment":0.557,"tier":0,"scope":"company","tags":["earnings"]},{"title":"(NNN) Volatility Zones as Tactical Triggers","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/22/NNN_Volatility_Zones_as_Tactical_Triggers_110626123401_1793986441.html","date":"2026-11-06","timestamp":1793986441.0,"origin":"tiingo","sentiment":0.0,"tier":0,"scope":"company","tags":[]},{"title":"NNN REIT (NYSE:NNN) Coverage Initiated by Analysts at Huntington","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/05/nnn-reit-nysennn-coverage-initiated-by-analysts-at-huntington.html","date":"2026-11-05","timestamp":1793879299.0,"origin":"tiingo","sentiment":0.7,"tier":0,"scope":"company","tags":["analyst_action"]},{"title":"Can NNN REIT (NYSE:NNN) Sustain Its Retail Property Growth? - Kalkine Media","source":"kalki