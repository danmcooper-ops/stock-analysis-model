n averages $6K per employee."]},"profile":{"v":"INSUFFICIENT DATA","conv":null,"head":"Not enough data to value it: missing price or fair value.","pros":[],"cons":[],"flags":[],"need":[],"buy_below":null,"vc":null,"med":{"pe":18.5188,"ev_ebitda":10.2635,"pfcf":15.9681,"pb":2.0792,"roic":0.1185,"gross_margin":0.3401,"fcf_margin":0.0601,"div_yield":0.0296}},"ticker":"UTZ","date":"2026-11-06"}