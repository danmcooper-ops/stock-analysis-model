int_coverage":true,"_score_int_coverage":15.3,"_gate_net_debt_ebitda":2.305398871877518,"_gp_net_debt_ebitda":false,"_score_net_debt_ebitda":37.7,"_gate_accruals":-0.013019399553065388,"_gp_accruals":true,"_score_accruals":24.1,"_gate_rev_volatility":0.11240993660849133,"_gp_rev_volatility":true,"_score_rev_volatility":82.2,"_gate_margin_vs_hist":-0.007565292097039329,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.017038050711015745,"_gp_spread":false,"_score_spread":8.5,"_gate_roic_consistency":0.19677292933340468,"_gp_roic_consistency":true,"_score_roic_consistency":67.2,"_gate_incr_roic":0.08849481678150142,"_gp_incr_roic":false,"_score_incr_roic":46.2,"_gate_margin_advantage":-0.18422603887773184,"_gp_margin_advantage":false,"_score_margin_advantage":0.0,"_gate_pool_share":-0.0030712520998414927,"_gp_pool_share":false,"_score_pool_share":38.8,"_gate_rev_durability":0.14086133713112226,"_gp_rev_durability":true,"_score_rev_durability":95.4,"_gate_fcf_durability":-0.05273953848802293,"_gp_fcf_durability":false,"_score_fcf_durability":0.0,"_gate_margins":-0.0090572856359817,"_gp_margins":false,"_score_margins":40.9,"_gate_fund_growth":0.009577449936197592,"_gp_fund_growth":false,"_score_fund_growth":9.6,"_gate_shrhldr_yield":0.024786528745647796,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":38.7,"_gate_share_shrink":-0.028297189461868877,"_gp_share_shrink":true,"_score_share_shrink":85.4,"_gate_sbc_dilution":0.002959309494451295,"_gp_sbc_dilution":true,"_score_sbc_dilution":95.1,"_gate_insider_own":0.00511,"_gp_insider_own":false,"_score_insider_own":3.4,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"CBRE Group, Inc. operates as a commercial real estate services and investment company in the United States, the United Kingdom, and internationally. The company operates through Advisory Services, Building Operations and Experience, Project Management, and Real Estate Investments segments. The Advisory Services segment offers strategic advice and execution to owners, investors, and occupiers of real estate in connection with leasing of offices, and industrial and retail space; clients fully integrated property sales services under the CBRE Capital Markets brand; clients commercial mortgage and structured financing services; originates and sells commercial mortgage loans; property management services, such as marketing, building engineering, lease administration, accounting, investment reporting services, financial services on a contractual basis for owners of and investors in office, industrial, and retail properties; and valuation services that include market value appraisals, litigation support, discounted cash flow analyses, and feasibility studies, as well as consulting services, such as property condition reports, hotel advisory, and environmental consulting. The Global Workplace Solutions segment provides facilities management, and project management services comprising building consulting, program, and project and cost management services under the Turner & Townsend brand name. The Real Estate Investments segment offers investment management services under the CBRE Investment Management brand to pension funds, insurance companies, sovereign wealth funds, foundations, endowments, and other institutional investors and development services, such as real estate development and investment activities under the Trammell Crow Company brand to users and investors in commercial real estate, and for their own account. CBRE Group, Inc. was founded in 1906 and is headquartered in Dallas, Texas.","ceo_bio":"Mr. Robert E. Sulentic | CEO & Chairman of Board | Age 69 | Compensation: $5.3M (FY2025)","culture_narrative":"Employs approximately 155K people. Revenue per employee of $262K ranks in the bottom quartile among Real Estate peers, improving at 15%/yr \u2014 growing workforce leverage. Each employee generates $8K of free cash flow annually. Stock-based compensation of $774 per employee reflects an ownership culture. CEO compensation is 20\u00d7 revenue per employee (reasonable relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["CBRE Group Inc is a large-cap real estate business with a $39.1B market cap on $40.5B of annual revenue.","The top line has compounded at +10% over the past three years and +14% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 11% against a 9% cost of capital, which means the business barely earns its keep economically.","The business throws off $1.2B in free cash flow \u2014 roughly 3 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.35\u00d7 so those profits are backed by real cash.","On the balance sheet, debt is moderate at 2.3\u00d7 net debt/EBITDA, serviceable in normal conditions but worth watching through a downturn, and interest coverage runs at 3.9\u00d7.","Shareholder yield of 2.5% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and profit capture is only 0.2\u00d7 the fair share, suggesting no structural edge inside its industry."],"sector_headwinds":[{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Operating margins 18% below sector median \u2014 a cost disadvantage the moat cannot hide","sev":"amber","cat":"moat"},{"text":"Fragmented industry with below-average profit capture \u2014 no moat to protect margins","sev":"amber","cat":"moat"},{"text":"Carries a 37% premium to sector median EV/EBITDA (confirmed by 1 other valuation measure)","sev":"amber","cat":"valuation","magnitude":0.3695385370643105},{"text":"Insiders are overwhelmingly selling (100% sell ratio) \u2014 the people who know the business want less of it","sev":"amber","cat":"insider","ratio":0.0},{"text":"Above-average market volatility (VIX 26)","sev":"amber","cat":"macro"},{"text":"Late-cycle dynamics increase the probability of a slowdown","sev":"amber","cat":"macro"},{"text":"Interest-rate sensitivity and tenant-credit risk \u2014 cap rates and refinancing costs move faster than the 10-year leases can absorb.","sev":"amber","cat":"thesis_risk"},{"text":"Remote work structural vacancy \u2014 the post-pandemic shift to hybrid work has permanently impaired demand for urban office space across most markets.","sev":"amber","cat":"thesis_risk"},{"text":"Climate and insurance cost escalation \u2014 rising premiums and coverage withdrawals in flood/fire zones are repricing assets that the market once treated as perpetuities.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Real Estate sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"CBRE Group, Inc. $CBRE Shares Newly Purchased by Mirae Asset Global Investments Co. Ltd.","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/05/cbre-group-inc-cbre-shares-newly-purchased-by-mirae-asset-global-investments-co-ltd.html","date":"2026-11-05","timestamp":1793872782.0,"origin":"tiingo","sentiment":0.941,"tier":0,"scope":"company","tags":[]},{"title":"How Strong Quarterly Earnings Will Impact CBRE Stock Investors","source":"simplywall.st","link":"https://simplywall.st/stocks/us/real-estate-management-and-development/nyse-cbre/cbre-group/news/how-strong-quarterly-earnings-will-impact-cbre-stock-investo","date":"2026-11-05","timestamp":1793861517.57,"origin":"tiingo","sentiment":0.813,"tier":0,"scope":"company","tags":["earnings"]},{"title":"CBRE Group (CBRE) Could Be 23% Undervalued Following Strong Third Quarter Earnings","source":"simplywall.st","link":"https://sim