ll,"_gate_mult_vs_hist":1.399901552623973,"_gp_mult_vs_hist":false,"_score_mult_vs_hist":0.0,"_gate_fcf_yield":0.0635237983543845,"_gp_fcf_yield":true,"_score_fcf_yield":38.2,"_gate_int_coverage":7.333333333333333,"_gp_int_coverage":true,"_score_int_coverage":33.3,"_gate_net_debt_ebitda":1.399197592778335,"_gp_net_debt_ebitda":true,"_score_net_debt_ebitda":57.8,"_gate_accruals":-0.0350213745478461,"_gp_accruals":true,"_score_accruals":32.1,"_gate_rev_volatility":0.1312627246010426,"_gp_rev_volatility":false,"_score_rev_volatility":76.8,"_gate_margin_vs_hist":-0.00018516471099561116,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":100.0,"_gate_piotroski":5,"_gp_piotroski":false,"_score_piotroski":55.6,"_gate_spread":0.13288018879932517,"_gp_spread":true,"_score_spread":66.4,"_gate_roic_consistency":0.4246526999034298,"_gp_roic_consistency":false,"_score_roic_consistency":29.2,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":0.21795162839796584,"_gp_margin_advantage":true,"_score_margin_advantage":100.0,"_gate_pool_share":-0.0472297599326813,"_gp_pool_share":false,"_score_pool_share":21.1,"_gate_rev_durability":0.042468879362037804,"_gp_rev_durability":true,"_score_rev_durability":46.2,"_gate_fcf_durability":0.08186562085299132,"_gp_fcf_durability":true,"_score_fcf_durability":65.9,"_gate_margins":0.0024429216089315864,"_gp_margins":true,"_score_margins":52.4,"_gate_fund_growth":0.20935211097617087,"_gp_fund_growth":true,"_score_fund_growth":100.0,"_gate_shrhldr_yield":0.040266976566546306,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":55.9,"_gate_share_shrink":-0.05924857043676224,"_gp_share_shrink":true,"_score_share_shrink":100.0,"_gate_sbc_dilution":0.008970099667774087,"_gp_sbc_dilution":true,"_score_sbc_dilution":85.0,"_gate_insider_own":0.00737,"_gp_insider_own":false,"_score_insider_own":4.9,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Allison Transmission Holdings, Inc., together with its subsidiaries, designs, manufactures, and sells fully automatic transmissions for medium- and heavy-duty commercial vehicles and medium- and heavy-tactical U.S. defense vehicles, and electrified propulsion systems worldwide. It offers transmissions for various applications, including distribution, refuse, construction, fire, and emergency on-highway trucks; school and transit buses; motor homes; energy, mining, and construction of off-highway vehicles and equipment; and wheeled and tracked defense vehicles. The company also provides its transmissions and electric propulsion solutions under the Allison Transmission brand name; and remanufactured transmissions under the ReTran brand name. In addition, it sells branded replacement parts, support equipment, aluminum die cast components, and other products necessary to service the installed base of vehicles utilizing its solutions, as well as defense kits, engineering services, and extended transmission coverage services to various original equipment manufacturers, distributors, and the U.S. government. The company was formerly known as Clutch Holdings, Inc. Allison Transmission Holdings, Inc. was founded in 1915 and is headquartered in Indianapolis, Indiana.","ceo_bio":"Mr. David S. Graziosi CPA | Chairman, President & CEO | Age 59 | Compensation: $2.2M (FY2025)","culture_narrative":"Employs approximately 4K people. Revenue per employee of $752K ranks in the top quartile among Consumer Cyclical peers. Each employee generates $165K of free cash flow annually. Stock-based compensation of $7K per employee reflects an ownership culture. CEO compensation is 3\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (3/10).","financial_summary":["Allison Transmission Holdings,  is a large-cap consumer cyclical business with a $10.4B market cap on $3.0B of annual revenue.","The top line has compounded at +3% over the past three years and +4% annually across the full decade, which puts it in mature, slow-growth territory.","Returns on capital run at 21% against a 8% cost of capital \u2014 a 13-point spread that is the clearest signature of an economic moat, with gross margins sitting at 48%.","The business throws off $661M in free cash flow \u2014 roughly 22 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.34\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.4\u00d7 net debt/EBITDA, and interest coverage runs at 7.3\u00d7.","Shareholder yield of 4.0% reflects a genuine commitment to returning capital rather than empire-building, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 3.7\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Altman Z in the grey zone \u2014 financial health warrants monitoring","sev":"amber","cat":"quality"},{"text":"Insiders are net sellers (100% sell ratio, net $4.5M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"Consumer demand is fundamentally cyclical \u2014 a recession compresses both unit volume and pricing power, and operating leverage cuts both ways.","sev":"amber","cat":"thesis_risk"},{"text":"E-commerce margin compression and tariff exposure \u2014 digital competition erodes pricing power while trade policy reshuffles supply-chain cost structures overnight.","sev":"amber","cat":"thesis_risk"},{"text":"Brand relevance decay \u2014 shifting consumer preferences and social-media-driven trends can strand inventory and invalidate positioning faster than product cycles can adapt.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Reinvestment rate supports 21% organic growth capacity \u2014 capital is compounding inside the business","Operating margins 22% above sector median \u2014 the quantitative trace of pricing power","Trading at a 39% margin of safety to estimated fair value \u2014 a real cushion against errors in the estimate","Market is pricing in lower growth than the company has historically delivered","13 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Consumer Cyclical sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"Allison Transmission Holdings (ALSN) Raises Guidance As Undervalued Case Stays In Focus","source":"simplywall.st","link":"https://simplywall.st/stocks/us/capital-goods/nyse-alsn/allison-transmission-holdings/news/allison-transmission-holdings-alsn-raises-guidance-as-underv","date":"2026-11-12","timestamp":1794475714.883,"origin":"tiingo","sentiment":0.951,"tier":0,"scope":"company","tags":["guidance"]},{"title":"Allison Transmission Holdings declares $0.29 dividend (NYSE:ALSN)","source":"seekingalpha.com","link":"https://seekingalpha.com/news/4671079-allison-transmission-holdings-declares-0_29-dividend","date":"2026-11-12","timestamp":1794453470.0,"origin":"tiingo","sentiment":0.296,"tier":0,"scope":"company","tags":["dividend"]},{"title":"Allison Transmission (ALSN) Just Overtook the 200-Day Moving Average","source":"finance.yahoo.com","link":"https://finance.yahoo.com/markets/stocks/articles/allison-transmission-alsn-just-overtook-133002158.html","date":"2026-11-10","timestamp":1794317402.0,"origin":"tiingo","sentiment":-0.153,"tier":0,"scope":"company","tags":[]},{"title":"Learn Why The Bull Case For Allison Transmission Holdings Stock Could Change Following Raised Full Year Guidance","source":"simplywall.st","