t_ebitda":false,"_score_net_debt_ebitda":0.0,"_gate_accruals":-0.02761883234431795,"_gp_accruals":true,"_score_accruals":37.2,"_gate_rev_volatility":0.08590396577601092,"_gp_rev_volatility":true,"_score_rev_volatility":89.7,"_gate_margin_vs_hist":0.008430535173246934,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":89.5,"_gate_piotroski":4,"_gp_piotroski":false,"_score_piotroski":44.4,"_gate_spread":-0.01161516837295256,"_gp_spread":false,"_score_spread":0.0,"_gate_roic_consistency":0.2676779013136741,"_gp_roic_consistency":true,"_score_roic_consistency":55.4,"_gate_incr_roic":0.04469042809741664,"_gp_incr_roic":false,"_score_incr_roic":31.6,"_gate_margin_advantage":0.010188113890783446,"_gp_margin_advantage":false,"_score_margin_advantage":36.7,"_gate_pool_share":-0.02020302662435669,"_gp_pool_share":false,"_score_pool_share":31.9,"_gate_rev_durability":0.10128407102529335,"_gp_rev_durability":true,"_score_rev_durability":75.6,"_gate_fcf_durability":0.18662664366861637,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":null,"_gp_margins":null,"_score_margins":0.0,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":-0.021927085602489207,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":0.0,"_gate_share_shrink":0.09869170275418693,"_gp_share_shrink":false,"_score_share_shrink":0.0,"_gate_sbc_dilution":0.008049063815436117,"_gp_sbc_dilution":true,"_score_sbc_dilution":86.6,"_gate_insider_own":0.15234,"_gp_insider_own":true,"_score_insider_own":100.0,"_gate_insider_buying":0.8,"_gp_insider_buying":true,"_score_insider_buying":80.0,"pf":[],"description_full":"H2O America, through its subsidiaries, provides water utility and other related services in the United States. The company engages in production, purchase, storage, purification, distribution, wholesale, and retail sale of water and wastewater services; and supplies groundwater from wells, surface water from watershed run-off and diversion, reclaimed water, and imported water purchased from Valley Water District. It also offers non-tariffed services, including water system operations, maintenance agreements, and antenna site leases; contracted services, sewer operations, and other water related services; and a Linebacker protection plan for public drinking water customers in Connecticut and Maine. In addition, the company provides water services; owns undeveloped land in California; and commercial properties and parcels of land in Connecticut. The company was formerly known as SJW Group and changed its name to H2O America in May 2025. H2O America was incorporated in 1985 and is headquartered in San Jose, California.","ceo_bio":"Mr. Andrew F. Walters | CEO & Chairman | Age 54 | Compensation: $1.2M (FY2025)","culture_narrative":"Employs approximately 837 people. Revenue per employee of $956K ranks in the below the sector median among Utilities peers, with revenue growing 9%/yr across its filed history. Stock-based compensation of $8K per employee reflects an ownership culture. CEO compensation is 1\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (2/10).","financial_summary":["H2O America is a mid-cap utilities business with a $2.9B market cap on $801M of annual revenue.","The top line has compounded at +9% over the past three years and +10% annually across the full decade, a respectable pace for a business of this size.","Returns on capital run at 5% against a 6% cost of capital, which means the business is destroying value with every dollar it reinvests.","On the balance sheet, debt is heavy at 6.3\u00d7 net debt/EBITDA, and leverage like that is what turns a bad year into a permanent loss, and thin 2.4\u00d7 interest coverage leaves no room for a bad year.","Net dilution runs at 2.2% annually, transferring value from owners to stock-based comp, and insiders hold 15% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is."],"sector_headwinds":[{"text":"Price sits 40% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away","sev":"red","cat":"valuation","magnitude":0.40211859342187445},{"text":"Altman Z in the distress zone (0.9) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Piotroski score 4/9 \u2014 below the median for a healthy business","sev":"amber","cat":"quality"},{"text":"Above-average short interest at 7.5% of float","sev":"amber","cat":"sentiment"},{"text":"Regulatory rate-case risk and rising cost of capital \u2014 the allowed return is set by commissions, and the business lives or dies by that negotiation.","sev":"amber","cat":"thesis_risk"},{"text":"Grid modernisation capex burden \u2014 aging infrastructure requires massive reinvestment that regulators may not fully allow into rate base, compressing earned returns.","sev":"amber","cat":"thesis_risk"},{"text":"Wildfire and climate liability \u2014 extreme weather events create catastrophic, uninsurable losses that can push even investment-grade utilities toward restructuring.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Large open-market insider purchases (net $6.2M) \u2014 management putting its own capital behind the business","46 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible"],"news_headlines":[{"title":"Financial Survey: H2O America (HTO) vs. Its Competitors","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/financial-survey-h2o-america-hto-vs-its-competitors.html","date":"2026-11-13","timestamp":1794590212.0,"origin":"tiingo","sentiment":0.754,"tier":0,"scope":"company","tags":[]},{"title":"H2O America (HTO), What Is Behind The Fresh Attention?","source":"simplywall.st","link":"https://simplywall.st/stocks/us/utilities/nasdaq-hto/h2o-america/news/h