ore_incr_roic":100.0,"_gate_margin_advantage":0.5891647932057076,"_gp_margin_advantage":true,"_score_margin_advantage":100.0,"_gate_pool_share":0.1360074696745759,"_gp_pool_share":true,"_score_pool_share":94.4,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":0.20003986106995164,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":0.044156735982845495,"_gp_margins":true,"_score_margins":94.2,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":0.0,"_gate_shrhldr_yield":0.004980301840897419,"_gp_shrhldr_yield":false,"_score_shrhldr_yield":16.6,"_gate_share_shrink":0.002624085326193182,"_gp_share_shrink":false,"_score_share_shrink":46.7,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.0010899999,"_gp_insider_own":false,"_score_insider_own":0.7,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Wheaton Precious Metals Corp. operates as a precious metal streaming company. It explores for gold, silver, palladium, platinum, and cobalt deposits in Canada, the United States, Mexico, Portugal, Sweden, the United Kingdom, Argentina, Chile, Brazil, Peru, Ecuador, Colombia, C\u00f4te d'Ivoire, Ethiopia, and South Africa. The company was formerly known as Silver Wheaton Corp. and changed its name to Wheaton Precious Metals Corp. in May 2017. Wheaton Precious Metals Corp. was founded in 2004 and is headquartered in Vancouver, Canada.","ceo_bio":"Mr. Haytham Henry Hodaly | President, CEO & Director | Compensation: $1.5M (FY2025)","culture_narrative":"Governance score flags elevated compensation governance risk (8/10).","financial_summary":["Wheaton Precious Metals Corp is a large-cap basic materials business with a $59.5B market cap on $2.3B of annual revenue.","The top line has compounded at +30% over the past three years, the kind of sustained demand persistence that marks a compounder.","Returns on capital run at 8% against a 9% cost of capital, which means the business is destroying value with every dollar it reinvests. Gross margins of 53% confirm genuine pricing power.","On the balance sheet, the balance sheet carries net cash, which is the gold standard: the business never has to make desperate decisions in a bad year.","Shareholder yield is only 0.5%, a thin return of capital, and insider ownership is negligible, so management has little personal stake in the long-term outcome, and within its sector the business captures 5.2\u00d7 its fair share of profits, a structural advantage visible in the numbers."],"sector_headwinds":[{"text":"Price sits 558% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":5.5785160820989015},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Weakness in commodity prices pressures materials companies","sev":"amber","cat":"sector"},{"text":"Commodity price volatility and cost-curve position \u2014 in a downturn only the lowest-cost producer has a business, and the rest carry the overhead.","sev":"amber","cat":"thesis_risk"},{"text":"Environmental remediation liability \u2014 tightening regulations on emissions, tailings, and water use create open-ended balance-sheet risk that grows with each legislative cycle.","sev":"amber","cat":"thesis_risk"},{"text":"Trade policy and tariff whiplash \u2014 materials producers are first-order casualties of protectionist swings, and margin gets squeezed from both input and output pricing.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Operating margins 59% above sector median \u2014 the quantitative trace of pricing power","Altman Z comfortably in the safe zone \u2014 a fortress balance sheet on this measure","15 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Healthy payout ratio leaves room for both dividend growth and reinvestment","Gross margin tops the Basic Materials peer set \u2014 genuine pricing power is present here","Growing faster than most Basic Materials peers \u2014 taking share inside the profit pool","Basic Materials sector outperforming the broader market over the past quarter"],"news_headlines":[{"title":"(WPM) Investment Analysis","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/canada/wpm-investment-analysis_20261127_828e8e","date":"2026-11-28","timestamp":1795827095.0,"origin":"tiingo","sentiment":0.361,"tier":0,"scope":"company","tags":[]},{"title":"How Is Streaming Delivering Record Results for Wheaton Precious Metals (NYSE:WPM)?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/stocks/gold/how-is-streaming-delivering-record-results-for-wheaton-precious-metals-nysewpm","date":"2026-11-27","timestamp":1795777740.0,"origin":"tiingo","sentiment":0.813,"tier":0,"scope":"company","tags":["earnings"]},{"title":"How Did New Streams Shape Record Results at Wheaton (NYSE:WPM)?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/stocks/gold/how-did-new-streams-shape-record-results-at-wheaton-nysewpm","date":"2026-11-26","timestamp":1795694880.0,"origin":"tiingo","sentiment":0.572,"tier":0,"scope":"company","tags":["earnings"]},{"title":"(WPM) Market Performance Analysis","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/canada/wpm-market-performance-analysis_20261124_972795","date":"2026-11-25","timestamp":1795574102.0,"origin":"tiingo","sentiment":0.572,"tier":0,"scope":"company","tags":[]},{"title":"(WPM) and the Role of Price-Sensitive Allocations","source":"news.stocktradersdaily.com","link":"https://news.stocktradersdaily.com/news_release/9/WPM_and_the_Role_of_Price-Sensitive_Allocations_112426075201_1795524721.html","date":"2026-11-2