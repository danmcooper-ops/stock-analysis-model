bt_ebitda":true,"_score_net_debt_ebitda":61.5,"_gate_accruals":-0.06678764984012937,"_gp_accruals":true,"_score_accruals":43.8,"_gate_rev_volatility":0.28176905483353376,"_gp_rev_volatility":false,"_score_rev_volatility":33.8,"_gate_margin_vs_hist":0.02182301754577154,"_gp_margin_vs_hist":true,"_score_margin_vs_hist":72.7,"_gate_piotroski":4,"_gp_piotroski":false,"_score_piotroski":44.4,"_gate_spread":0.01984139051076056,"_gp_spread":false,"_score_spread":9.9,"_gate_roic_consistency":0.7609683588660646,"_gp_roic_consistency":false,"_score_roic_consistency":0.0,"_gate_incr_roic":0.01860097430588871,"_gp_incr_roic":false,"_score_incr_roic":22.9,"_gate_margin_advantage":-0.04507880699828219,"_gp_margin_advantage":false,"_score_margin_advantage":18.3,"_gate_pool_share":null,"_gp_pool_share":null,"_score_pool_share":null,"_gate_rev_durability":0.03160998858426933,"_gp_rev_durability":true,"_score_rev_durability":40.8,"_gate_fcf_durability":0.5856967942224804,"_gp_fcf_durability":true,"_score_fcf_durability":100.0,"_gate_margins":-0.004204080258798326,"_gp_margins":false,"_score_margins":45.8,"_gate_fund_growth":0.00020337974832033756,"_gp_fund_growth":false,"_score_fund_growth":0.2,"_gate_shrhldr_yield":0.05787053969787245,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":75.4,"_gate_share_shrink":0.003884835072630155,"_gp_share_shrink":false,"_score_share_shrink":45.1,"_gate_sbc_dilution":null,"_gp_sbc_dilution":null,"_score_sbc_dilution":0.0,"_gate_insider_own":0.04818,"_gp_insider_own":false,"_score_insider_own":32.1,"_gate_insider_buying":0.0,"_gp_insider_buying":false,"_score_insider_buying":0.0,"pf":[],"description_full":"Chevron Corporation, through its subsidiaries, engages in the integrated energy and chemicals operations. It operates through Upstream and Downstream segments. The Upstream segment engages in the exploration for, development, production, and transportation of crude oil and natural gas; processing, liquefaction, transportation, and regasification of liquefied natural gas; transportation of crude oil through pipelines; transportation, storage, and marketing of natural gas; carbon capture and storage; and operation of a gas-to-liquids plant. The Downstream segment refines crude oil into petroleum products; markets crude oil, refined products, and lubricants; manufactures and markets renewable fuels; transports crude oil and refined products through pipeline, marine vessel, motor equipment, and rail car; and manufactures and markets commodity petrochemicals, plastics for industrial uses, and fuel and lubricant additives. The company operates in North America, South America, Europe, Africa, Asia, and Australia. The company was formerly known as ChevronTexaco Corporation and changed its name to Chevron Corporation in May 2005. Chevron Corporation was founded in 1879 and is headquartered in Houston, Texas.","ceo_bio":"Mr. Michael K. Wirth | Chairman & CEO | Age 64 | Compensation: $7.8M (FY2025)","culture_narrative":"Employs approximately 43K people. Revenue per employee of $4.4M ranks in the above the sector median among Energy peers. Each employee generates $386K of free cash flow annually. CEO compensation is 2\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags low compensation governance risk (1/10).","financial_summary":["Chevron Corporation is a mega-cap energy business with a $429.1B market cap on $189.0B of annual revenue.","The top line has compounded at -8% over the past three years and +3% annually across the full decade, and a shrinking top line is the hardest headwind any business can overcome.","Returns on capital run at 10% against a 8% cost of capital, which means the business barely earns its keep economically.","The business throws off $16.6B in free cash flow \u2014 roughly 9 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 2.76\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 1.2\u00d7 net debt/EBITDA, and interest coverage of 17\u00d7 is fortress-like.","Management returns a meaningful 5.8% of market cap to owners through dividends and buybacks, a strong signal of disciplined capital allocation, and insiders hold 4.8% of the shares."],"sector_headwinds":[{"text":"Price sits 53% above estimated fair value \u2014 no margin of safety left, and the cushion against estimate error has been bid away (confirmed by 1 other valuation measure)","sev":"red","cat":"valuation","magnitude":0.5285094675869272},{"text":"Low reinvestment-driven growth suggests the compounding engine has stalled","sev":"amber","cat":"growth"},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Piotroski score 4/9 \u2014 below the median for a healthy business","sev":"amber","cat":"quality"},{"text":"Insiders are net sellers (100% sell ratio, net $268.8M) \u2014 the people closest to the business are reducing their personal stake","sev":"amber","cat":"insider"},{"text":"The commodity cycle \u2014 revenue and free cash flow are ultimately hostage to a price the company does not set, and the long-run energy-transition arc adds a structural overhang.","sev":"amber","cat":"thesis_risk"},{"text":"ESG-driven capital flight and stranded asset risk \u2014 tightening climate policy and investor mandates raise the cost of capital and risk leaving reserves permanently in the ground.","sev":"amber","cat":"thesis_risk"},{"text":"Geopolitical supply shocks \u2014 wars, sanctions, and OPEC decisions create volatility that no hedging programme can fully neutralise.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["42 consecutive years of dividend payments \u2014 an operating record that makes the dividend claim credible","Minimal goodwill on the balance sheet \u2014 low impairment risk","Energy sector outperforming the broader market over the past quarter","Energy ETF in a sustained uptrend above its long-term average"],"news_headlines":[{"title":"How Are Record Refinery Runs and Venezuela Expansion Shaping Growth at CVX (NYSE:CVX)?","source":"kalkinemedia.com","link":"https://kalkinemedia.com/us/stocks/oil-gas/how-are-record-refinery-runs-and-venezuela-expansion-shaping-growth-at-cvx-nysecvx","date":"2026-11-13","timestamp":1794576180.0,"origin":"tiingo","sentiment":0.778,"tier":0,"scope":"company","tags":[]},{"title":"Chevron (NYSE:CVX) Vice Chairman Mark Nelson Sells 112,000 Shares of Company Stock","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/13/chevron-nysecvx-vice-chairman-mark-nelson-sells-112000-shares-of-company-stock.html","date":"2026-11-13","timestamp":1794567293.0,"origin":"tiingo","sentiment":0.937,"tier":0,"scope":"company","tags":[]},{"title":"What's Going on with Chevron Shares on Friday?","source":"benzinga.com","link":"https://www.benzinga.com/markets/large-cap/26/11/63257331/whats-going-on-with-chevron-shares-on-friday","date":"2026-11-13","timestamp":1794592418.0,"origin":"tiingo","sentiment":0.296,"tier":1,"scope":"company","tags":[]},{"title":"Chevron Bets $7B on Venezuela While Exxon Mobil Plays It Safe: One Has a Distinct Edge Now","source":"finance.yahoo.com","link":"https://finance.yahoo.com/energy/articles/chevron-bets-7b-venezuela-while-174515548.html","date":"2026-11-13","timestamp":1794591915.0,"origin":"tiingo","sentiment":0.802,"tier":1,"scope":"company","tags":[]},{"title":"Chevron Eyes Biodiesel Growth With Iowa Facility Restart","source":"zacks.com","link":"https://www.zacks.com/stock/news/3029654/chevron-eyes-biodiesel-growth-with-iowa-facility-restart?cid=CS-ZC-FT-analyst_blog%7Ccompany_news_energy_sector-3029654","date":"2026-11-13","timestamp":1794583140.0,"origin":"tiingo","sentiment":0.382,"tier":1,"scope":"company","tags":[]},{"title":"5 High-Yield Dividend Stocks That Could Beat a 5% Treasury Yield","source":"ao