lity":false,"_score_rev_volatility":60.4,"_gate_margin_vs_hist":0.10219757925641748,"_gp_margin_vs_hist":false,"_score_margin_vs_hist":0.0,"_gate_piotroski":6,"_gp_piotroski":false,"_score_piotroski":66.7,"_gate_spread":null,"_gp_spread":null,"_score_spread":null,"_gate_roic_consistency":null,"_gp_roic_consistency":null,"_score_roic_consistency":null,"_gate_incr_roic":null,"_gp_incr_roic":null,"_score_incr_roic":null,"_gate_margin_advantage":null,"_gp_margin_advantage":null,"_score_margin_advantage":null,"_gate_pool_share":0.04062823590196696,"_gp_pool_share":true,"_score_pool_share":56.3,"_gate_rev_durability":null,"_gp_rev_durability":null,"_score_rev_durability":0.0,"_gate_fcf_durability":null,"_gp_fcf_durability":null,"_score_fcf_durability":null,"_gate_margins":null,"_gp_margins":null,"_score_margins":null,"_gate_fund_growth":null,"_gp_fund_growth":null,"_score_fund_growth":null,"_gate_shrhldr_yield":0.027633683648718186,"_gp_shrhldr_yield":true,"_score_shrhldr_yield":41.8,"_gate_share_shrink":0.031806930968486524,"_gp_share_shrink":false,"_score_share_shrink":10.2,"_gate_sbc_dilution":0.006558473604998797,"_gp_sbc_dilution":true,"_score_sbc_dilution":89.1,"_gate_insider_own":0.32555,"_gp_insider_own":true,"_score_insider_own":100.0,"_gate_insider_buying":null,"_gp_insider_buying":null,"_score_insider_buying":null,"pf":[],"description_full":"Capital Bancorp, Inc. operates as the bank holding company for Capital Bank, N.A., provides various banking products and services to businesses, not-for-profit associations, and entrepreneurs in the United States. It operates through four divisions: Commercial Banking, Capital Bank Home Loans, OpenSky, Windsor Advantage. The company offers a range of deposit products, including checking and savings, time, interest bearing and noninterest-bearing demand, and money market accounts, as well as certificates of deposit; and secured, partially secured, and unsecured credit cards. It also originates residential mortgages; issues trust preferred securities; and provides residential and commercial real estate, construction, and commercial and industrial loans; servicing, processing, and packaging of Small Business Administration and U.S. Department of Agriculture loans; as well as other consumer loans, such as term loans, car loans, and boat loans to small to medium-sized businesses, professionals, real estate investors, small residential builders and individuals, and financial institution clients, including Capital Bank. Capital Bancorp, Inc. was founded in 1974 and is headquartered in Rockville, Maryland.","ceo_bio":"Mr. Edward F. Barry | President, CEO & Director | Age 55 | Compensation: $1.0M (FY2025)","culture_narrative":"Employs approximately 434 people. Revenue per employee of $565K ranks in the above the sector median among Financial Services peers, with revenue growing 19%/yr across its filed history. Each employee generates $155K of free cash flow annually. Stock-based compensation of $4K per employee reflects an ownership culture. CEO compensation is 2\u00d7 revenue per employee (modest relative to workforce productivity). Governance score flags moderate compensation governance risk (6/10).","financial_summary":["Capital Bancorp, Inc. is a small-cap financial services business with a $689M market cap on $245M of annual revenue.","The top line has compounded at +13% over the past three years, the kind of sustained demand persistence that marks a compounder.","Returns on capital run at 15% against a 8% cost of capital, a 7-point spread that creates value, though narrow enough that competitive pressure could close it.","The business throws off $67M in free cash flow \u2014 roughly 27 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.22\u00d7 so those profits are backed by real cash.","On the balance sheet, leverage is comfortably conservative at 0.0\u00d7 net debt/EBITDA, and thin 1.1\u00d7 interest coverage leaves no room for a bad year.","Shareholder yield of 2.8% reflects a genuine commitment to returning capital rather than empire-building, and insiders hold 33% of the shares, so management thinks like owners because it is one \u2014 the strongest alignment there is."],"sector_headwinds":[{"text":"Altman Z in the distress zone (0.4) \u2014 the kind of balance-sheet risk that can make a loss permanent","sev":"red","cat":"quality"},{"text":"Trading near 52-week highs \u2014 the market has already recognised the story","sev":"amber","cat":"valuation","magnitude":0.04139433551198219},{"text":"Volatile returns on capital suggest the moat is narrower than a snapshot ROIC implies","sev":"amber","cat":"moat"},{"text":"Credit cycles and regulatory capital \u2014 losses accumulate invisibly in good years and appear all at once, and the time to worry is when underwriting standards are loosest.","sev":"amber","cat":"thesis_risk"},{"text":"Fintech disintermediation \u2014 neobanks, embedded finance, and blockchain rails are unbundling the fee streams that traditional banks took for granted.","sev":"amber","cat":"thesis_risk"},{"text":"Interest rate regime shifts \u2014 a rapid move in rates can invert the yield curve, crush bond portfolios, and trigger deposit flight simultaneously.","sev":"amber","cat":"thesis_risk"}],"sector_tailwinds":["Trading at a 59% margin of safety to estimated fair value \u2014 a real cushion against errors in the estimate","Market is pricing in lower growth than the company has historically delivered","Healthy payout ratio leaves room for both dividend growth and reinvestment","Minimal goodwill on the balance sheet \u2014 low impairment risk"],"news_headlines":[{"title":"Head-To-Head Survey: Capital Bancorp (CBNK) vs. The Competition","source":"thelincolnianonline.com","link":"https://www.thelincolnianonline.com/2026/11/10/head-to-head-survey-capital-bancorp-cbnk-vs-the-competition.html","date":"2026-11-10","timestamp":1794335331.0,"origin":"tii