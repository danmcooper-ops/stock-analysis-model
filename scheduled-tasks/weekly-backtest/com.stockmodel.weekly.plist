<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly backtest on a Mac (../MAC-MINI-SETUP.md section 6). Install:
    cp scheduled-tasks/weekly-backtest/com.stockmodel.weekly.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.stockmodel.weekly.plist
  Runs the repo's mac_run.sh in place (no copy to edit separately). The path
  assumes the checkout at ~/Projects/Workspace Folder; edit both strings if
  it lives elsewhere. Only load it after pausing the cloud weekly Routine.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockmodel.weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dmcooper/Projects/Workspace Folder/scheduled-tasks/weekly-backtest/mac_run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>20</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dmcooper/Library/Logs/StockModel/launchd_weekly.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/dmcooper/Library/Logs/StockModel/launchd_weekly.err</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
