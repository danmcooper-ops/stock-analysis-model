  h1+='<th class="fixed-header sortable" rowspan="2" style="cursor:pointer" onclick="mSort(\'sector\')" data-col-tip="sector" data-col-label="Sector">Sector'+(mSC==='sector'?(mSA?' \u25B2':' \u25BC'):'')+'</th>';
  GM.categories.forEach(function(c){var n=cg2[c.name].length*2+1;h1+='<th class="cat-header" colspan="'+n+'" style="background:'+c.dark+'">'+c.name+' Gate ('+Math.round(c.weight*100)+'%)</th>';});
  h1+='</tr>';
