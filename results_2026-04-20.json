entication; processing and gateway solutions; and other solutions. The company offers payment solutions and services under the MasterCard, Maestro, and Cirrus names. Mastercard Incorporated was founded in 1966 and is headquartered in Purchase, New York.", "ceo_bio": "Mr. Michael  Miebach | CEO, President & Director | Age 57 | Compensation: $6.0M (FY2024)", "founder_led": false, "fcf": 16433000000.0, "fcf_margin": 0.5011436064773871, "sbc_pct_rev": 0.01820621512000244, "mcap": 461077970944, "roic_by_year": {"2025": 0.9722416892840265, "2024": 0.8469841755074557, "2023": 0.8563985669184354, "2022": 0.8088288868277276}, "roic_cv": 0.08091541136741329, "gross_margin": 0.7632069758284294, "er": 0.09357261480927764, "re_method": "capm (directional)", "beta_raw": 0.9299378854674094, "beta_adjusted": 0.9532919236449395, "beta_r2": 0.4439118174989738, "beta_se": 0.029415433723337363, "beta_n_obs": 1254, "beta_r2_class": "directional", "dcf_sens_range": [372.3680695650471, 674.2643983739274], "fcf_growth": 0.12, "pfcf": 28.058052147751475, "pb": 59.700718, "num_analysts": 35, "target_mean": 654.65717, "target_high": 735.0, "target_low": 550.0, "cash_conv": 1.179048637092464, "accruals": -0.0494857543807818, "rev_cagr": 0.1382198495222513, "rev_cagr_5y": 0.16468094243124232, "rev_cagr_10y": 0.16066034301355825, "int_cov": 27.02770083102493, "nd_ebitda": 0.40828774749479596, "de": 5.998578260307613, "cr": 1.0349705649767156, "roe": 1.9345999741501874, "roa": 0.2763816311834112, "shares_out": 885216386, "float_shares": 883991117, "insider_pct": 0.0054699997, "inst_pct": 0.90433, "shares_short": 6235735, "short_ratio": 1.83, "short_pct_float": 0.0069999998, "share_turnover_rate": 0.004301620553146878, "share_buyback_rate": 0.02543387613160182, "shareholder_yield": 0.03141117319126709, "div_yield": 0.006735701151650054, "payout_ratio": 0.184, "insider_buy_ratio": 0.0, "insider_buy_count_90d": 0, "insider_sell_count_90d": 23, "insider_buy_count_365d": 0, "insider_sell_count_365d": 