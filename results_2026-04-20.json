  if(d.edgar_fields_flagged>0){var _fl=(d.edgar_discrepancies||[]).filter(function(x){return x.flagged==='True'||x.flagged===true;});var _fNames={'revenue':'Revenue','net_income':'Net Income','total_assets':'Total Assets','total_equity':'Equity','total_debt':'Debt'};gh+='<div class="dq-warning">\u26A0 Data quality: '+d.edgar_fields_flagged+' field(s) differ &gt;5% between yfinance and SEC EDGAR XBRL filings';if(_fl.length>0){gh+='<div style="margin-top:4px;font-size:0.92em">';_fl.forEach(function(x){var nm=_fNames[x.field]||x.field;var pct=(x.pct_diff*100).toFixed(1);var yv=fds(x.yfinance);var ev=fds(x.edgar);gh+='<div style="padding:2px 0;border-bottom:1px solid rgba(0,0,0,0.06)"><b>'+esc(nm)+'</b>: yfinance '+yv+' vs EDGAR '+ev+' <span style="color:#c0392b;font-weight:600">('+pct+'% diff)</span></div>';});gh+='</div>';}gh+='</div>';}
  gh+='</div>';/* close dgroup */
