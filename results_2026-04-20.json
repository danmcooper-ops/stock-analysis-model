function renderCrossSectorDashboard(){
  var secs=Object.keys(SECTOR_POOL).sort();
  if(!secs.length)return'';
  var allStats=[];
  secs.forEach(function(s){
    var pool=SECTOR_POOL[s];var st=pool.stats||{};
    if(st.weighted_margin==null&&st.hhi==null)return;
    allStats.push({name:s,margin:st.weighted_margin||0,hhi:st.hhi||0,cr4:st.cr4||0,n:st.company_count||0,topPlayer:(pool.key_players||[])[0]||null});
  });
  if(!allStats.length)return'';
  var byMargin=allStats.slice().sort(function(a,b){return b.margin-a.margin;});
  var byHHI=allStats.slice().sort(function(a,b){return b.hhi-a.hhi;});
  var maxM=byMargin[0].margin,minM=byMargin[byMargin.length-1].margin;
  var mostConc=byHHI[0],leastConc=byHHI[byHHI.length-1];
  var largest=allStats.slice().sort(function(a,b){return b.n-a.n;})[0];

  function kpiChip(label,val,sub,col){
    return'<div class="xsect-kpi" style="border-top:3px solid '+(col||'#3498db')+'">'
      +'<div class="xsect-kpi-val">'+val+'</div>'
      +'<div class="xsect-kpi-label">'+label+'</div>'
      +(sub?'<div class="xsect-kpi-sub">'+sub+'</div>':'')
      +'</div>';
  }
  var kpiHtml=kpiChip('Sectors Analyzed',allStats.length,'','#546e7a')
    +kpiChip('Margin Range',(minM*100).toFixed(0)+'% \u2013 '+(maxM*100).toFixed(0)+'%','Blended pool margins','#1a9850')
    +kpiChip('Most Concentrated',mostConc.name,'HHI\u00a0'+mostConc.hhi.toFixed(3),'#8e24aa')
    +kpiChip('Most Fragmented',leastConc.name,'HHI\u00a0'+leastConc.hhi.toFixed(3)+'\u00a0\u00b7\u00a0'+leastConc.n+'\u00a0cos','#0288d1');

  var marginBarsHtml='';
  byMargin.forEach(function(s){
    var pct=maxM>0?(s.margin/maxM*100):0;
    var col=s.margin>=0.25?'#1a9850':s.margin>=0.15?'#74c476':s.margin>=0.10?'#fd8d3c':'#de2d26';
    var hhiCol=s.hhi>0.25?'#c0392b':s.hhi>0.15?'#e67e22':'#27ae60';
    var hhiLbl=s.hhi>0.25?'Oligopoly':s.hhi>0.15?'Moderate':'Competitive';
    var topTk=s.topPlayer?s.topPlayer.ticker:'';
    var topCol=s.topPlayer?(RC[s.topPlayer.rating]||'#aaa'):'#aaa';
    var sEsc=s.name.replace(/'/g,"\\'");
    marginBarsHtml+='<div class="xsect-bar-row" onclick="showPoolTab(\''+sEsc+'\')" style="cursor:pointer" title="Go to '+s.name+'">'
      +'<div class="xsect-bar-label">'+s.name+'</div>'
      +'<div class="xsect-bar-track"><div class="xsect-bar-fill" style="width:'+pct.toFixed(1)+'%;background:'+col+'"></div>'
      +'<span class="xsect-bar-pct">'+(s.margin*100).toFixed(1)+'%</span></div>'
      +'<div class="xsect-bar-meta"><span style="color:'+hhiCol+';font-weight:600">'+hhiLbl+'</span>'
      +' <span style="color:#bbb">'+s.hhi.toFixed(3)+'</span>'
      +' \u00b7 CR4\u00a0'+(s.cr4*100).toFixed(0)+'%'
      +(topTk?' \u00b7 <span class="rb" style="background:'+topCol+';font-size:0.68em;padding:1px 5px">'+topTk+'</span>':'')
      +'</div></div>';
  });

  window._xsStats=allStats;window._xsMaxM=maxM;

  var narItems=[];
  var top3Detail=byMargin.slice(0,3).map(function(s){return s.name+'\u00a0('+(s.margin*100).toFixed(1)+'%)';}).join(', ');
  var bot2Detail=byMargin.slice(-2).reverse().map(function(s){return s.name+'\u00a0('+(s.margin*100).toFixed(1)+'%)';}).join(' and ');
  narItems.push('<strong>Margin leaders \u2014 '+top3Detail+':</strong> These sectors sustain blended operating margins that consistently support ROIC well above cost of capital. Pricing power at this level is structurally embedded \u2014 through proprietary platforms, brand-enforced switching costs, or regulated cost pass-through \u2014 rather than cyclically contingent. Reversion is slow because the underlying economics are hard to replicate at scale.');
  narItems.push('<strong>Margin challenged \u2014 '+bot2Detail+':</strong> Structurally thin margins reflect economics where pricing is market-determined, not firm-determined: commodity input costs, compressed processing spreads, or capital-intensive distribution compress returns toward cost of capital. Margin expansion in these pools is hard-won and frequently gives back in competitive reversion. Stock selection here requires identifying firms with structural cost advantages, not just sector-level exposure.');
  var oligopolies=allStats.filter(function(s){return s.hhi>0.25;});
  var highConc=byHHI.filter(function(s){return s.hhi>0.15&&s.hhi<=0.25;});
  var valueTrap=allStats.filter(function(s){return s.hhi>0.15&&s.margin<0.12;});
  if(oligopolies.length){narItems.push('<strong>Highly concentrated \u2014 '+oligopolies.map(function(s){return s.name+'\u00a0(HHI\u00a0'+s.hhi.toFixed(3)+',\u00a0CR4\u00a0'+(s.cr4*100).toFixed(0)+'%)';}).join(', ')+':</strong> HHI above 0.25 meets the DOJ/FTC threshold for a highly concentrated market, where a small set of incumbents captures the majority of industry revenue and profit. Collective pricing power is structurally entrenched, but the moat is positional rather than intrinsic \u2014 returns depend on maintaining share, not product superiority \u2014 leaving these sectors exposed to antitrust action, regulatory price controls, or a single well-capitalized disruptor.');}
  if(highConc.length){narItems.push('<strong>Moderately concentrated \u2014 '+highConc.slice(0,5).map(function(s){return s.name+'\u00a0(HHI\u00a0'+s.hhi.toFixed(3)+')';}).join(', ')+':</strong> HHI in the 0.15\u20130.25 range (DOJ/FTC \u201cmoderately concentrated\u201d band) indicates leading incumbents extract measurable pricing advantage over smaller competitors. Market structure is decisive but not rigid: challengers with differentiated cost structures or product offerings retain room to erode share. Alpha here accrues to incumbents deepening their moat, not to passive sector exposure.');}
  narItems.push('<strong>Most fragmented \u2014 '+leastConc.name+'\u00a0(HHI\u00a0'+leastConc.hhi.toFixed(3)+',\u00a0'+leastConc.n+'\u00a0companies):</strong> With HHI well below the 0.10 competitive threshold, no firm exerts meaningful influence over sector-wide pricing. Returns mean-revert toward cost of capital at the pool level. Sector-level allocation carries less signal; idiosyncratic factors \u2014 unit cost structure, balance sheet strength, niche positioning \u2014 drive the cross-sectional variance in outcomes. Individual stock selection matters more than being in this sector at all.');
  var sweetSpot=allStats.filter(function(s){return s.margin>=0.20&&s.hhi<0.15;});
  if(sweetSpot.length){narItems.push('<strong>Quality quadrant \u2014 '+sweetSpot.map(function(s){return s.name+'\u00a0('+(s.margin*100).toFixed(1)+'%\u00a0margin,\u00a0HHI\u00a0'+s.hhi.toFixed(3)+')';}).join('; ')+':</strong> High margins in a competitive market are the strongest signal of genuine structural advantage: firms earn pricing power through product differentiation, proprietary IP, or customer switching costs \u2014 not through market dominance or regulatory protection. This is the most durable earnings profile because the advantage is intrinsic, not positional, and does not depend on maintaining a stable oligopoly structure that regulators or disruptors could unwind.');}
  if(valueTrap.length){narItems.push('<strong>Concentration without margin \u2014 '+valueTrap.map(function(s){return s.name+'\u00a0(HHI\u00a0'+s.hhi.toFixed(3)+',\u00a0'+(s.margin*100).toFixed(1)+'%\u00a0margin)';}).join(', ')+':</strong> Elevated concentration has not translated into commensurate margin extraction. This pattern emerges where volume competition, commodity input pricing, or mandated price ceilings constrain profitability regardless of market share. High HHI here reflects market structure, not pricing power \u2014 the leading firm\u2019s dominant position is a floor on survival, not a ceiling lift on returns.');}
  narItems.push('<strong>Cross-sector spread \u2014 '+((maxM-minM)*100).toFixed(0)+'\u00a0percentage points:</strong> The gap between the highest and lowest blended sector margins is wide enough that sector allocation is a first-order return driver, not a secondary tilting decision. A portfolio systematically overweight in high-quality pools \u2014 particularly sectors in the Quality quadrant \u2014 and underweight in structurally challenged pools compounds this advantage across cycles. Sector selection anchored to pool quality can rival individual stock selection in generating sustained portfolio-level alpha.');

  return'<div class="xsect-dashboard">'
    +'<div class="xsect-title">Cross-Sector Profit Pool Comparison</div>'
    +'<div class="xsect-sub">Blended pool margins, market concentration, and competitive dynamics across '+allStats.length+' sectors</div>'
    +'<div class="xsect-kpi-row">'+kpiHtml+'</div>'
    +'<div id="xsect-bar-wrap" style="margin-bottom:20px">'
      +'<div class="xsect-chart-title">Operating Margin by Sector <span style="font-weight:400;text-transform:none;letter-spacing:0">(pool-weighted)</span></div>'
      +marginBarsHtml
    +'</div>'
    +'<div style="margin-bottom:4px">'
      +'<div style="padding-top:16px"><div class="xsect-chart-title">Margin vs. Concentration</div><div id="xsect-scatter-wrap"></div></div>'
      +'<div class="xsect-narrative"><div class="xsect-nar-title">Comparative Analysis</div>'
      +'<ul style="margin:0;padding-left:18px">'+narItems.map(function(b){return'<li style="margin-bottom:9px;font-size:0.82em;color:#2c3e50;line-height:1.55">'+b+'</li>';}).join('')+'</ul>'
      +'</div>'
    +'</div>'
    +'</div></div>';
}
function _buildScatterSVG(W,H){
  var allStats=window._xsStats,maxM=window._xsMaxM;
  if(!allStats||!allStats.length)return'';
  var spL=62,spR=18,spT=30,spB=50;
  var sCW=W-spL-spR,sCH=H-spT-spB;
  var maxHHI=0.23,maxSM=Math.max(0.40,maxM*1.08);
  var qxMid=spL+(0.15/maxHHI)*sCW,qyMid=spT+sCH-(0.20/maxSM)*sCH;
  var s='<svg viewBox="0 0 '+W+' '+H+'" style="display:block;width:'+W+'px;height:'+H+'px;overflow:visible">';
  s+='<rect x="'+spL+'" y="'+spT+'" width="'+(qxMid-spL).toFixed(1)+'" height="'+(qyMid-spT).toFixed(1)+'" fill="#e8f5e9" opacity="0.55"/>';
  s+='<rect x="'+qxMid.toFixed(1)+'" y="'+spT+'" width="'+(spL+sCW-qxMid).toFixed(1)+'" height="'+(qyMid-spT).toFixed(1)+'" fill="#f3e5f5" opacity="0.55"/>';
  s+='<rect x="'+spL+'" y="'+qyMid.toFixed(1)+'" width="'+(qxMid-spL).toFixed(1)+'" height="'+(spT+sCH-qyMid).toFixed(1)+'" fill="#f5f5f5" opacity="0.55"/>';
  s+='<rect x="'+qxMid.toFixed(1)+'" y="'+qyMid.toFixed(1)+'" width="'+(spL+sCW-qxMid).toFixed(1)+'" height="'+(spT+sCH-qyMid).toFixed(1)+'" fill="#fde8e8" opacity="0.55"/>';
  s+='<line x1="'+spL+'" y1="'+spT+'" x2="'+spL+'" y2="'+(spT+sCH)+'" stroke="#ccc" stroke-width="1"/>';
  s+='<line x1="'+spL+'" y1="'+(spT+sCH)+'" x2="'+(spL+sCW)+'" y2="'+(spT+sCH)+'" stroke="#ccc" stroke-width="1"/>';
  s+='<line x1="'+qxMid.toFixed(1)+'" y1="'+spT+'" x2="'+qxMid.toFixed(1)+'" y2="'+(spT+sCH)+'" stroke="#bbb" stroke-width="1" stroke-dasharray="4,3"/>';
  s+='<line x1="'+spL+'" y1="'+qyMid.toFixed(1)+'" x2="'+(spL+sCW)+'" y2="'+qyMid.toFixed(1)+'" stroke="#bbb" stroke-width="1" stroke-dasharray="4,3"/>';
  var _qlbl=' style="cursor:help" onmousemove="ppQuadMove(event)" onmouseleave="ppQuadHide()"';
  s+='<text x="'+(spL+6)+'" y="'+(spT+14)+'" font-size="11" fill="#43a047" font-weight="700" text-decoration="underline"'+_qlbl+' onmouseenter="ppQuadTip(event,\'q\')">Quality</text>';
  s+='<text x="'+(qxMid+6)+'" y="'+(spT+14)+'" font-size="11" fill="#8e24aa" font-weight="700" text-decoration="underline"'+_qlbl+' onmouseenter="ppQuadTip(event,\'po\')">Profitable Oligopoly</text>';
  s+='<text x="'+(spL+6)+'" y="'+(spT+sCH-6)+'" font-size="11" fill="#9e9e9e" font-weight="700" text-decoration="underline"'+_qlbl+' onmouseenter="ppQuadTip(event,\'f\')">Fragmented</text>';
  s+='<text x="'+(qxMid+6)+'" y="'+(spT+sCH-6)+'" font-size="11" fill="#e53935" font-weight="700" text-decoration="underline"'+_qlbl+' onmouseenter="ppQuadTip(event,\'vt\')">Value Trap</text>';
  [0,0.10,0.20,0.30,0.40,0.50,0.60].forEach(function(v){
    if(v>maxSM+0.01)return;
    var ty=spT+sCH-(v/maxSM)*sCH;
    s+='<text x="'+(spL-6)+'" y="'+(ty+4).toFixed(1)+'" text-anchor="end" font-size="11" fill="#444">'+(v*100).toFixed(0)+'%</text>';
    if(v>0)s+='<line x1="'+spL+'" y1="'+ty.toFixed(1)+'" x2="'+(spL+sCW)+'" y2="'+ty.toFixed(1)+'" stroke="#ebebeb" stroke-width="1"/>';
  });
  [0,0.05,0.10,0.15,0.20].forEach(function(v){
    var tx=spL+(v/maxHHI)*sCW;
    s+='<text x="'+tx.toFixed(1)+'" y="'+(spT+sCH+18)+'" text-anchor="middle" font-size="11" fill="#444">'+v.toFixed(2)+'</text>';
  });
  var yCtr=spT+sCH/2;
  s+='<text x="14" y="'+yCtr.toFixed(1)+'" text-anchor="middle" font-size="12" fill="#333" font-weight="600" transform="rotate(-90,14,'+yCtr.toFixed(1)+')">Operating Margin \u2192</text>';
  s+='<text x="'+(spL+sCW/2)+'" y="'+(H-8)+'" text-anchor="middle" font-size="12" fill="#333" font-weight="600">HHI (Concentration \u2192 more concentrated)</text>';
  allStats.forEach(function(st){
    var cx=spL+Math.min(st.hhi/maxHHI,0.999)*sCW;
    var cy=spT+sCH-Math.min(st.margin/maxSM,0.999)*sCH;
    var col=st.margin>=0.25?'#1a9850':st.margin>=0.15?'#4caf50':st.margin>=0.10?'#ff9800':'#e53935';
    var sE=st.name.replace(/'/g,"\\'");
    var clk='onclick="showPoolTab(\''+sE+'\')" style="cursor:pointer"';
    s+='<circle cx="'+cx.toFixed(1)+'" cy="'+cy.toFixed(1)+'" r="9" fill="'+col+'" opacity="0.88" stroke="white" stroke-width="1.5" '+clk+' title="'+st.name+'"/>';
    var lx=cx+13,ly=cy-3,ta='start';
    if(cx>spL+sCW*0.65){lx=cx-13;ta='end';}
    if(cy<spT+20){ly=cy+20;}
    s+='<text x="'+lx.toFixed(1)+'" y="'+ly.toFixed(1)+'" text-anchor="'+ta+'" font-size="11" fill="#222" font-weight="600" '+clk+'>'+st.name+'</text>';
  });
  s+='</svg>';
  return s;
}
function renderPool(){
  var sectors={};
  DATA.forEach(function(d){if(!d.sector||d.pp_revenue_share==null)return;if(!sectors[d.sector])sectors[d.sector]=[];sectors[d.sector].push(d);});
  var secList=Object.keys(sectors).sort();
  var chosen=_poolTab||'__all__';
  var navHtml='<div class="secondary-nav"><button class="sub-btn'+(chosen==='__all__'?' active':'')+'" onclick="showPoolTab(\'__all__\')">Overview</button>';
  secList.forEach(function(s){var se=s.replace(/'/g,"\\'");navHtml+='<button class="sub-btn'+(chosen===s?' active':'')+'" onclick="showPoolTab(\''+se+'\')">'+s+'</button>';});
  navHtml+='</div>';
  document.getElementById('pool-controls').innerHTML=navHtml;
  var toRender=(chosen&&chosen!=='__all__'&&sectors[chosen])?[chosen]:[];
  var chartHtml='',tableRows='';
  if(chosen==='__all__'){chartHtml=renderCrossSectorDashboard();}
  toRender.forEach(function(sec){
    var cos=sectors[sec];if(!cos||!cos.length)return;
    var sorted=cos.slice().sort(function(a,b){return(b.operating_margin||0)-(a.operating_margin||0);});
    var totalRev=sorted.reduce(function(s,d){return s+(d.pp_revenue_share||0);},0);if(!totalRev)return;
    var margins=sorted.map(function(d){return d.operating_margin||0;});
    var maxM=Math.max.apply(null,margins.concat([0.05]));
    var minM=Math.min.apply(null,margins.concat([-0.02,0]));
    var yRange=maxM-minM;if(yRange<0.02)yRange=0.02;
    var W=800,H=190,pL=48,pR=10,pT=14,pB=26,cW=W-pL-pR,cH=H-pT-pB;
    var zeroY=pT+cH*(maxM/yRange);
    var bars='',labels='',axes='',ticks='';
    for(var ti=0;ti<=4;ti++){var tv=minM+(yRange/4)*ti;var ty=pT+cH*(maxM-tv)/yRange;ticks+='<line x1="'+pL+'" y1="'+ty.toFixed(1)+'" x2="'+(pL-4)+'" y2="'+ty.toFixed(1)+'" stroke="#ccc" stroke-width="1"/>';ticks+='<text x="'+(pL-6)+'" y="'+(ty+3.5).toFixed(1)+'" text-anchor="end" font-size="9" fill="#999">'+(tv*100).toFixed(0)+'%</text>';if(ti>0&&ti<4)ticks+='<line x1="'+pL+'" y1="'+ty.toFixed(1)+'" x2="'+(W-pR)+'" y2="'+ty.toFixed(1)+'" stroke="#f5f5f5" stroke-width="1"/>';}
    axes+='<line x1="'+pL+'" y1="'+pT+'" x2="'+pL+'" y2="'+(pT+cH)+'" stroke="#ccc" stroke-width="1"/>';
    axes+='<line x1="'+pL+'" y1="'+zeroY.toFixed(1)+'" x2="'+(W-pR)+'" y2="'+zeroY.toFixed(1)+'" stroke="#aaa" stroke-width="1.5" stroke-dasharray="4,3"/>';
    axes+='<text x="'+(pL+cW/2)+'" y="'+(H-6)+'" text-anchor="middle" font-size="9" fill="#bbb">Cumulative Revenue Share \u2192</text>';
    var cumX=0;
    sorted.forEach(function(d){
      var share=(d.pp_revenue_share||0)/totalRev;var barW=Math.max(1.5,share*cW);
      var margin=d.operating_margin||0;var barH=Math.max(1,Math.abs(margin)/yRange*cH);
      var barY=margin>=0?zeroY-barH:zeroY;var bx=pL+cumX;var col=RC[d.rating]||'#aaa';
      var tk=d.ticker.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
      bars+='<rect x="'+bx.toFixed(1)+'" y="'+barY.toFixed(1)+'" width="'+barW.toFixed(1)+'" height="'+barH.toFixed(1)+'" fill="'+col+'" opacity="0.82" stroke="rgba(255,255,255,0.6)" stroke-width="0.5" onmouseenter="ppTip(event,\''+tk+'\')" onmouseleave="ppHide()" onclick="openDet(\''+tk+'\')" style="cursor:pointer"/>';
      if(barW>18){var lx=bx+barW/2;var ly=margin>=0?barY-3:barY+barH+9;labels+='<text x="'+lx.toFixed(1)+'" y="'+ly.toFixed(1)+'" text-anchor="middle" font-size="8" fill="#444" pointer-events="none">'+d.ticker+'</text>';}
      cumX+=barW;
    });
    var hhi=sorted[0].pp_sector_hhi,cr4=sorted[0].pp_sector_cr4;
    var conc=hhi!=null?(hhi>0.25?'Concentrated':hhi>0.15?'Moderate':'Competitive'):'';
    chartHtml+='<div class="pool-sector" id="pool-sec-'+sec.replace(/\s+/g,'-')+'"><div class="pool-sec-hdr"><span class="pool-sec-name">'+sec+'</span><span class="pool-sec-stats">'+sorted.length+' companies';
    if(hhi!=null)chartHtml+=' &nbsp;&middot;&nbsp; HHI: '+hhi.toFixed(3)+' ('+conc+')';
    if(cr4!=null)chartHtml+=' &nbsp;&middot;&nbsp; CR4: '+(cr4*100).toFixed(0)+'%';
    chartHtml+='</span></div>';
    var primerHtml=renderPoolPrimer(sec);
    var descHtml=renderPoolDescription(sec);
    var insightsHtml=renderPoolInsights(sec);
    var playersHtml=renderPoolKeyPlayers(sec);
    var cr4Html=renderPoolCR4Companies(sec);
    if(primerHtml){
      chartHtml+='<div class="pp-section pp-primer"><span class="pp-section-label">How This Sector Makes Money</span>'+primerHtml+'</div>';
    }
    if(descHtml){
      chartHtml+='<div class="pp-section pp-desc"><span class="pp-section-label">Overview</span>'+descHtml+'</div>';
    }
    if(insightsHtml){
      chartHtml+='<div class="pp-section pp-insights"><span class="pp-section-label">Insights</span>'+insightsHtml+'</div>';
    }

    if(playersHtml){
      chartHtml+='<div class="pp-section pp-players"><span class="pp-section-label">Company Highlights</span>'+playersHtml+'</div>';
    }
    if(cr4Html){
      chartHtml+='<div class="pp-section pp-cr4"><span class="pp-section-label">CR4 Companies</span>'+cr4Html+'</div>';
    }
    chartHtml+='<div class="pp-section pp-chart"><span class="pp-section-label">Profit Pool Chart</span><svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="none" style="display:block;width:100%;height:auto;margin:4px 0 0">'+ticks+axes+bars+labels+'</svg><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-top:8px;padding-top:8px;border-top:1px solid #e8ecef"><div class="pool-legend" style="margin:0"><span class="pool-legend-item"><span class="pool-legend-dot" style="background:#1a9850"></span>BUY</span><span class="pool-legend-item"><span class="pool-legend-dot" style="background:#74c476"></span>LEAN BUY</span><span class="pool-legend-item"><span class="pool-legend-dot" style="background:#fd8d3c"></span>HOLD</span><span class="pool-legend-item"><span class="pool-legend-dot" style="background:#de2d26"></span>PASS</span></div><span style="font-size:0.7em;color:#aaa">Bar width = revenue share &middot; Bar height = operating margin &middot; Click to open detail</span></div></div>';
    chartHtml+='</div>';
    var wtdM=sorted.reduce(function(s,d){return s+(d.operating_margin||0)*(d.pp_revenue_share||0);},0)/totalRev;
    var best=sorted.reduce(function(a,b){return(a.pp_multiple||0)>(b.pp_multiple||0)?a:b;});
    var avgMult=sorted.reduce(function(s,d){return s+(d.pp_multiple||0);},0)/sorted.length;
    tableRows+='<tr><td style="text-align:left;font-weight:600">'+sec+'</td><td>'+sorted.length+'</td><td>'+(wtdM*100).toFixed(1)+'%</td><td>'+(hhi!=null?hhi.toFixed(3):'&mdash;')+'</td><td>'+(cr4!=null?(cr4*100).toFixed(0)+'%':'&mdash;')+'</td><td style="text-align:left"><span class="rb" style="background:'+(RC[best.rating]||'#aaa')+'">'+best.ticker+'</span> '+((best.pp_multiple||0).toFixed(2))+'x</td><td>'+avgMult.toFixed(2)+'x</td></tr>';
  });
  document.getElementById('pool-chart-area').innerHTML=chartHtml||'<p style="color:#999;padding:20px;font-size:0.9em">No profit pool data available.</p>';
  function _syncScatter(){
    var bw=document.getElementById('xsect-bar-wrap');var sw=document.getElementById('xsect-scatter-wrap');
    if(!bw||!sw||!window._xsStats)return;
    var spL=62,spR=18,spT=30,spB=50,gap=18;
    var bR=bw.getBoundingClientRect();
    var rows=bw.querySelectorAll('.xsect-bar-row');
    var barH=rows.length>0?Math.round(rows[rows.length-1].getBoundingClientRect().bottom-rows[0].getBoundingClientRect().top):Math.round(bR.height);
    var W=Math.floor(bR.width);
    var H=Math.max(barH+spT+spB,460);
    sw.style.marginLeft='0';
    sw.innerHTML=_buildScatterSVG(W,H);
  }
  setTimeout(_syncScatter,0);
  window.addEventListener('resize',_syncScatter);
  document.getElementById('pool-sector-table').innerHTML=(chosen==='__all__'&&tableRows)?'<div style="margin-top:16px;background:white;border-radius:8px;padding:14px;box-shadow:0 2px 8px rgba(0,0,0,0.07)"><div style="font-weight:700;font-size:0.88em;color:#1a252f;margin-bottom:10px">Sector Summary</div><div class="table-wrap"><table class="dt"><thead><tr><th style="text-align:left">Sector</th><th>Cos</th><th>Wtd Margin</th><th>HHI</th><th>CR4</th><th style="text-align:left">Top Earner</th><th>Avg Multiple</th></tr></thead><tbody>'+tableRows+'</tbody></table></div></div>':'';
}
function ppTip(e,ticker){
  var d=null;for(var i=0;i<DATA.length;i++){if(DATA[i].ticker===ticker){d=DATA[i];break;}}
  if(!d)return;
  var tt=document.getElementById('pool-tt');
  var m=d.operating_margin!=null?(d.operating_margin*100).toFixed(1)+'%':'N/A';
  var mult=d.pp_multiple!=null?d.pp_multiple.toFixed(2)+'x':'N/A';
  var rs=d.pp_revenue_share!=null?(d.pp_revenue_share*100).toFixed(1)+'%':'N/A';
  var ps=d.pp_profit_share!=null?(d.pp_profit_share*100).toFixed(1)+'%':'N/A';
  tt.innerHTML='<b>'+d.ticker+'</b>'+(d.company_name?' &mdash; '+d.company_name:'')+'<br>Rating: '+(d.rating||'N/A')+'<br>Op. Margin: '+m+'<br>Rev Share: '+rs+' &nbsp;|&nbsp; Profit Share: '+ps+'<br>Pool Multiple: '+mult;
  tt.style.display='block';tt.style.left=(e.clientX+14)+'px';tt.style.top=(e.clientY-10)+'px';
}
function ppHide(){document.getElementById('pool-tt').style.display='none';}
var _ppQD={
  q:{title:'Quality',col:'#2e7d32',bg:'#f1f8e9',bc:'#43a047',text:'High margins in a competitive market signal durable structural advantage \u2014 brand equity, proprietary IP, or switching costs that hold pricing power without relying on market concentration. These businesses earn strong ROIC through product superiority, not dominance. The best long-term compounders live here.'},
  po:{title:'Profitable Oligopoly',col:'#6a1b9a',bg:'#f3e5f5',bc:'#8e24aa',text:'A small number of players control share and earn elevated margins through collective pricing power. Returns are high, but the moat is market structure \u2014 not intrinsic product advantage. Regulatory scrutiny, antitrust action, or a single disruptive entrant can compress returns quickly.'},
  f:{title:'Fragmented',col:'#616161',bg:'#f5f5f5',bc:'#9e9e9e',text:'Many competitors, thin margins, no structural pricing power. Capital is commoditized and returns mean-revert toward cost of capital. Sector-level allocation adds little alpha here \u2014 individual stock selection, cost discipline, and balance sheet strength matter most.'},
  vt:{title:'Value Trap',col:'#c62828',bg:'#fde8e8',bc:'#e53935',text:'Concentration without margin. Leaders may dominate by volume but face structural cost constraints, commodity pricing, or intense input competition. Independents compete for scraps. Difficult to compound capital in these structures \u2014 high share does not translate to high return.'}
};
function ppQuadTip(e,key){
  var def=_ppQD[key];if(!def)return;
  var tt=document.getElementById('pp-quad-tip');
  tt.style.background=def.bg;tt.style.borderColor=def.bc;
  tt.innerHTML='<div style="font-weight:700;color:'+def.col+';font-size:0.84em;margin-bottom:6px">'+def.title+'</div><div style="color:#455a64;font-size:0.78em;line-height:1.58">'+def.text+'</div>';
  var tx=e.clientX+18,ty=e.clientY-24;
  if(tx+310>window.innerWidth)tx=e.clientX-326;
  if(ty+120>window.innerHeight)ty=e.clientY-130;
  tt.style.left=tx+'px';tt.style.top=ty+'px';tt.style.display='block';
}
function ppQuadMove(e){
  var tt=document.getElementById('pp-quad-tip');
  if(tt.style.display!=='block')return;
  var tx=e.clientX+18,ty=e.clientY-24;
  if(tx+310>window.innerWidth)tx=e.clientX-326;
  if(ty+120>window.innerHeight)ty=e.clientY-130;
  tt.style.left=tx+'px';tt.style.top=ty+'px';
}
function ppQuadHide(){document.getElementById('pp-quad-tip').style.display='none';}

/* === INIT === */
(function(){
  DATA.forEach(function(d){if(d.dcf_sens_range){d._sens_low=d.dcf_sens_range[0];d._sens_high=d.dcf_sens_range[1];}});
  var secs=[];DATA.forEach(function(d){if(d.sector&&secs.indexOf(d.sector)<0)secs.push(d.sector);});secs.sort();
  var shtml='<label class="ms-all"><input type="checkbox" checked onchange="msToggleAll(\'ms-sector\',this.checked)"> All Sectors</label>';
  secs.forEach(function(s){shtml+='<label><input type="checkbox" value="'+s+'" checked onchange="msChanged(\'ms-sector\')"> '+s+'</label>';});
  document.getElementById('ms-sector-opts').innerHTML=shtml;
  // Build _CF_FMT lookup and _cfOptHtml for dynamic filter rows
  var _CF_FMT={};window._CF_FMT=_CF_FMT;
  var cfSeen={};var optHtml='<option value="">Column\u2026</option>';
  Object.keys(TL).forEach(function(tabKey){
    var cols=TC[tabKey];var grpHtml='';
    cols.forEach(function(c){
      if(c.f==='text'||c.f==='rating'||c.f==='ar')return;
      if(!cfSeen[c.k]){cfSeen[c.k]=true;_CF_FMT[c.k]=c.f;}
      var unit=c.f==='pct'?' (%)':c.f==='dollar'||c.f==='ds'?' ($)':'';
      grpHtml+='<option value="'+c.k+'">'+c.l+unit+'</option>';
    });
    if(grpHtml)optHtml+='<optgroup label="'+TL[tabKey]+'">'+grpHtml+'</optgroup>';
  });
  _cfOptHtml=optHtml;
  addColFilter(); // seed one empty row
  document.getElementById('f-count').textContent=DATA.length+' of '+DATA.length;
  moveFilterBar(curView);
  applyFilters();
  setTimeout(_setTableH,0);
})();
</script>
</body>
</html>