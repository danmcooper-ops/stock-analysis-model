 Performance Coatings Group segment develops and sells industrial coatings for wood finishing and general industrial applications; automotive refinish products; protective and marine coatings; coil coatings; packaging coatings; and performance-based resins and colorants. This segment serves retailers, dealers, jobbers, licensees, and other third-party distributors. The company operates in North America, South America, the Caribbean, Europe, Asia, and Australia. The Sherwin-Williams Company was founded in 1866 and is headquartered in Cleveland, Ohio.", "ceo_bio": "Ms. Heidi G. Petz | Chairman, CEO & President | Age 50 | Compensation: $4.2M (FY2025)", "founder_led": false, "fcf": 2654000000.0, "fcf_margin": 0.112580225075612, "sbc_pct_rev": 0.005238755763691817, "mcap": 85217173504, "roic_by_year": {"2025": 0.16853194142709588, "2024": 0.1854938988327422, "2023": 0.18166632891260898, "2022": 0.15285788710448675}, "roic_cv": 0.0857665654408099, "gross_margin": 0.4756791084219145, "er": 0.110486675, "re_method": "capm", "beta_raw": 0.8258170398450981, "beta_adjusted": 0.8838780265633988, "beta_r2": 0.2971800614644175, "beta_se": 0.03589168752636696, "beta_n_obs": 1254, "beta_r2_class": "unreliable", "dcf_sens_range": [100.2055559459261, 182.824994299261], "fcf_growth": 0.05, "pfcf": 32.108957612660134, "pb": 18.420546, "num_analysts": 21, "target_mean": 379.42856, "target_high": 420.0, "target_low": 268.0, "cash_conv": 1.3438193498150672, "accruals": -0.03409428724755518, "rev_cagr": 0.021007379883363875, "rev_cagr_5y": 0.05124800274973418, "rev_cagr_10y": 0.07593591612552486, "int_cov": 8.164946236559139, "nd_ebitda": 2.8467900572246068, "de": 4.632886066589827, "cr": 0.8680837535944973, "roe": 0.5585759954765892, "roa": 0.09916337537690577, "shares_out": 247362348, "float_shares": 229665205, "insider_pct": 0.06277, "inst_pct": 0.83188003, "shares_short": 5209502, "short_ratio": 2.93, "short_pct_float": 0.0211, "share_turnover_rate": 0.007240370308904086, "share_buybac