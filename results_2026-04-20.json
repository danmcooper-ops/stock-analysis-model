alse, "_gp_fcf_margin": true, "_score_mos": 0.0, "_score_price_fv": 0.0, "_score_p_fcf": 53.8, "_score_piotroski": null, "_score_int_coverage": null, "_score_accruals": 39.2, "_score_shrhldr_yield": 65.2, "_score_roic_consistency": 87.5, "_score_spread": 100.0, "_score_gross_margin": 66.0, "_score_fund_growth": 0.0, "_score_margins": 52.9, "_score_surprise": null, "_score_insider_own": 8.0, "_score_turnover": null, "_score_buyback_rate": 71.0, "_score_insider_buying": null, "_score_roe": 100.0, "_score_net_debt_ebitda": 83.0, "_score_cash_conv": 80.5, "_score_rev_durability": 54.0, "_score_sbc_dilution": 77.3, "_score_price_book": 24.0, "_score_fcf_margin": 42.6, "_score_valuation": 19.5, "_score_quality": 67.6, "_score_moat": 74.0, "_score_growth": 51.7, "_score_ownership": 55.4, "_composite_score": 57.9, "_composite_score_raw": 57.9, "_gates_passed": "13/19", "mc_confidence": "HIGH (15%)", "mc_cv": 0.15493151497883212, "mc_p10_fv": 105.13360145742259, "mc_p90_fv": 152.0165614322748, "macro_regime": "expansion", "macro_composite": 0.475, "macro_erp": 0.053575, "financial_summary": ["Williams-Sonoma, Inc. is a large-cap consumer cyclical business with a $24.0B market cap on $7.8B of annual revenue.", "The top line has compounded at -3% over the past three years and +6% annually across the full decade, and Buffett warns that a shrinking top line is the hardest headwind any business can overcome.", "Returns on capital run at 43% against a 12% cost of capital \u2014 a 31-point spread that is the clearest signature of an economic moat Buffett teaches us to look for, with gross margins sitting at 44%.", "The business throws off $1.1B in free cash flow \u2014 roughly 14 cents on every revenue dollar, which is the owner-earnings figure that actually belongs to shareholders, and cash conversion sits at 1.21\u00d7 so those profits are backed by real cash.", "On the balance sheet, leverage is comfortably within Buffett\u2019s tolerance at 0.3\u00d7 net debt/EBITDA.", "Shareho