  (function(){
    var el=document.getElementById('d-desc');
    var P='<p style="margin:0 0 10px;line-height:1.65;color:#2c3e50">';
    var PS='<p style="margin:0 0 10px;line-height:1.65;color:#455a64;border-top:1px solid #e8edf2;padding-top:10px">';
    var html='';
    /* --- Business model: up to 5 sentences, capped at 640 chars to cover
         all major segments, geography, and distribution without boilerplate --- */
    var full=d.description_full||d.description||'';
    if(full){
      /* Replace "Suffix.," (e.g. "Co., Inc." / "Paychex, Inc.,") dots with
         a placeholder so the sentence splitter doesn't skip the company name */
      var _PH='\u200B';
      var safe=full.replace(/\b(Inc|Corp|Ltd|Co|LLC|L\.P|plc|PLC|N\.V|S\.A|AG|SE)\.,/gi,function(m){return m.replace('.',_PH);});
      var rawSents=(safe.match(/[^.!?]+[.!?]+(\s|$)/g)||[]).map(function(s){return s.replace(new RegExp(_PH,'g'),'.').trim();});
      /* Merge name-only fragments (corporate suffixes) into the following sentence */
      var _corpSfx=/\b(Inc|Corp|Ltd|Co|LLC|L\.P|plc|PLC|N\.V|S\.A|AG|SE|Incorporated|Corporation|Company|Companies|International)\.$/i;
      var sents=[];
      for(var ri=0;ri<rawSents.length;ri++){
        var isNameFrag=rawSents[ri].length<35||_corpSfx.test(rawSents[ri]);
        if(isNameFrag&&ri+1<rawSents.length){rawSents[ri+1]=rawSents[ri]+' '+rawSents[ri+1];}
        else{sents.push(rawSents[ri]);}
      }
      var bizDesc='';
      for(var si=0;si<Math.min(5,sents.length);si++){
        var candidate=bizDesc+(bizDesc?' ':'')+sents[si];
        if(candidate.length>640) break;
        bizDesc=candidate;
      }
      if(!bizDesc&&full) bizDesc=full.slice(0,640).replace(/\s+\S*$/,'')+'\u2026';
      if(d.culture_narrative) bizDesc+=(bizDesc?' ':'')+d.culture_narrative;
      if(bizDesc){bizDesc=bizDesc.charAt(0).toUpperCase()+bizDesc.slice(1);html+=P+esc(bizDesc)+'</p>';}
    }
    if(!html){
      var fallback=(d.company_name||d.ticker||'')+(d.sector?' \u00b7 '+d.sector:'')+(d.industry?' \u00b7 '+d.industry:'');
