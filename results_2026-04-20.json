  if(tSC){sd.sort(function(a,b){var va,vb;if(tSC==='_flagged'){va=isFlagged(a.ticker)?1:0;vb=isFlagged(b.ticker)?1:0;}else if(tSC==='_reviewed'){va=isReviewed(a.ticker)?1:0;vb=isReviewed(b.ticker)?1:0;}else{va=a[tSC];vb=b[tSC];}if(va==null&&vb==null)return 0;if(va==null)return 1;if(vb==null)return-1;if(tSC==='rating'){var ra=RO2[va]||99,rb2=RO2[vb]||99;return tSA?ra-rb2:rb2-ra;}if(typeof va==='string')return tSA?va.localeCompare(vb):vb.localeCompare(va);return tSA?va-vb:vb-va;});}
  _detNav=sd.map(function(d){return d.ticker;});
  var bh='';sd.forEach(function(d){var t=d.ticker.replace(/'/g,"\\'");bh+='<tr>';bh+='<td style="text-align:center">'+_starHtml(d.ticker)+'</td>';bh+='<td style="text-align:center">'+_revHtml(d.ticker)+'</td>';cols.forEach(function(c){var r=ftc(d[c.k],c.f);var cls=c.k==='ticker'?' class="tk2" onclick="openDet(\''+t+'\')"':'';bh+='<td'+cls+' data-value="'+r.v+'">'+r.t+'</td>';});bh+='</tr>';});
  tb.innerHTML=bh;
}
function tSort(col){if(tSC===col)tSA=!tSA;else{tSC=col;tSA=true;}renderTable();}

/* === TICKER HOVER TOOLTIP === */
var _tipEl=document.getElementById('tk-tip'),_tipTimer=null,_tipHideTimer=null;
function _showTip(tk,x,y){
  var d=DATA.find(function(r){return r.ticker===tk;});if(!d)return;
  var rtBg=RC[d.rating]||'#888';
  var csVal=d._composite_score;var csCol=cc(csVal);
  var csText=csVal!=null?Math.round(csVal)+'%':'N/A';
  var h='<div class="tip-hdr"><span class="tip-tk">'+esc(d.ticker)+'</span>'
    +'<span class="tip-rt" style="background:'+rtBg+'">'+(d.rating||'N/A')+'</span>'
    +'<span class="tip-cs" style="color:'+csCol+'">'+csText+'</span></div>';
  if(d.company_name)h+='<div style="color:#555;font-size:0.88em;margin:-4px 0 5px 0;font-weight:500">'+esc(d.company_name)+'</div>';
  var sec=[];if(d.sector)sec.push(d.sector);if(d.industry)sec.push(d.industry);
  if(sec.length)h+='<div class="tip-sec">'+esc(sec.join(' \u00b7 '))+'</div>';
  h+='<div class="tip-grid">';
  var rows=[
    ['Mkt Cap',fds(d.mcap),''],
    ['Price',fd(d.price),''],
    ['Fair Value',fd(d.dcf_fv),''],
    ['MoS',fp(d.mos),d.mos!=null?(d.mos>0.15?'color:#1a9850':(d.mos<0?'color:#de2d26':'')):''],
    ['ROIC',fp(d.roic),''],
    ['Spread',fp(d.spread),d.spread!=null?(d.spread>0.05?'color:#1a9850':(d.spread<0?'color:#de2d26':'')):''],
    ['Gross Margin',fp(d.gross_margin),''],
    ['ROE',fp(d.roe),''],
    ['P/B',fn(d.pb,2),''],
    ['Current Ratio',d.cr!=null?d.cr.toFixed(2):'N/A','']
  ];
  rows.forEach(function(r){h+='<div class="tip-kv"><span class="tip-k">'+r[0]+'</span><span class="tip-v"'+(r[2]?' style="'+r[2]+'"':'')+'>'+r[1]+'</span></div>';});
  h+='</div>';
  var lc=d.legal_count||0;
  if(lc>0){h+='<div style="margin-top:6px;padding-top:6px;border-top:1px solid #eee;font-size:0.9em;color:#c0392b">\u2696\uFE0F '+lc+' legal filing'+(lc>1?'s':'')+' \u2014 latest '+esc(d.legal_latest||'N/A')+'</div>';}
  else{h+='<div style="margin-top:6px;padding-top:6px;border-top:1px solid #eee;font-size:0.9em;color:#aaa">\u2696\uFE0F No recent legal filings</div>';}
  _tipEl.innerHTML=h;
  _tipEl.style.display='block';
  var tw=_tipEl.offsetWidth,th=_tipEl.offsetHeight;
  var vw=window.innerWidth,vh=window.innerHeight;
  var left=x+16,top=y+12;
  if(left+tw>vw-10)left=x-tw-10;
  if(top+th>vh-10)top=y-th-10;
  if(left<10)left=10;if(top<10)top=10;
  _tipEl.style.left=left+'px';_tipEl.style.top=top+'px';
}
function _hideTip(){_tipEl.style.display='none';}

/* === COLUMN HEADER TOOLTIP === */
var _ctEl=document.getElementById('col-tip'),_ctTimer=null;
function _showColTip(label,body,threshold,x,y){
  var h='<div class="ct-name">'+esc(label)+'</div>';
  if(body)h+='<div class="ct-body">'+esc(body)+'</div>';
  if(threshold)h+='<div class="ct-pass">\u2714 Pass: '+esc(threshold)+'</div>';
  _ctEl.innerHTML=h;
  _ctEl.style.display='block';
  var cw=_ctEl.offsetWidth,ch=_ctEl.offsetHeight;
  var vw=window.innerWidth,vh=window.innerHeight;
  var left=x-cw/2,top=y+8;
  if(left+cw>vw-10)left=vw-cw-10;
  if(left<10)left=10;
  if(top+ch>vh-10)top=y-ch-8;
  if(top<10)top=10;
  _ctEl.style.left=left+'px';_ctEl.style.top=top+'px';
}
function _hideColTip(){clearTimeout(_ctTimer);_ctEl.style.display='none';}

