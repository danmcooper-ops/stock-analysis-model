var SECTOR_POOL={"Consumer Defensive": {"education": "Consumer Defensive \u2014 packaged food, beverages, household goods, tobacco \u2014 lives off repeat purchases and brand equity built over decades. Volume growth is low single-digit, so returns come from pricing power, distribution scale against retailers, and disciplined SG&A. The profit pool is stable year-to-year, which makes the sector a bond proxy in valuation terms and a favorite of long-duration investors.", "education_cycle": "Defensively counter-cyclical: the sector outperforms late-cycle and in recessions when investors rotate to earnings stability, and lags in early-cycle rallies when risk assets take the lead. It correlates inversely with equity risk appetite and sometimes trades like a duration proxy, rallying when rates fall.", "overview": "The Consumer Defensive profit pool in this universe totals roughly $174.0B of operating income on $2.1T of revenue across 33 companies, a blended operating margin of 8.1%. WMT alone captures 17% of the pool on 33% of the revenue, setting the pace for the group. The top three names together account for 37% of profits from 39% of the revenue \u2014 roughly proportional to their revenue footprint.", "concentration": "HHI of 0.146 flags the sector as competitive with the top 4 capturing 58% of revenue \u2014 fragmentation keeps pricing honest and makes the pool hard to defend; margin discipline matters more than scale.", "key_players": [{"ticker": "WMT", "company_name": "Walmart Inc.", "role": "leader", "role_label": "Profit Leader", "note": "Captures 17% of the sector's operating income \u2014 the center of gravity for the profit pool.", "rating": "HOLD", "profit_share": 0.1714016075809934, "revenue_share": 0.3338585764840266, "op_margin": 0.041820733829433104, "pp_multiple": 0.5133958497819033}, {"ticker": "PG", "company_name": "Procter & Gamble Company (The)", "role": "runnerup", "role_label": "Runner-Up", "note": "Holds 12% of sector profits, the clear number-two position.", "rating": "LEAN BUY", "profit_share": 0.11753006795101076, "revenue_share": 0.03945652853608459, "op_margin": 0.24264391818138675, "pp_multiple": 2.978722972131843}, {"ticker": "MO", "company_name": "Altria Group, Inc.", "role": "margin_leader", "role_label": "Margin Leader", "note": "Runs the sector's fattest operating margin at 59.8%, signaling pricing power or cost discipline the rest can't match.", "rating": "BUY", "profit_share": 0.06916406864165148, "revenue_share": 0.009427827680084093, "op_margin": 0.5975967029147425, "pp_multiple": 7.336161731907531}, {"ticker": "KR", "company_name": "Kroger Company (The)", "role": "laggard", "role_label": "Margin Laggard", "note": "Operates at 1.3% \u2014 well below the sector's 8.1% blended margin, hinting at a structural disadvantage or a turnaround still in progress.", "rating": "PASS", "profit_share": 0.010861660966574267, "revenue_share": 0.06911680492293439, "op_margin": 0.012801235420815215, "pp_multiple": 0.15714934998348198}], "cr4_companies": [{"ticker": "WMT", "company_name": "Walmart Inc.", "revenue_share": 0.3338585764840266, "op_margin": 0.041820733829433104, "rating": "HOLD", "note": "Largest player by revenue (33% of sector); margin trails sector median by 10.1pp; under-earns its size (0.51x profit-to-revenue ratio)."}, {"ticker": "COST", "company_name": "Costco Wholesale Corporation", "revenue_share": 0.1288479145701348, "op_margin": 0.03772412665540356, "rating": "LEAN BUY", "note": "Second-largest by revenue (13% of sector); margin trails sector median by 10.5pp; under-earns its size (0.46x profit-to-revenue ratio)."}, {"ticker": "KR", "company_name": "Kroger Company (The)", "revenue_share": 0.06911680492293439, "op_margin": 0.012801235420815215, "rating": "PASS", "note": "Third-largest by revenue (7% of sector); margin trails sector median by 13.0pp; under-earns its size (0.16x profit-to-revenue ratio)."}, {"ticker": "TGT", "company_name": "Target Corporation", "revenue_share": 0.04905148142009093, "op_margin": 0.048835655659477, "rating": "PASS", "note": "Fourth-largest by revenue (5% of sector); margin trails sector median by 9.4pp; under-earns its size (0.60x profit-to-revenue ratio)."}], "insights": ["Margin spread between the best (MO at 59.8%) and worst (KR at 1.3%) operators exceeds 58 points \u2014 the sector rewards operational excellence, and laggards have real room to close the gap (or be taken out).", "MO converts revenue into profit 46.7x more efficiently than KR \u2014 the pool is being drained toward the efficient operator, and weak hands eventually exit."], "stats": {"total_revenue": 2136123048000.0, "total_op_income": 174006536000.0, "weighted_margin": 0.08145904149244496, "company_count": 33, "hhi": 0.1458, "cr4": 0.5809}}, "Basic Materials": {"education": "Basic Materials \u2014 mining, chemicals, steel, paper \u2014 is a pure commodity game where the cost curve determines everything. Position on the curve, orebody quality, and balance-sheet strength decide who survives the trough. Specialty chemicals are the one corner of the sector where formulation IP and customer-specific engineering can produce a real moat.", "education_cycle": "Deeply cyclical and often commodity-led: the sector outperforms early-to-mid-cycle as industrial demand recovers and commodity prices rebuild, and collapses fastest in recessions as inventory destocks cascade through the supply chain. China industrial production and the dollar are usually better indicators than domestic GDP.", "overview": "The Basic Materials profit pool in this universe totals roughly $60.0B of operating income on $381.9B of revenue across 20 companies, a blended operating margin of 15.7%. NEM alone captures 18% of the pool on 6% of the revenue, setting the pace for the group. The top three names together account for 45% of profits from 22% of the revenue \u2014 a lopsided pool where scale and pricing power compound.", "concentration": "HHI of 0.066 flags the sector as competitive with