rvices; and financial services. The company has operations in the United States, Canada, Europe, Australasia, and internationally. News Corporation was incorporated in 2012 and is headquartered in New York, New York.", "ceo_bio": "Mr. Robert J. Thomson | CEO & Director | Age 64 | Compensation: $10.4M (FY2025)", "founder_led": false, "fcf": 571000000.0, "fcf_margin": 0.0675579744439186, "sbc_pct_rev": null, "mcap": 14972471296, "roic_by_year": {"2025": 0.07208333483631063, "2024": 0.05549550438867089, "2023": 0.03874305422494731, "2022": 0.08698980008540766}, "roic_cv": 0.3290033719626821, "gross_margin": null, "er": 0.09200330000000001, "re_method": "capm", "beta_raw": 0.958048141541775, "beta_adjusted": 0.9720320943611833, "beta_r2": 0.3568444556981503, "beta_se": 0.03634994017847156, "beta_n_obs": 1254, "beta_r2_class": "unreliable", "dcf_sens_range": [30.551755900474266, 54.99915936870438], "fcf_growth": 0.05758169671448519, "pfcf": 26.221490886164624, "pb": 1.6471109, "num_analysts": 8, "target_mean": 33.925, "target_high": 41.0, "target_low": 27.0, "cash_conv": 0.8288135593220339, "accruals": 0.01302889576883385, "rev_cagr": -0.06634951064998074, "rev_cagr_5y": -0.012661158818427554, "rev_cagr_10y": -0.002116653672519564, "int_cov": null, "nd_ebitda": 0.3795053003533569, "de": 0.6969455208570777, "cr": 1.8447085889570551, "roe": 0.13448826077045817, "roa": 0.076109391124871, "shares_out": 365688296, "float_shares": 553667496, "insider_pct": 0.00068999996, "inst_pct": 1.09682, "shares_short": 11697467, "short_ratio": 2.29, "short_pct_float": 0.0319, "share_turnover_rate": 0.0123056604469507, "share_buyback_rate": 0.010018386212573574, "shareholder_yield": 0.02237439587474765, "div_yield": 0.007701193685021179, "payout_ratio": 0.2597, "insider_buy_ratio": null, "insider_buy_count_90d": 0, "insider_sell_count_90d": 0, "insider_buy_count_365d": 0, "insider_sell_count_365d": 0, "insider_net_shares": 0.0, "insider_net_value": 0.0, "insider_transactions": [{"date": "2