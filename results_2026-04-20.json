 and construction management services, together with program management offerings that support customer deployment needs from project scoping through construction. The Company's services operations primarily support the Company's site leasing business, including through the addition of new tenants and equipment on its sites. The Company's customers include its tenants, licensees and other payers. American Tower Corporation was incorporated in 1995 in Delaware, USA.", "ceo_bio": "Mr. Steven O. Vondran J.D. | President, CEO & Director | Age 54 | Compensation: $3.3M (FY2025)", "founder_led": false, "fcf": 3783600000.0, "fcf_margin": 0.35544783270390623, "sbc_pct_rev": 0.0163651053116134, "mcap": 84720787456, "roic_by_year": {"2025": 0.09028319525944666, "2024": 0.09126930550106688, "2023": 0.06824010664315822, "2022": 0.054642862496218296}, "roic_cv": 0.23423657979886642, "gross_margin": 0.7429968306036007, "er": 0.09232475000000001, "re_method": "capm", "beta_raw": 0.4964627320363457, "beta_adjusted": 0.6643084880242305, "beta_r2": 0.10624715740242532, "beta_se": 0.040694390359874884, "beta_n_obs": 1254, "beta_r2_class": "unreliable", "dcf_sens_range": [81.2027782791274, 178.07796903508935], "fcf_growth": 0.02576178390943165, "pfcf": 22.391581418754626, "pb": 23.191626, "num_analysts": 22, "target_mean": 215.45454, "target_high": 260.0, "target_low": 195.0, "cash_conv": 2.1601106938130066, "accruals": -0.04643901605307135, "rev_cagr": 0.03340295998443743, "rev_cagr_5y": 0.05769014050493415, "rev_cagr_10y": 0.1221756083100829, "int_cov": 3.6260114756510227, "nd_ebitda": 6.238753084294485, "de": 14.465462012320328, "cr": 0.3965691804796205, "roe": 0.692539356605065, "roa": 0.04002981465539069, "shares_out": 466370068, "float_shares": 464681905, "insider_pct": 0.00086000003, "inst_pct": 0.9622, "shares_short": 6981335, "short_ratio": 2.15, "short_pct_float": 0.0172, "share_turnover_rate": 0.0070123968590539995, "share_buyback_rate": 0.004303548290192134, "shareholder_yie