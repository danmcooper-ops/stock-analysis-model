function bkv(pairs){return pairs.map(function(p){
  var tipKey=DKV_TIPS[p[0]];var tipTxt=tipKey?tt(tipKey):'';
  var klAttr=tipTxt?' data-dkv-tip="'+tipKey+'"':'';
  return'<div class="dkv"><span class="kl"'+klAttr+'>'+p[0]+'</span><span class="kv"'+(p[2]?' style="'+p[2]+'"':'')+'>'+p[1]+'</span></div>';
}).join('');}
var TT={
ticker:'Behind every ticker is a real business. Only invest in what you understand well enough to own for a decade.',
rating:'Model conviction after DCF, gate screening, and composite scoring. A starting point \u2014 not a substitute for your own thesis.',
_composite_score:'Buffett-style weighted score: Moat 40%, Valuation 20%, Quality 20%, Ownership 15%, Growth 5%. Above 70 = broad fundamental strength; below 40 demands explanation before committing capital.',
_gates_passed:'Binary pass/fail count across 20 minimum-quality bars. Every failure demands an explanation \u2014 the composite score, not the raw count, drives the final rating.',
sector:'GICS sector classification. Benchmark only against businesses with genuinely similar economics \u2014 Buffett invests only inside his circle of competence.',
industry:'GICS industry sub-group \u2014 the relevant peer group for margin and ROIC benchmarks. Gross margins and ROIC mean different things across industries; always compare within industry.',
mcap:'Price \u00d7 Shares Outstanding \u2014 the market\u2019s current appraisal of the business. Graham\u2019s insight: compare this against intrinsic value. The gap between the two is where fortunes are made.',
roic:'Return on Invested Capital \u2014 the single most important metric in the Buffett framework. ROIC above WACC means the business creates value with every dollar reinvested; a 5-year median above 15% is the hallmark of a compounder.',
wacc:'The hurdle rate separating value creators from destroyers. ROIC consistently above WACC compounds shareholder wealth. Small changes move the DCF significantly \u2014 use a conservative rate that reflects genuine risk.',
spread:'ROIC minus WACC \u2014 the economic profit spread. Above 5% signals genuine pricing power or structural efficiency; near zero means the business barely earns its keep.',
roic_cv:'ROIC Coefficient of Variation: low CV means stable, reliable returns. Munger: \u201cInvest in businesses with consistent, predictable economics.\u201d High ROIC + low CV = a durable compounding machine.',
dcf_fv:'Present value of all future owner earnings. Buffett: \u201cThe value of any asset is simply its discounted future cash flows.\u201d Treat as a range, not a precise number \u2014 output quality depends on the assumptions feeding it.',
price:'Mr. Market\u2019s daily offer \u2014 you\u2019re never obligated to accept. Buffett: \u201cPrice is what you pay; value is what you get.\u201d Meaningless without an independent intrinsic value estimate.',
mos:'Graham\u2019s foundational principle: (Fair Value \u2212 Price) / Fair Value. Buffett: \u201cThe three most important words in investing are margin of safety.\u201d 20\u201330% is a reasonable minimum; 40%+ is compelling.',
target_mean:'Average analyst price target \u2014 Wall Street consensus. Buffett and Munger distrust sell-side targets; use as a sentiment barometer, not a substitute for independent valuation.',
pe:'Price / EPS \u2014 Graham\u2019s first-pass screen. A low P/E on a high-ROIC business with clean, cash-backed earnings is one of the most reliably attractive combinations in value investing.',
ev_ebitda:'Capital-structure-neutral valuation ratio. Only signals value with genuine earnings quality \u2014 don\u2019t use it to justify capital-heavy businesses at cyclical troughs.',
pfcf:'Price / Free Cash Flow \u2014 the multiple paid on actual owner earnings. Below 20\u00d7 is reasonable for a quality business; below 15\u00d7 is genuinely attractive.',
pb:'Price / Book \u2014 Graham\u2019s original asset safety anchor. High P/B is justified only by sustained high ROIC; otherwise it is a value-trap risk.',
epv_fv:'Earnings Power Value capitalises current earnings at WACC, assuming zero growth. Price < EPV means future growth is free \u2014 you\u2019re not paying for something uncertain.',
rim_fv:'Residual Income Model \u2014 book value plus the present value of future excess earnings. When RIM and DCF converge, confidence in the estimate increases.',
ddm_fv:'Dividend Discount Model \u2014 discounts expected future dividends. Buffett prizes growing dividends as proof of disciplined capital allocation. Blank = company did not meet eligibility criteria.',
implied_growth:'Growth rate the market is currently pricing in, reverse-engineered from the current stock price. If implied growth far exceeds what the business has ever delivered, the market is pricing for perfection.',
roe:'Return on Equity. Buffett looks for 15%+ ROE without excessive leverage. Verify with DuPont: ROE from margins and asset efficiency is durable; ROE from financial leverage is fragile.',
roa:'Return on Assets \u2014 cuts through leverage-inflated ROE. High ROA means the business generates the same profit with fewer assets \u2014 structural efficiency that compounds over time.',
cash_conv:'Operating Cash Flow / Net Income. Graham: \u201cEarnings are opinions; cash is fact.\u201d Persistently below 0.8 raises questions about accounting quality or working capital deterioration.',
gross_margin:'Buffett and Munger\u2019s first moat test. Buffett: \u201cThe single most important decision is pricing power.\u201d Above 40% signals a premium the business can charge that competitors cannot easily replicate.',
accruals:'Accruals Ratio: high-accrual firms systematically underperform (Sloan 1996). Negative accruals \u2014 cash exceeding income \u2014 are the strongest outcome; above 5% demands scrutiny of revenue recognition.',
rev_cagr:'Revenue CAGR over 3 years. Persistent top-line growth paired with stable margins demonstrates pricing power and demand durability.',
dupont_margin:'DuPont Net Profit Margin \u2014 first pillar of ROE decomposition. Buffett\u2019s best businesses retain a large share of every revenue dollar as profit, requiring pricing power, cost discipline, or both.',
dupont_turnover:'Asset Turnover = Revenue / Total Assets. Asset-light businesses (software, brands) that generate high revenue per deployed dollar are Buffett\u2019s preferred structure.',
dupont_leverage:'Equity Multiplier = Assets / Equity. Munger: \u201cLiquor, ladies, and leverage ruin people.\u201d Verify that margin and turnover stand independently before accepting high leverage.',
piotroski:'Piotroski F-Score (0\u20139) \u2014 nine binary tests across profitability, leverage, and efficiency. Scores 7\u20139 = improving on all dimensions; 0\u20133 = deteriorating. Graham-style quantified financial health analysis.',
int_cov:'EBIT / Interest Expense. Below 3\u00d7 means one bad year could create a liquidity crisis. Munger: \u201cAvoid leverage that forces selling good assets at the worst time.\u201d Above 10\u00d7 is a fortress balance sheet.',
nd_ebitda:'Years of operating earnings needed to retire all debt. Buffett: \u201cWe want businesses with no debt or very modest debt.\u201d Below 2\u00d7 is conservative; negative ND/EBITDA = net cash \u2014 the gold standard.',
de:'Debt / Equity \u2014 Graham\u2019s direct leverage check. Below 1.0 means owners fund more than creditors. Munger: leverage turns temporary undervaluation into permanent loss.',
cr:'Current Assets / Current Liabilities. Graham required a minimum 2.0 for defensive stocks. Below 1.0 = short-term liabilities exceed liquid assets, creating dependency on rolling credit.',
altman_z:'Bankruptcy-prediction model combining five ratios. Above 2.99 = safe; below 1.81 = distress. Graham was obsessed with avoiding permanent capital loss \u2014 the Z-Score identifies businesses approaching insolvency.',
beneish_m:'Earnings manipulation risk model. Above \u22121.78 = elevated risk. Buffett: \u201cIntegrity, intelligence, energy \u2014 if they lack the first, the other two will kill you.\u201d A high score demands direct scrutiny.',
analyst_ltg:'Analyst consensus long-term growth estimate. Munger distrusts sell-side forecasts \u2014 they\u2019re systematically optimistic. Compare against fundamental growth (ROIC \u00d7 Reinvestment Rate) as a reality check.',
fundamental_growth:'ROIC \u00d7 Reinvestment Rate \u2014 Buffett\u2019s internally consistent growth formula. A 20% ROIC business reinvesting half its earnings compounds intrinsic value at 10% per year with no external financing.',
reinvestment_rate:'Share of earnings reinvested back into the business. Buffett\u2019s ideal: grow substantially without retaining much. High reinvestment only creates value when ROIC is high.',
terminal_growth:'Perpetual growth rate beyond the 10-year DCF horizon, anchored near long-run GDP (2\u20133%). Small changes have outsized fair-value impact \u2014 Buffett avoids heroic terminal assumptions.',
margin_trend:'Year-over-year change in operating margin. Expanding margins signal a deepening moat. Contracting margins are the first warning the competitive advantage is under pressure.',
surprise_avg:'Average quarterly earnings surprise. Consistent beats signal conservative, honest guidance \u2014 a Buffett hallmark. A team that under-promises and over-delivers is trustworthy.',
fcf_growth:'FCF growth rate used in Stage 1 of the DCF. Buffett: FCF growth must be organic. Verify it\u2019s supported by revenue growth and stable margins, not deferred capex or working capital games.',
shareholder_yield:'Dividends + Net Buybacks / Market Cap. Gate passes when yield > 2%, filtering token distributions. Above 5% signals genuine, consistent commitment to returning cash to owners.',
analyst_rec:'Wall Street consensus recommendation. Buffett and Munger distrust sell-side research \u2014 use as a sentiment barometer only. The best opportunities are often where the consensus is wrong.',
num_analysts:'Number of analysts covering the stock. Low coverage (<5) may signal an underfollowed business where price discovery is incomplete \u2014 Buffett\u2019s favourite hunting ground.',
target_low:'Most pessimistic analyst price target. Graham: consider the bear case first. Stock near the low target may already price in the worst \u2014 compare against your own intrinsic value, not just consensus.',
target_high:'Most optimistic analyst price target. Wide spread between high and low targets signals genuine uncertainty \u2014 demand a wider margin of safety before committing capital.',
er:'Expected annual return from the DCF model. Buffett thinks in long-run compounding rates \u2014 above 12\u201315% on a quality business deserves serious attention. Compare against opportunity cost.',
_sens_low:'Bear-case fair value from DCF sensitivity. Graham: always ask what the business is worth under adverse conditions. Stock trading below this value has margin of safety even in pessimistic scenarios.',
_sens_high:'Bull-case fair value from DCF sensitivity. If price exceeds the bull case, the market prices for perfection. Munger: ask whether you believe these assumptions enough to stake permanent capital.',
mc_p10_fv:'Monte Carlo 10th-percentile fair value \u2014 90% of simulations produced a higher value. Stock trading below P10 is undervalued across nearly every simulated scenario \u2014 Graham\u2019s strongest entry signal.',
mc_p90_fv:'Monte Carlo 90th-percentile fair value \u2014 only 10% of simulations produced a higher value. Wide P10\u2013P90 band = irreducible uncertainty; demand proportionally more margin of safety.',
mc_confidence:'MC confidence based on coefficient of variation. HIGH (CV < 20%) = reliable. MEDIUM (20\u201340%) = moderate uncertainty. LOW (>40%) = treat the point estimate with significant caution.',
shares_out:'Total shares outstanding. Declining share count over time is one of Buffett\u2019s most valued management signals \u2014 repurchasing below intrinsic value is the best capital allocation when no better option exists.',
float_shares:'Shares available for public trading. Low float amplifies volatility and creates liquidity risk \u2014 important for position sizing in concentrated portfolios.',
insider_pct:'Percentage held by insiders. Munger: \u201cShow me the incentive and I\u2019ll show you the outcome.\u201d Above 10% means management loses personally if the stock falls \u2014 the strongest alignment signal.',
inst_pct:'Percentage held by institutions. Heavy ownership validates quality but creates concentration risk \u2014 sophisticated sellers can act simultaneously when sentiment shifts.',
shares_short:'Shares held short. Buffett ignores short interest; focus on fundamentals. Occasionally, prominent short sellers are the best fundamental analysts on a stock \u2014 read their thesis.',
short_ratio:'Days to Cover = Shares Short / Avg Daily Volume. Relevant to traders, not long-term value investors indifferent to short-squeeze dynamics.',
short_pct_float:'Short interest as a percentage of float. Above 10% reflects significant bearish positioning \u2014 take a prominent short thesis seriously before assuming the market is simply wrong.',
share_turnover_rate:'Avg Daily Volume / Shares Outstanding. Low turnover signals a patient, long-term shareholder base. Munger: \u201cThe big money is not in the buying and selling, but in the waiting.\u201d',
share_buyback_rate:'Net Buybacks / Market Cap. Buffett: \u201cRepurchases benefit shareholders when made below intrinsic value.\u201d Gate passes when > 0%; above 3% signals genuine management confidence.',
high_52w:'52-week high. Graham: anchoring to recent price levels mistakes momentum for value. Only an independent intrinsic value estimate tells you whether a stock near its high is cheap or expensive.',
low_52w:'52-week low. May signal temporary disfavour or genuine deterioration. Graham: \u201cPrice alone is never sufficient.\u201d A low price is only interesting if intrinsic value remains intact.',
pct_from_52w_high:'Distance below the 52-week high. A large gap (>40%) may indicate distress, sector rotation, or mispricing. Compelling only if the fundamental business remains intact.',
range_52w_position:'Position in the 52-week price range (0 = at the low, 100 = at the high). Useful as context; never as a signal. Value investors buy businesses, not price positions.',
price_fv:'Price / DCF Fair Value. Below 1.0 = market selling below intrinsic worth; below 0.8 = 20% margin of safety. Above 1.2 = paying a 20%+ premium \u2014 even wonderful businesses can be overpriced.',
epv_p_fv:'Market price / Earnings Power Value. Price < EPV means future growth is free \u2014 you pay nothing for something uncertain. Gate passes when < 1.2\u00d7.',
int_coverage:'EBIT / Interest Expense gate. Munger: \u201cAvoid leverage that forces selling good assets at the worst time.\u201d Gate passes when IC > 3\u00d7; above 10\u00d7 is a fortress balance sheet.',
shrhldr_yield:'Dividends + Net Buybacks / Market Cap. Gate passes when > 2%, filtering token distributions. Buffett: \u201cThe best thing a company can do when the stock is cheap is buy it back.\u201d',
fund_growth:'ROIC \u00d7 Reinvestment Rate gate. Buffett\u2019s growth formula: a 20% ROIC business reinvesting half its earnings compounds at 10%/yr from its own resources. Gate passes when > 3%.',
margins:'Operating margin trend gate. Expanding margins signal deepening pricing power. Gate passes when margin trend \u2265 0 \u2014 contraction is the first warning a moat is under pressure.',
surprise:'Earnings surprise consistency gate. Consistent beats signal conservative, honest guidance. Gate passes when average surprise > 0%.',
roic_consistency:'ROIC Consistency gate \u2014 CV of annual ROIC. Munger: \u201cThe most important thing is the durability of the competitive advantage.\u201d Gate passes when CV < 30% \u2014 stable returns prove the moat is real.',
'spread_>_5%':'ROIC\u2013WACC spread gate. Passes when spread > 5% \u2014 the business earns significantly more than its cost of capital year after year. Near zero means it barely earns its keep.',
gross_margin_gate:'Gross Margin gate \u2014 pricing power test. Buffett: \u201cThe single most important decision is pricing power.\u201d Gate passes when gross margin > 25% or in the sector top quartile.',
insider_own:'Insider Ownership gate. Passes when insiders hold \u2265 5% of shares. Buffett and Munger only invest with management teams who think like owners because they are owners.',
turnover:'Share Turnover gate \u2014 tests shareholder base stability. Passes when daily turnover < 2%. Buffett prefers businesses owned by patient, analytical partners who hold indefinitely.',
buyback_rate:'Buyback Rate gate \u2014 net repurchases / market cap. Gate passes when > 0%. Consistent buybacks reduce share count and increase per-share owner earnings.',
insider_buying:'Form 4 insider buying gate. Management buying their own stock with their own money is one of the strongest alignment signals available. Gate passes when buy ratio > 50%.',
edgar_quality_score:'EDGAR Data Quality Score \u2014 cross-validation between yfinance and SEC EDGAR XBRL. 100 = perfect match. Low scores demand direct 10-K verification before valuing.',
profit_pool:'Company profit share \u00f7 revenue share within sector. Above 1\u00d7 means disproportionate profit capture \u2014 Porter\u2019s competitive advantage in numerical form. Gate passes when \u2265 1\u00d7.',
net_debt_ebitda:'Net Debt / EBITDA gate. Buffett: \u201cWe want businesses with no debt or very modest debt.\u201d At \u2264 2\u00d7, net debt could be retired in under two years from operating earnings.',
rev_durability:'10-year revenue CAGR gate. Persistent growth through two recessions confirms the business isn\u2019t dependent on a single product cycle or macro tailwind. Gate passes when 10Y CAGR > 2%.',
sbc_dilution:'SBC / Revenue gate \u2014 silent dilution test. Buffett: SBC is a real cost, not a footnote. Gate passes when SBC/Rev \u2264 3%. Above 10% means shareholders are subsidising management compensation.',
price_book:'Price / Book gate. Graham began with book value as his hard asset floor. High P/B justified only by sustained high ROIC. Gate passes when P/B \u2264 5\u00d7 as a valuation discipline anchor.',
fcf_margin:'FCF / Revenue \u2014 Buffett\u2019s \u201cowner earnings\u201d as a margin. Gate passes when FCF margin > 10%. Above 15% typically signals pricing power, minimal capex needs, or both.',
p_fcf:'Price / Free Cash Flow gate. Below 25\u00d7 (>4% yield) is reasonable for a quality business. Scored from 50\u00d7 (perfection-priced) to 10\u00d7 (compelling yield). Negative FCF scores 0.',
rev_cagr_5y:'Revenue CAGR over 5 years. Use alongside the 10-year figure: high 5Y but low 10Y CAGR may simply reflect a recovery from a trough, not genuine durable growth.'
};
function tt(k){return TT[k]||'';}

/* === MULTI-SELECT HELPERS === */
function msToggle(id){
  var wrap=document.getElementById(id);
  var wasOpen=wrap.classList.contains('open');
  document.querySelectorAll('.ms-wrap.open').forEach(function(w){w.classList.remove('open');});
  if(!wasOpen){
    wrap.classList.add('open');
    var btn=wrap.querySelector('.ms-btn'),drop=wrap.querySelector('.ms-drop');
    if(btn&&drop){var r=btn.getBoundingClientRect();drop.style.top=(r.bottom+2)+'px';drop.style.left=r.left+'px';drop.style.minWidth=r.width+'px';drop.style.maxHeight=Math.min(400,window.innerHeight-r.bottom-14)+'px';}
  }
}
function msGetSelected(id){
  var boxes=document.querySelectorAll('#'+id+' .ms-drop input[type="checkbox"][value]');
  var sel=[];
  boxes.forEach(function(cb){if(cb.checked)sel.push(cb.value);});
  return sel;
}
function msChanged(id){
  var wrap=document.getElementById(id);
  var boxes=wrap.querySelectorAll('.ms-drop input[type="checkbox"][value]');
  var allBox=wrap.querySelector('.ms-all input');
  var total=boxes.length,checked=0;
  boxes.forEach(function(cb){if(cb.checked)checked++;});
  allBox.checked=checked===total;
  allBox.indeterminate=checked>0&&checked<total;
  msUpdateLabel(id);
  applyFilters();
}
function msToggleAll(id,state){
  var wrap=document.getElementById(id);
  wrap.querySelectorAll('.ms-drop input[type="checkbox"][value]').forEach(function(cb){cb.checked=state;});
  var allBox=wrap.querySelector('.ms-all input');
  allBox.indeterminate=false;
  msUpdateLabel(id);
  applyFilters();
}
function msUpdateLabel(id){
  var wrap=document.getElementById(id);
  var btn=wrap.querySelector('.ms-btn');
  var boxes=wrap.querySelectorAll('.ms-drop input[type="checkbox"][value]');
  var sel=[];
  boxes.forEach(function(cb){if(cb.checked)sel.push(cb.value);});
  var allLabel=id==='ms-rating'?'All Ratings':'All Sectors';
  if(sel.length===0)btn.textContent='None';
  else if(sel.length===boxes.length)btn.textContent=allLabel;
  else if(sel.length<=2)btn.textContent=sel.join(', ');
  else btn.textContent=sel.length+' selected';
}
document.addEventListener('click',function(e){
  if(!e.target.closest('.ms-wrap'))document.querySelectorAll('.ms-wrap.open').forEach(function(w){w.classList.remove('open');});
});

/* === FILTERS === */
function applyFilters(){
  var q=document.getElementById('f-search').value.toUpperCase();
  var ratings=msGetSelected('ms-rating');
  var sectors=msGetSelected('ms-sector');
  var allRatings=ratings.length===document.querySelectorAll('#ms-rating .ms-drop input[type="checkbox"][value]').length;
  var allSectors=sectors.length===document.querySelectorAll('#ms-sector .ms-drop input[type="checkbox"][value]').length;
  // Collect all active column-value filters
  var colFilters=[];
  document.querySelectorAll('.col-filter-row').forEach(function(row){
    var key=row.querySelector('.cfr-col').value;
    if(!key)return;
    var minR=row.querySelector('.cfr-min').value;
    var maxR=row.querySelector('.cfr-max').value;
    var cMin=minR!==''?parseFloat(minR):null;
    var cMax=maxR!==''?parseFloat(maxR):null;
    if(cMin===null&&cMax===null)return;
    colFilters.push({key:key,min:cMin,max:cMax,pct:(_CF_FMT[key]||'')==='pct'});
  });
  FD=DATA.filter(function(d){
    if(_flagOnly&&!isFlagged(d.ticker))return false;
    if(_founderOnly&&!d.founder_led)return false;
    if(_revFilter===1&&isReviewed(d.ticker))return false;
    if(_revFilter===2&&!isReviewed(d.ticker))return false;
    if(q&&(d.ticker||'').toUpperCase().indexOf(q)<0&&(d.description||'').toUpperCase().indexOf(q)<0)return false;
    if(!allRatings&&ratings.indexOf(d.rating)<0)return false;
    if(!allSectors&&sectors.indexOf(d.sector)<0)return false;
    for(var i=0;i<colFilters.length;i++){
      var cf=colFilters[i];
      var v=d[cf.key];
      if(v==null)return false;
      var cv=cf.pct?v*100:v;
      if(cf.min!==null&&cv<cf.min)return false;
      if(cf.max!==null&&cv>cf.max)return false;
    }
    return true;
  });
  document.getElementById('f-count').textContent=FD.length+' of '+DATA.length;
  // Update filter popup badge (col filters + flagged + founder)
  var activeCount=colFilters.length+(_flagOnly?1:0)+(_founderOnly?1:0)+(_revFilter?1:0);
  var badge=document.getElementById('fpop-badge');
  var btn=document.getElementById('fpop-btn');
  if(activeCount>0){badge.textContent=activeCount;badge.style.display='inline-flex';btn.classList.add('active');}
  else{badge.style.display='none';btn.classList.remove('active');}
  renderCur();
}
function clearColFilters(){
  document.getElementById('col-filters').innerHTML='';
  addColFilter();
  applyFilters();
}
function toggleMobFilters(){
  var fb=document.getElementById('filter-bar');
  var btn=document.getElementById('mob-filter-btn');
  var open=fb.classList.toggle('mob-expanded');
  if(btn)btn.classList.toggle('active',open);
}
function clearFilters(){
  document.getElementById('f-search').value='';
  msToggleAll('ms-rating',true);
  msToggleAll('ms-sector',true);
  document.getElementById('col-filters').innerHTML='';
  addColFilter();
  _flagOnly=false;document.getElementById('f-flagged').classList.remove('active');
  _founderOnly=false;document.getElementById('f-founder').classList.remove('active');
  _revFilter=0;var rEl=document.getElementById('f-reviewed');if(rEl){rEl.classList.remove('active');rEl.innerHTML=_CHK_SVG+' All';}
  _revd={};_saveRevd();_updateRevCount();
  applyFilters();
}
function toggleFilterPopup(e){
  if(e)e.stopPropagation();
  var panel=document.getElementById('fpop-panel');
  var wasOpen=panel.classList.contains('open');
  panel.classList.toggle('open');
  if(!wasOpen){
    var btn=document.getElementById('fpop-btn');
    if(btn){var r=btn.getBoundingClientRect();panel.style.top=(r.bottom+6)+'px';panel.style.left=r.left+'px';}
  }
}
document.addEventListener('click',function(e){
  var wrap=document.getElementById('fpop-wrap');
  if(wrap&&!wrap.contains(e.target)){
    var panel=document.getElementById('fpop-panel');
    if(panel)panel.classList.remove('open');
  }
});
var _cfRowId=0;
var _cfOptHtml='';
function addColFilter(){
  var id=++_cfRowId;
  var wrap=document.getElementById('col-filters');
  if(wrap.children.length>0){
    var lbl=document.createElement('div');
    lbl.className='col-filters-and-label';lbl.textContent='AND';
    wrap.appendChild(lbl);
  }
  var row=document.createElement('div');
  row.className='col-filter-row';row.id='cfr-'+id;
  row.innerHTML='<select class="f-col-sel cfr-col" onchange="onColRowChange(this)">'+_cfOptHtml+'</select>'
    +'<input type="number" class="f-num cfr-min" placeholder="Min" oninput="applyFilters()">'
    +'<span class="score-sep">\u2013</span>'
    +'<input type="number" class="f-num cfr-max" placeholder="Max" oninput="applyFilters()">'
    +'<span class="col-unit cfr-unit"></span>'
    +'<button class="cfr-remove" onclick="removeColFilter(this)" title="Remove">\u00d7</button>';
  wrap.appendChild(row);
}
function removeColFilter(btn){
  var row=btn.closest('.col-filter-row');
  // Remove preceding AND label if present
  var prev=row.previousElementSibling;
  if(prev&&prev.classList.contains('col-filters-and-label'))prev.remove();
  // Or following AND label if this was first
  else{var next=row.nextElementSibling;if(next&&next.classList.contains('col-filters-and-label'))next.remove();}
  row.remove();
  // If no rows left, add one empty row
  if(!document.querySelector('.col-filter-row'))addColFilter();
  applyFilters();
}
function onColRowChange(sel){
  var row=sel.closest('.col-filter-row');
  row.querySelector('.cfr-min').value='';
  row.querySelector('.cfr-max').value='';
  var fmt=_CF_FMT[sel.value]||'';
  row.querySelector('.cfr-unit').textContent=fmt==='pct'?'%':(fmt==='dollar'||fmt==='ds')?'$':'';
  applyFilters();
}

