function closeDetail(){document.getElementById('det-modal').classList.remove('open');document.body.style.overflow='';}
function _easeScroll(el,to,ms){var start=el.scrollTop,diff=to-start,t0=performance.now();(function step(now){var p=Math.min((now-t0)/ms,1),ease=p<0.5?4*p*p*p:(1-Math.pow(-2*p+2,3)/2);el.scrollTop=start+diff*ease;if(p<1)requestAnimationFrame(step);})(t0);}
function navDet(dir){var idx=_detIdx+dir;if(idx<0||idx>=_detNav.length)return;openDet(_detNav[idx]);var sc=document.querySelector('.detail-content');if(sc)_easeScroll(sc,0,320);}
/* Velocity-based glide scroll for press-and-hold arrow keys */
var _sv=0,_sdir=0,_sraf=null;
function _scrollLoop(el){
  if(_sdir!==0)_sv=Math.min(_sv+2.2,22);
  else _sv*=0.91;
  if(_sv<0.4){_sv=0;_sraf=null;return;}
  el.scrollTop+=_sv*_sdir;
  _sraf=requestAnimationFrame(function(){_scrollLoop(el);});
}
function _startGlide(el,dir){
  if(_sdir===dir)return;
  _sdir=dir;
  if(!_sraf)_sraf=requestAnimationFrame(function(){_scrollLoop(el);});
}
function _stopGlide(){_sdir=0;}
document.addEventListener('keydown',function(e){
  if(document.getElementById('det-modal').classList.contains('open')){
    if(e.key==='Escape')closeDetail();
    else if(e.key==='ArrowLeft'){e.preventDefault();navDet(-1);}
    else if(e.key==='ArrowRight'){e.preventDefault();navDet(1);}
    else if(e.key==='ArrowUp'){e.preventDefault();var m=document.querySelector('.detail-content');if(m)_startGlide(m,-1);}
    else if(e.key==='ArrowDown'){e.preventDefault();var m=document.querySelector('.detail-content');if(m)_startGlide(m,1);}
    else if(e.key==='Enter'){e.preventDefault();var tk=document.getElementById('d-tk').textContent;if(tk&&!isReviewed(tk)){toggleReviewed(tk);_syncRevDet();}navDet(1);}
  }
});
document.addEventListener('keyup',function(e){if(e.key==='ArrowUp'||e.key==='ArrowDown')_stopGlide();});

/* === VIEW CONTROLLER === */
function moveFilterBar(v){
  var fb=document.querySelector('.filter-bar');
  if(!fb)return;
  if(v==='pool'){
    fb.style.display='none';
    return;
  }
  fb.style.display='';
  if(v==='table'){
    var ts=document.getElementById('t-subs');
    if(ts&&ts.nextSibling!==fb)ts.parentNode.insertBefore(fb,ts.nextSibling);
  }else{
    var vm=document.getElementById('view-matrix');
    if(vm&&vm.firstChild!==fb)vm.insertBefore(fb,vm.firstChild);
  }
}
/* Set table container max-height so thead sticky works relative to the scroll box */
function _setTableH(){
  var map={matrix:'.matrix-wrap',table:'.table-wrap'};
  ['matrix','table'].forEach(function(v){
    var vw=document.getElementById('view-'+v);if(!vw)return;
    var wrap=vw.querySelector(map[v]);if(!wrap)return;
    var rect=wrap.getBoundingClientRect();
    if(rect.width===0&&rect.height===0)return; /* hidden view */
    var h=Math.max(240,window.innerHeight-rect.top-2);
    wrap.style.maxHeight=h+'px';
  });
}
window.addEventListener('resize',_setTableH);
function showView(v){
  curView=v;
  document.querySelectorAll('.nav-btn').forEach(function(b){b.classList.remove('active')});
  document.querySelectorAll('.nav-btn').forEach(function(b){if(b.dataset.view===v)b.classList.add('active');});
  document.querySelectorAll('.view').forEach(function(el){el.classList.remove('active')});
  document.getElementById('view-'+v).classList.add('active');
  moveFilterBar(v);
  renderCur();
  setTimeout(_setTableH,0);
}
function renderCur(){
  if(curView==='matrix')renderMatrix();
  else if(curView==='table'){renderTSubs();renderTable();}
  else if(curView==='pool')renderPool();
}

