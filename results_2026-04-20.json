gs, hydraulics, and pneumatics components; abrasives, adhesives, sealants, and tape; pumps and power transmission; tools and testing equipment; electrical supplies and safety products; and chemicals and janitorial supplies. Additionally, it offers inventory management; vendor-managed inventory; asset repair and tracking, including radio frequency identification; and specialized repair services for gearboxes, fluid power systems, pumps, drive shafts, electrical panels, and hoses and gaskets. The company was incorporated in 1928 and is headquartered in Atlanta, Georgia.", "ceo_bio": "Mr. William P. Stengel II | Chair- Elect, CEO & Director | Age 47 | Compensation: $2.7M (FY2025)", "founder_led": false, "fcf": 420924000.0, "fcf_margin": 0.01732187479899808, "sbc_pct_rev": 0.002010152945203075, "mcap": 15663758336, "roic_by_year": {"2025": 0.14649096268195877, "2024": 0.11553623094669084, "2023": 0.16127622368947803, "2022": 0.1662595997969288}, "roic_cv": 0.15493069356876335, "gross_margin": 0.36098196976739894, "er": 0.0838599, "re_method": "capm", "beta_raw": 0.7183121272127222, "beta_adjusted": 0.8122080848084814, "beta_r2": 0.21151439077646056, "beta_se": 0.0391956579936592, "beta_n_obs": 1254, "beta_r2_class": "unreliable", "dcf_sens_range": [43.67147223884539, 97.96733324189381], "fcf_growth": 0.025475, "pfcf": 37.21279455673708, "pb": 3.5031114, "num_analysts": 7, "target_mean": 135.2857, "target_high": 145.0, "target_low": 125.0, "cash_conv": 13.507650314656154, "accruals": -0.039663168160095866, "rev_cagr": 0.03220324726356383, "rev_cagr_5y": 0.08001090137708289, "rev_cagr_10y": 0.047486462338040214, "int_cov": 7.428546964637383, "nd_ebitda": 3.456538298048367, "de": 3.6977640243898304, "cr": 1.0793882733490638, "roe": 0.014909593982895285, "roa": 0.0031711126520398126, "shares_out": 139122108, "float_shares": 137271172, "insider_pct": 0.00413, "inst_pct": 0.90363, "shares_short": 6371799, "short_ratio": 2.89, "short_pct_float": 0.0525, "share_turnover_rate": 