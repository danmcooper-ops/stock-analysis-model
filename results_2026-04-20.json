};
var TL={ovr:'Overview',val:'Valuation',prof:'Profitability',hlth:'Financial Health',growth:'Growth',con:'Consensus',proj:'Projections',own:'Ownership'};
var tSC=null,tSA=true;

function ftc(v,f){
  if(v==null)return{t:'N/A',v:''};
  if(f==='text')return{t:String(v),v:String(v)};
  if(f==='rating')return{t:rb(v),v:v};
  if(f==='pct')return{t:(v*100).toFixed(1)+'%',v:v};
  if(f==='dollar')return{t:'$'+v.toLocaleString(undefined,{maximumFractionDigits:2}),v:v};
  if(f==='ds')return{t:fds(v),v:v};
  if(f==='n1')return{t:v.toFixed(1),v:v};
  if(f==='n2')return{t:v.toFixed(2),v:v};
  if(f==='n3')return{t:v.toFixed(3),v:v};
  if(f==='int')return{t:Math.round(v)+'',v:v};
  if(f==='ar'){var m={strong_buy:'Strong Buy',buy:'Buy',hold:'Hold',sell:'Sell',strong_sell:'Strong Sell'};return{t:m[v]||String(v),v:v};}
  return{t:String(v),v:v};
}
