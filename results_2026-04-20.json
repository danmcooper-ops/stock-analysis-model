/* === FLAGS (localStorage) === */
var _FLAG_KEY='stock_flags_v1';
var _flags=(function(){try{return JSON.parse(localStorage.getItem(_FLAG_KEY))||{};}catch(e){return{};}})();
var _flagOnly=false;
function _saveFlags(){try{localStorage.setItem(_FLAG_KEY,JSON.stringify(_flags));}catch(e){}}
function isFlagged(tk){return !!_flags[tk];}
function toggleFlag(tk,e){if(e)e.stopPropagation();_flags[tk]?delete _flags[tk]:_flags[tk]=1;_saveFlags();_updateFlagCount();applyFilters();}
function _syncFlagDet(){var tk=document.getElementById('d-tk').textContent;if(!tk)return;var f=isFlagged(tk);var cls='flag-star'+(f?' flagged':'');var txt=f?'\u2691':'\u2690';['d-flag','d-flag2'].forEach(function(id){var el=document.getElementById(id);if(el){el.textContent=txt;el.className=cls;}});}
function toggleFlagDet(){var tk=document.getElementById('d-tk').textContent;if(!tk)return;toggleFlag(tk);_syncFlagDet();}
function toggleFlagFilter(){_flagOnly=!_flagOnly;document.getElementById('f-flagged').classList.toggle('active',_flagOnly);applyFilters();}
var _founderOnly=false;
function toggleFounderFilter(){_founderOnly=!_founderOnly;document.getElementById('f-founder').classList.toggle('active',_founderOnly);applyFilters();}
function _updateFlagCount(){var n=Object.keys(_flags).length;var el=document.getElementById('flag-count-label');el.textContent=n>0?' ('+n+')':'';}
function _starHtml(tk){return '<span class="flag-star'+(isFlagged(tk)?' flagged':'')+'" onclick="toggleFlag(\''+tk.replace(/'/g,"\\'")+'\',event)" title="Flag">'+(isFlagged(tk)?'\u2691':'\u2690')+'</span>';}
_updateFlagCount();

/* === REVIEWED (localStorage) === */
var _CHK_SVG='<svg viewBox="0 0 22 22" style="width:1.4em;height:1.4em;vertical-align:middle;display:inline-block"><circle cx="11" cy="11" r="9" fill="var(--chk-bg,none)" stroke="var(--chk-border,currentColor)" stroke-width="1.5"/><polyline points="6,11 9.5,15 16,7" fill="none" stroke="var(--chk-mark,currentColor)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var _REV_KEY='stock_reviewed_v1';
var _revd=(function(){try{return JSON.parse(localStorage.getItem(_REV_KEY))||{};}catch(e){return{};}})();
var _revFilter=0; /* 0=off,1=unreviewed,2=reviewed */
function _saveRevd(){try{localStorage.setItem(_REV_KEY,JSON.stringify(_revd));}catch(e){}}
function isReviewed(tk){return !!_revd[tk];}
function toggleReviewed(tk,e){if(e)e.stopPropagation();_revd[tk]?delete _revd[tk]:_revd[tk]=1;_saveRevd();_updateRevCount();applyFilters();}
function _syncRevDet(){var tk=document.getElementById('d-tk').textContent;if(!tk)return;var c=isReviewed(tk)?'rev-chk-det checked':'rev-chk-det';['d-rev','d-rev2'].forEach(function(id){var el=document.getElementById(id);if(el){el.className=c;el.innerHTML=_CHK_SVG;el.title=isReviewed(tk)?'Reviewed — click to unmark':'Mark as reviewed';}});}
function toggleReviewedDet(){var tk=document.getElementById('d-tk').textContent;if(!tk)return;toggleReviewed(tk);_syncRevDet();}
function cycleRevFilter(){_revFilter=(_revFilter+1)%3;var el=document.getElementById('f-reviewed');el.classList.toggle('active',_revFilter>0);el.innerHTML=_CHK_SVG+' '+(['All','Unreviewed','Reviewed'])[_revFilter];applyFilters();}
function _updateRevCount(){var n=Object.keys(_revd).length;var el=document.getElementById('rev-count-label');if(el)el.textContent=n>0?' ('+n+')':'';}
function clearAllReviewed(){if(!Object.keys(_revd).length)return;if(!confirm('Clear all '+Object.keys(_revd).length+' reviewed checkmarks?'))return;_revd={};_saveRevd();_updateRevCount();_syncRevDet();applyFilters();}
function _revHtml(tk){var c=isReviewed(tk);return '<span class="rev-chk'+(c?' checked':'')+'" onclick="toggleReviewed(\''+tk.replace(/'/g,"\\'")+'\',event)" title="'+(c?'Reviewed — click to unmark':'Mark as reviewed')+'">'+_CHK_SVG+'</span>';}
_updateRevCount();

/* === HELPERS === */
function esc(s){var e=document.createElement('span');e.textContent=s;return e.innerHTML;}
function fp(v,d){return v!=null?(v*100).toFixed(d!=null?d:1)+'%':'N/A';}
function fn(v,d){return v!=null?v.toFixed(d!=null?d:2):'N/A';}
function fn0(v){return v!=null?Math.round(v).toLocaleString():'N/A';}
function fd(v){return v!=null?'$'+Math.round(v).toLocaleString():'N/A';}
function fds(v){if(v==null)return'N/A';var s=v<0?'-':'',a=Math.abs(v);if(a>=1e12)return s+'$'+(a/1e12).toFixed(1)+'T';if(a>=1e9)return s+'$'+(a/1e9).toFixed(1)+'B';if(a>=1e6)return s+'$'+(a/1e6).toFixed(1)+'M';return s+'$'+Math.round(a).toLocaleString();}
function fg(v,f){if(v==null)return'N/A';if(f==='pct1')return(v*100).toFixed(1)+'%';if(f==='ratio')return v.toFixed(2);if(f==='int')return Math.round(v)+'';return String(v);}
function sc(v){if(v==null)return'';return v>=60?'sg':v>=30?'sm':'sp';}
function gc(g){return g===true?'gp':g===false?'gf':'gn';}
function rb(r){return'<span class="rb" style="background:'+(RC[r]||'#888')+'">'+(r||'N/A')+'</span>';}
function cc(v){if(v==null)return'#888';return v>=65?'#1a9850':v>=40?'#fd8d3c':'#de2d26';}
