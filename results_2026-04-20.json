ators; construction consumables, tools, small equipment, and safety supplies; and parts for equipment that is owned by its customers, as well as provides repair and maintenance services. It sells used equipment through its sales force, brokers, website, at auctions, and directly to manufacturers. United Rentals, Inc. was incorporated in 1997 and is headquartered in Stamford, Connecticut.", "ceo_bio": "Mr. Matthew J. Flannery | President, CEO & Director | Age 60 | Compensation: $3.0M (FY2025)", "founder_led": false, "fcf": 662000000.0, "fcf_margin": 0.04112056649481334, "sbc_pct_rev": 0.008323498353935027, "mcap": 51171508224, "roic_by_year": {"2025": 0.12280036122636465, "2024": 0.13469652718506156, "2023": 0.14245233878433725, "2022": 0.12659873384146553}, "roic_cv": 0.0664873264258595, "gross_margin": 0.4031889415342189, "er": 0.11002261449861603, "re_method": "capm (directional)", "beta_raw": 1.3905071721497724, "beta_adjusted": 1.260338114766515, "beta_r2": 0.40054172216730755, "beta_se": 0.048075816547913416, "beta_n_obs": 1254, "beta_r2_class": "directional", "dcf_sens_range": [772.009271326823, 1442.8426279833582], "fcf_growth": 0.056592162513426296, "pfcf": 77.29835079154078, "pb": 5.714859, "num_analysts": 20, "target_mean": 977.5435, "target_high": 1550.0, "target_low": 600.0, "cash_conv": 2.0809943865276663, "accruals": -0.09026987209535928, "rev_cagr": 0.11409895911958845, "rev_cagr_5y": 0.13545512227945156, "rev_cagr_10y": 0.10715897175011468, "int_cov": 5.550279329608938, "nd_ebitda": 2.147839593335216, "de": 2.33028545941124, "cr": 0.9447499345378372, "roe": 0.278099910793934, "roa": 0.08350632826625594, "shares_out": 62886315, "float_shares": 62625828, "insider_pct": 0.00621, "inst_pct": 0.93343, "shares_short": 1893253, "short_ratio": 2.97, "short_pct_float": 0.0344, "share_turnover_rate": 0.010521080778862619, "share_buyback_rate": 0.0384784437343693, "shareholder_yield": 0.047545989642316155, "div_yield": 0.009701207726494885, "payout_ratio": 0.18